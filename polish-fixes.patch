@@ -0,0 +1,90 @@
+"""Source wiring and native arithmetic tests for NVN timing accounting."""
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[3]
+MTL = ROOT / "dm/gfx/nvn/nvn_mtl.m"
+HLE = ROOT / "dm/gfx/nvn/hle_nvn.c"
+NATIVE = ROOT / "dm/gfx/tests/run_nvn_timing_native.py"
+
+
+def function_body(source: str, signature: str) -> str:
+    start = source.index(signature)
+    brace = source.index("{", start)
+    depth = 0
+    state = None
+    escaped = False
+    i = brace
+    while i < len(source):
+        ch = source[i]
+        nxt = source[i + 1] if i + 1 < len(source) else ""
+        if state == "line":
+            if ch == "\n":
+                state = None
+        elif state == "block":
+            if ch == "*" and nxt == "/":
+                state = None
+                i += 1
+        elif state:
+            if escaped:
+                escaped = False
+            elif ch == "\\":
+                escaped = True
+            elif ch == state:
+                state = None
+        elif ch == "/" and nxt == "/":
+            state = "line"
+            i += 1
+        elif ch == "/" and nxt == "*":
+            state = "block"
+            i += 1
+        elif ch in ('"', "'"):
+            state = ch
+        elif ch == "{":
+            depth += 1
+        elif ch == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start:i + 1]
+        i += 1
+    raise AssertionError(f"unclosed function body: {signature}")
+
+
+class NVNTimingTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.mtl = MTL.read_text(encoding="utf-8")
+        cls.hle = HLE.read_text(encoding="utf-8")
+
+    def test_both_predictor_call_sites_use_one_accounting_wrapper(self):
+        body = function_body(self.mtl, "pso_get_(NvProg *pr, MTLRenderPassDescriptor *unused) {")
+        self.assertEqual(body.count("pso_predict_accounted()"), 2)
+        self.assertNotIn("pso_predict_rest()", body)
+        wrapper = function_body(self.mtl, "static void pso_predict_accounted(void) {")
+        self.assertIn("nvn_timing_account_prediction(&g_bp_lib_ns, &g_bp_pso_ns, &g_bp_pred_lib_ns", wrapper)
+        self.assertIn("&g_bp_timing_valid", wrapper)
+        callback = function_body(self.mtl, "static void pso_accounted_predict(void *context)")
+        self.assertIn("pso_predict_rest()", callback)
+
+    def test_snapshot_exports_nested_counter_and_validity(self):
+        snapshot = function_body(self.mtl, "int mtl_create_ns(uint64_t *lib_ns, uint64_t *pso_ns, uint64_t *predict_lib_ns)")
+        self.assertIn("*predict_lib_ns = g_bp_pred_lib_ns", snapshot)
+        self.assertIn("return g_bp_timing_valid", snapshot)
+
+    def test_longframe_and_tsv_use_one_validated_delta(self):
+        self.assertIn("nvn_timing_frame_delta(&previous, &current, counters_valid, &compile_time)", self.hle)
+        for metric in ("@lib_ms", "@pso_inclusive_ms", "@predict_lib_ms", "@make_ms"):
+            self.assertIn(f'trow(f, "{metric}"', self.hle)
+        self.assertIn("r->make_ms = compile_time.make_valid ?", self.hle)
+        self.assertIn("aggregate compile time is unknown", self.hle)
+        self.assertNotIn("((lns - plns) + (pns - ppns))", self.hle)
+
+    def test_native_pure_c_fixture(self):
+        subprocess.run([sys.executable, str(NATIVE)], cwd=ROOT, check=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
