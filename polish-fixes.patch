+#!/usr/bin/env python3
+"""Exercise shell identity parsing and file hashing with Foundation and synthetic files."""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def main():
+    if sys.platform != "darwin":
+        print("SKIP: native Foundation identity test requires macOS/Xcode")
+        return 77
+    harness = r'''
+#import <Foundation/Foundation.h>
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "dm_shell_identity.h"
+
+static void write_text(NSString *path, NSString *text) {
+    NSError *error = nil;
+    BOOL ok = [text writeToFile:path atomically:YES encoding:NSUTF8StringEncoding error:&error];
+    assert(ok && error == nil);
+}
+
+int main(void) { @autoreleasepool {
+    NSString *root = [NSTemporaryDirectory() stringByAppendingPathComponent:NSUUID.UUID.UUIDString];
+    NSString *dir = [root stringByAppendingPathComponent:@"dm"];
+    assert([[NSFileManager defaultManager] createDirectoryAtPath:dir withIntermediateDirectories:YES attributes:nil error:nil]);
+    NSString *metadata = [dir stringByAppendingPathComponent:@"shell_info.txt"];
+    NSString *valid = @"KIND=ios\nSOURCE_SHA=ABCDEF0123456789abcdef0123456789ABCDEF01\nMEM=1\n";
+    write_text(metadata, valid);
+    assert([dm_shell_identity_source_sha(metadata) isEqualToString:@"abcdef0123456789abcdef0123456789abcdef01"]);
+    write_text(metadata, [valid stringByReplacingOccurrencesOfString:@"\n" withString:@"\r\n"]);
+    assert([dm_shell_identity_source_sha(metadata) isEqualToString:@"abcdef0123456789abcdef0123456789abcdef01"]);
+
+    write_text(metadata, @"SOURCE_SHA=0123456789abcdef0123456789abcdef0123456\n");
+    assert(dm_shell_identity_source_sha(metadata) == nil);
+    write_text(metadata, @"SOURCE_SHA=0123456789abcdef0123456789abcdef0123456g\n");
+    assert(dm_shell_identity_source_sha(metadata) == nil);
+    write_text(metadata, @"SOURCE_SHA=0123456789abcdef0123456789abcdef01234567\nSOURCE_SHA=0123456789abcdef0123456789abcdef01234567\n");
+    assert(dm_shell_identity_source_sha(metadata) == nil);
+    write_text(metadata, @"KIND=ios\nMEM=1\n");
+    assert(dm_shell_identity_source_sha(metadata) == nil);
+    assert(dm_shell_identity_source_sha([dir stringByAppendingPathComponent:@"missing.txt"]) == nil);
+
+    NSString *payload = [root stringByAppendingPathComponent:@"synthetic-host.bin"];
+    NSData *abc = [@"abc" dataUsingEncoding:NSUTF8StringEncoding];
+    assert([abc writeToFile:payload atomically:YES]);
+    assert([dm_shell_identity_sha256_file([NSURL fileURLWithPath:payload]) isEqualToString:@"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"]);
+    NSMutableData *large = [NSMutableData dataWithLength:200000];
+    memset(large.mutableBytes, 'a', large.length);
+    assert([large writeToFile:payload atomically:YES]);
+    assert([dm_shell_identity_sha256_file([NSURL fileURLWithPath:payload]) isEqualToString:@"2287d207f24a941ff3b56c04c8a25ad56b63e3023207b3bb5b4ac0c9869d74be"]);
+    assert([[NSData data] writeToFile:payload atomically:YES]);
+    assert([dm_shell_identity_sha256_file([NSURL fileURLWithPath:payload]) isEqualToString:@"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"]);
+    assert(dm_shell_identity_sha256_file([NSURL fileURLWithPath:[root stringByAppendingPathComponent:@"missing.bin"]]) == nil);
+    assert(dm_shell_identity_sha256_file(nil) == nil);
+
+    [[NSFileManager defaultManager] removeItemAtPath:root error:nil];
+    puts("PASS: strict shell source stamp parsing and incremental SHA-256 synthetic-file cases");
+} return 0; }
+'''
+    with tempfile.TemporaryDirectory(prefix="shell-identity-native-") as td:
+        source, executable = Path(td) / "test.m", Path(td) / "test"
+        source.write_text(harness, encoding="utf-8", newline="\n")
+        subprocess.run(["xcrun", "clang", "-fobjc-arc", "-Wall", "-Wextra", "-Werror", "-Wno-error=deprecated-declarations",
+                        "-mmacosx-version-min=15.0", "-I", str(ROOT / "dm/ios/Sources"),
+                        "-framework", "Foundation", str(source), "-o", str(executable)], check=True)
+        subprocess.run([str(executable)], check=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
