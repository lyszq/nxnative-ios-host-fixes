+"""CPU-only census key tests and guards on the optional Metal integration."""
+from pathlib import Path
+import os
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+class RTSurveyTests(unittest.TestCase):
+    def test_actual_c_keys_and_saturation(self):
+        if os.environ.get("CC"):
+            compiler = shlex.split(os.environ["CC"])
+        elif shutil.which("clang"):
+            compiler = [shutil.which("clang")]
+        elif shutil.which("zig"):
+            compiler = [shutil.which("zig"), "cc"]
+        elif shutil.which("cc"):
+            compiler = [shutil.which("cc")]
+        else:
+            self.skipTest("a C compiler is required")
+        with tempfile.TemporaryDirectory(prefix="nvn-rt-survey-") as td:
+            exe = Path(td) / ("survey.exe" if sys.platform == "win32" else "survey")
+            subprocess.run(compiler + ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O2",
+                                      str(ROOT / "dm/gfx/tests/t_rt_survey.c"), "-o", str(exe)], check=True, timeout=120)
+            subprocess.run([str(exe)], check=True, timeout=15)
+
+    def test_disabled_path_precedes_attachment_queries(self):
+        text = (ROOT / "dm/gfx/nvn/nvn_mtl.m").read_text(encoding="utf-8")
+        begin = text.index("static void rt_survey_note(")
+        end = text.index("// ---------- DM_NVN_PASSGPU", begin)
+        body = text[begin:end]
+        self.assertLess(body.index("if (!rt_survey_on() || full) return"), body.index("pass_dims(pd"))
+        self.assertIn('enabled = e && !strcmp(e, "1")', text)
+        self.assertIn("rt_survey_note(pd, (NSUInteger)R.rt.n)", text)
+        for forbidden in ("newTexture", "newBuffer", "waitUntil", "getBytes:", "setTexture:", "a.texture =", "R.rt ="):
+            self.assertNotIn(forbidden, body)
+        self.assertIn("mip_extent(t.width, a.level)", body)
+        self.assertIn("g_stat_pass + 1", body)
+        self.assertNotIn("%p", body)
+
+
+if __name__ == "__main__":
+    unittest.main()
