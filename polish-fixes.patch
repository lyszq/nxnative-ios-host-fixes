--- /dev/null
+++ b/dm/gfx/nvn/nvn_rt_survey.h
@@ -0,0 +1,23 @@
+// Bounded, allocation-free keys for the optional render-target census.
+#ifndef NVN_RT_SURVEY_H
+#define NVN_RT_SURVEY_H
+#include <stdint.h>
+#include <string.h>
+
+enum { NVN_RT_SURVEY_LIMIT = 128 };
+typedef struct {
+    uint32_t role, slot, nvn_w, nvn_h, nvn_format, nvn_target, nvn_level, nvn_view_format;
+    uint32_t mtl_w, mtl_h, mtl_format, mtl_type, level, samples, layers, effective_w, effective_h, pass_w, pass_h;
+} nvn_rt_survey_key;
+_Static_assert(sizeof(nvn_rt_survey_key) == 19 * sizeof(uint32_t), "survey keys have no padding");
+typedef struct { nvn_rt_survey_key keys[NVN_RT_SURVEY_LIMIT]; unsigned count; } nvn_rt_survey;
+
+// 1: new configuration; 0: already seen; -1: full. The caller logs only new keys.
+static inline int nvn_rt_survey_add(nvn_rt_survey *survey, const nvn_rt_survey_key *key) {
+    for (unsigned i = 0; i < survey->count; i++)
+        if (!memcmp(&survey->keys[i], key, sizeof *key)) return 0;
+    if (survey->count >= NVN_RT_SURVEY_LIMIT) return -1;
+    survey->keys[survey->count++] = *key;
+    return 1;
+}
+#endif
