+#!/usr/bin/env python3
+"""Compile the Foundation-only NVN pair-batch tests on macOS without a Metal device."""
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[3]
+SOURCE = Path(__file__).resolve().with_name("t_nvn_pair_batch.m")
+
+
+def main():
+    if sys.platform != "darwin":
+        print("SKIP: native Foundation pair-batch test requires macOS/Xcode")
+        return 77
+    xcrun = shutil.which("xcrun")
+    if not xcrun:
+        print("SKIP: xcrun is required for the native Foundation pair-batch test")
+        return 77
+    with tempfile.TemporaryDirectory(prefix="nvn-pair-batch-") as temp:
+        executable = Path(temp) / "nvn_pair_batch_test"
+        subprocess.run([xcrun, "clang", "-fobjc-arc", "-fblocks", "-Wall", "-Wextra", "-Werror",
+                        "-framework", "Foundation", str(SOURCE), "-o", str(executable)], cwd=ROOT, check=True)
+        subprocess.run([str(executable)], cwd=ROOT, check=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
