+
+def function_body(source: str, signature: str) -> str:
+    start = source.index(signature)
+    brace = source.index("{", start)
+    depth = 0
+    quote = None
+    escaped = False
+    i = brace
+    while i < len(source):
+        ch = source[i]
+        if quote:
+            if escaped:
+                escaped = False
+            elif ch == "\\":
+                escaped = True
+            elif ch == quote:
+                quote = None
+        elif ch in ('"', "'"):
+            quote = ch
+        elif ch == "{":
+            depth += 1
+        elif ch == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start:i + 1]
+        i += 1
+    raise AssertionError(f"unclosed function body: {signature}")
+
+
+class NVNTextLineTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.source = SOURCE.read_text(encoding="utf-8")
+        cls.helper = function_body(cls.source, "static NSString *nvn_line_without_cr(NSString *line)")
+
+    def test_normalizer_removes_only_one_final_cr(self):
+        self.assertIn('[line hasSuffix:@"\\r"]', self.helper)
+        self.assertIn("[line substringToIndex:line.length - 1]", self.helper)
+        self.assertNotRegex(self.helper, r"[Tt]rim|whitespace|newlineCharacterSet")
+
+    def test_pair_parser_normalizes_before_dedup_and_field_split(self):
+        body = function_body(self.source, "static NSArray<NSArray<NSString *> *> *pre_parse(NSString *txt)")
+        normalize = body.index("NSString *l = nvn_line_without_cr(raw)")
+        self.assertLess(normalize, body.index("[seen containsObject:l]"))
+        self.assertLess(normalize, body.index('[l componentsSeparatedByString:@"\\t"]'))
+
+    def test_warm_parser_normalizes_rows_before_dedup_and_dispatch(self):
+        body = function_body(self.source, "static NSArray<WarmTask *> *warm_parse(NSArray<NSString *> *paths, long *lines)")
+        self.assertGreaterEqual(body.count("nvn_line_without_cr(raw)"), 2)  # count and task passes
+        normalize = body.index("NSString *line = nvn_line_without_cr(raw)")
+        self.assertLess(normalize, body.index("[seen containsObject:line]"))
+        self.assertLess(normalize, body.index('[line componentsSeparatedByString:@"\\t"]'))
+        for kind in ('[c[0] isEqualToString:@"S"]', '[c[0] isEqualToString:@"C"]', '[c[0] isEqualToString:@"R"]'):
+            self.assertIn(kind, body)
+
+    def test_pso_user_dedup_normalizes_existing_rows_without_rewriting_them(self):
+        rows = function_body(self.source, "static void pso_user_add_existing_lines(NSMutableSet<NSString *> *lines, NSString *txt)")
+        record = function_body(self.source, "static void pso_user_record(const char *fmt, ...)")
+        self.assertIn("NSString *line = nvn_line_without_cr(raw)", rows)
+        self.assertIn("pso_user_add_existing_lines(g_pso_user_seen, txt)", record)
+        self.assertNotIn("unionSet:", record)
+        self.assertIn("fputs(line, f)", record)  # newly observed bytes retain their existing format
+
+    @unittest.skipUnless(sys.platform == "darwin", "native Foundation parser harness requires macOS/Xcode")
+    def test_native_foundation_fixture(self):
+        subprocess.run([sys.executable, str(NATIVE)], cwd=ROOT, check=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
