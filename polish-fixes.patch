@@ -0,0 +1,49 @@
+"""Guard path-free shell identity diagnostics and the F1 shader cache key."""
+from hashlib import sha256
+from pathlib import Path
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[3]
+F1_MARKER_SHA256 = "b038d5e788d3e50207eb4b1e3ff72aa2b278d00e5923afc46254a5533b79ab9f"
+
+
+class ShellIdentityPolicyTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.main = (ROOT / "dm/ios/Sources/main.m").read_text(encoding="utf-8")
+        cls.prep = (ROOT / "dm/ios/Sources/dm_shader_prep.m").read_text(encoding="utf-8")
+        cls.identity = (ROOT / "dm/ios/Sources/dm_shell_identity.h").read_text(encoding="utf-8")
+        cls.msl = (ROOT / "dm/gfx/nvn/dm_shell_msl.h").read_text(encoding="utf-8")
+
+    def test_memory_log_reports_available_headroom_without_entitlement_claim(self):
+        self.assertIn("os_proc_available_memory()", self.main)
+        self.assertIn("current headroom; entitlement not queried", self.main)
+        self.assertNotIn("memory limit", self.main)
+        self.assertNotIn("5ull << 30", self.main)
+
+    def test_shell_identity_logs_only_validated_sha_or_safe_fallback(self):
+        self.assertIn('@"dm/shell_info.txt"', self.main)
+        self.assertIn("dm_shell_identity_source_sha(shellInfo)", self.main)
+        self.assertIn("NSBundle.mainBundle.executableURL", self.main)
+        self.assertIn('"unknown (missing or invalid)"', self.main)
+        self.assertIn('"unavailable"', self.main)
+        self.assertIn("value.length != 40", self.identity)
+        self.assertIn("0123456789abcdefABCDEF", self.identity)
+        self.assertIn("CC_SHA256_Update", self.identity)
+        self.assertNotIn("fileSystemRepresentation", self.identity)
+
+    def test_prep_emits_one_path_free_status_line_and_keeps_f1_marker_identity(self):
+        start = self.prep.index("static NSString *marker(")
+        end = self.prep.index("int dm_shader_prep_begin(", start)
+        marker = self.prep[start:end].encode("utf-8")
+        self.assertEqual(sha256(marker).hexdigest(), F1_MARKER_SHA256)
+        self.assertIn('#define DM_SHELL_NVN_MSL_EPOCH @"nvn-inv1"', self.msl)
+        self.assertEqual(self.prep.count("shader prep status:"), 2)  # empty-source and marker hit/miss branches
+        self.assertIn("sources=%lu marker=%@ action=%@", self.prep)
+        self.assertIn("DM_SHELL_NVN_MSL_EPOCH", self.prep)
+        self.assertNotIn("mk.UTF8String", self.prep)
+
+
+if __name__ == "__main__":
+    unittest.main()
