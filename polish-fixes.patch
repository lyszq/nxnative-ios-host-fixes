--- /dev/null
+++ b/dm/ios/Sources/dm_shell_identity.h
@@ -0,0 +1,64 @@
+// Small, path-free identity diagnostics for shell builds.
+#ifndef DM_SHELL_IDENTITY_H
+#define DM_SHELL_IDENTITY_H
+
+#import <Foundation/Foundation.h>
+#import <CommonCrypto/CommonDigest.h>
+
+static BOOL dm_shell_identity_is_source_sha(NSString *value) {
+    if (value.length != 40) return NO;
+    NSCharacterSet *nonHex = [[NSCharacterSet characterSetWithCharactersInString:@"0123456789abcdefABCDEF"] invertedSet];
+    return [value rangeOfCharacterFromSet:nonHex].location == NSNotFound;
+}
+
+// Return the single strict 40-hex SOURCE_SHA value, or nil for missing or malformed metadata.
+static NSString *dm_shell_identity_source_sha(NSString *metadataPath) {
+    if (!metadataPath.length) return nil;
+    NSString *contents = [NSString stringWithContentsOfFile:metadataPath encoding:NSUTF8StringEncoding error:nil];
+    if (!contents) return nil;
+    NSString *found = nil;
+    for (NSString *line in [contents componentsSeparatedByCharactersInSet:NSCharacterSet.newlineCharacterSet]) {
+        if (![line hasPrefix:@"SOURCE_SHA="]) continue;
+        if (found) return nil;
+        NSString *value = [line substringFromIndex:11];
+        if (!dm_shell_identity_is_source_sha(value)) return nil;
+        found = value.lowercaseString;
+    }
+    return found;
+}
+
+// Hash a regular file incrementally so boot diagnostics do not read the executable into one large allocation.
+static NSString *dm_shell_identity_sha256_file(NSURL *url) {
+    if (!url || !url.isFileURL) return nil;
+    NSInputStream *stream = [NSInputStream inputStreamWithURL:url];
+    if (!stream) return nil;
+    [stream open];
+    if (stream.streamStatus == NSStreamStatusError) { [stream close]; return nil; }
+
+    CC_SHA256_CTX context;
+    CC_SHA256_Init(&context);
+    uint8_t buffer[64 * 1024];
+    NSInteger count = 0;
+    do {
+        count = [stream read:buffer maxLength:sizeof buffer];
+        if (count > 0 && CC_SHA256_Update(&context, buffer, (CC_LONG)count) != 1) {
+            [stream close];
+            return nil;
+        }
+    } while (count > 0);
+    BOOL ok = count == 0 && stream.streamError == nil;
+    [stream close];
+    if (!ok) return nil;
+
+    unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+    if (!CC_SHA256_Final(digest, &context)) return nil;
+    static const char hex[] = "0123456789abcdef";
+    char encoded[CC_SHA256_DIGEST_LENGTH * 2];
+    for (NSUInteger i = 0; i < CC_SHA256_DIGEST_LENGTH; i++) {
+        encoded[i * 2] = hex[digest[i] >> 4];
+        encoded[i * 2 + 1] = hex[digest[i] & 0x0f];
+    }
+    return [[NSString alloc] initWithBytes:encoded length:sizeof encoded encoding:NSASCIIStringEncoding];
+}
+
+#endif
