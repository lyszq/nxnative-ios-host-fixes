+"""Windows-runnable source guards for the NVN LF/CRLF parser fix."""
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[3]
+SOURCE = ROOT / "dm/gfx/nvn/nvn_mtl.m"
+NATIVE = ROOT / "dm/gfx/tests/run_nvn_text_lines_native.py"
+
+
+def function_body(source: str, signature: str) -> str:
+    start = source.index(signature)
+    brace = source.index("{", start)
+    depth = 0
+    quote = None
+    escaped = False
+    i = brace
+    while i < len(source):
+        ch = source[i]
+        if quote:
+            if escaped:
+                escaped = False
+            elif ch == "\\":
+                escaped = True
+            elif ch == quote:
+                quote = None
+        elif ch in ('"', "'"):
+            quote = ch
+        elif ch == "{":
+            depth += 1
+        elif ch == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start:i + 1]
+        i += 1
+    raise AssertionError(f"unclosed function body: {signature}")
+
+
+class NVNTextLineTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.source = SOURCE.read_text(encoding="utf-8")
+        cls.helper = function_body(cls.source, "static NSString *nvn_line_without_cr(NSString *line)")
+
+    def test_normalizer_removes_only_one_final_cr(self):
+        self.assertIn('[line hasSuffix:@"\\r"]', self.helper)
+        self.assertIn("[line substringToIndex:line.length - 1]", self.helper)
+        self.assertNotRegex(self.helper, r"[Tt]rim|whitespace|newlineCharacterSet")
+
+    def test_pair_parser_normalizes_before_dedup_and_field_split(self):
+        body = function_body(self.source, "static NSArray<NSArray<NSString *> *> *pre_parse(NSString *txt)")
+        normalize = body.index("NSString *l = nvn_line_without_cr(raw)")
+        self.assertLess(normalize, body.index("[seen containsObject:l]"))
+        self.assertLess(normalize, body.index('[l componentsSeparatedByString:@"\\t"]'))
+
+    def test_warm_parser_normalizes_rows_before_dedup_and_dispatch(self):
+        body = function_body(self.source, "static NSArray<WarmTask *> *warm_parse(NSArray<NSString *> *paths, long *lines)")
+        self.assertGreaterEqual(body.count("nvn_line_without_cr(raw)"), 2)  # count and task passes
