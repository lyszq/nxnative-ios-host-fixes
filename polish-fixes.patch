@@ -0,0 +1,23 @@
+// Bounded, allocation-free keys for the optional render-target census.
+#ifndef NVN_RT_SURVEY_H
+#define NVN_RT_SURVEY_H
+#include <stdint.h>
+#include <string.h>
+
+enum { NVN_RT_SURVEY_LIMIT = 128 };
+typedef struct {
+    uint32_t role, slot, nvn_w, nvn_h, nvn_format, nvn_target, nvn_level, nvn_view_format;
+    uint32_t mtl_w, mtl_h, mtl_format, mtl_type, level, samples, layers, effective_w, effective_h, pass_w, pass_h;
+} nvn_rt_survey_key;
+_Static_assert(sizeof(nvn_rt_survey_key) == 19 * sizeof(uint32_t), "survey keys have no padding");
+typedef struct { nvn_rt_survey_key keys[NVN_RT_SURVEY_LIMIT]; unsigned count; } nvn_rt_survey;
+
+// 1: new configuration; 0: already seen; -1: full. The caller logs only new keys.
+static inline int nvn_rt_survey_add(nvn_rt_survey *survey, const nvn_rt_survey_key *key) {
+    for (unsigned i = 0; i < survey->count; i++)
+        if (!memcmp(&survey->keys[i], key, sizeof *key)) return 0;
+    if (survey->count >= NVN_RT_SURVEY_LIMIT) return -1;
+    survey->keys[survey->count++] = *key;
+    return 1;
+}
+#endif
diff --git a/dm/gfx/nvn/nvn_timing.h b/dm/gfx/nvn/nvn_timing.h
new file mode 100644
index 0000000..2ae0ff3
--- /dev/null
+++ b/dm/gfx/nvn/nvn_timing.h
@@ -0,0 +1,86 @@
+#ifndef DM_NVN_TIMING_H
+#define DM_NVN_TIMING_H
+
+#include <stdint.h>
+
+typedef uint64_t (*nvn_timing_clock_fn)(void *context);
+typedef void (*nvn_timing_predict_fn)(void *context);
+
+typedef struct {
+    uint64_t lib_ns;
+    uint64_t pso_ns;
+    uint64_t predict_lib_ns;
+} nvn_timing_totals;
+
+typedef struct {
+    uint64_t lib_ns;
+    uint64_t pso_ns;
+    uint64_t predict_lib_ns;
+    uint64_t make_ns;
+    int deltas_valid;
+    int make_valid;
+} nvn_timing_frame;
+
+// Keep the existing inclusive pipeline time while measuring its nested library portion.
+static inline int nvn_timing_account_prediction(uint64_t *lib_ns, uint64_t *pso_ns,
+                                                 uint64_t *predict_lib_ns, int *valid,
+                                                 nvn_timing_clock_fn clock_now,
+                                                 nvn_timing_predict_fn predict, void *context) {
+    if (!lib_ns || !pso_ns || !predict_lib_ns || !valid || !clock_now || !predict) {
+        if (valid) *valid = 0;
+        return 0;
+    }
+    uint64_t lib_before = *lib_ns;
+    uint64_t start = clock_now(context);
+    predict(context);
+    uint64_t end = clock_now(context);
+    if (end < start) {
+        *valid = 0;
+        return 0;
+    }
+    uint64_t elapsed = end - start;
+    int ok = 1;
+    if (elapsed > UINT64_MAX - *pso_ns) {
+        *valid = 0;
+        ok = 0;
+    } else {
+        *pso_ns += elapsed;
+    }
+    if (*lib_ns < lib_before) {
+        *valid = 0;
+        return 0;
+    }
+    uint64_t nested_lib = *lib_ns - lib_before;
+    if (nested_lib > UINT64_MAX - *predict_lib_ns) {
+        *valid = 0;
+        return 0;
+    }
+    *predict_lib_ns += nested_lib;
+    return ok;
+}
+
+// A component delta can remain useful even if its overlap invariant fails; only make_ns is then unknown.
+static inline void nvn_timing_frame_delta(const nvn_timing_totals *previous,
+                                           const nvn_timing_totals *current,
+                                           int counters_valid, nvn_timing_frame *out) {
+    if (!out) return;
+    out->lib_ns = out->pso_ns = out->predict_lib_ns = out->make_ns = 0;
+    out->deltas_valid = out->make_valid = 0;
+    if (!previous || !current || !counters_valid ||
+        current->lib_ns < previous->lib_ns ||
+        current->pso_ns < previous->pso_ns ||
+        current->predict_lib_ns < previous->predict_lib_ns) return;
+
+    out->lib_ns = current->lib_ns - previous->lib_ns;
+    out->pso_ns = current->pso_ns - previous->pso_ns;
+    out->predict_lib_ns = current->predict_lib_ns - previous->predict_lib_ns;
+    out->deltas_valid = 1;
+    if (out->predict_lib_ns > out->lib_ns || out->predict_lib_ns > out->pso_ns) return;
+
+    uint64_t exclusive_lib_ns = out->lib_ns - out->predict_lib_ns;
+    if (out->pso_ns > UINT64_MAX - exclusive_lib_ns) return;
+    out->make_ns = exclusive_lib_ns + out->pso_ns;
+    out->make_valid = 1;
+}
+
+#endif
diff --git a/dm/gfx/tests/nvn_timing_native.c b/dm/gfx/tests/nvn_timing_native.c
new file mode 100644
index 0000000..c35524f
--- /dev/null
+++ b/dm/gfx/tests/nvn_timing_native.c
@@ -0,0 +1,99 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "nvn_timing.h"
+
+typedef struct {
+    uint64_t now_ns;
+    uint64_t *lib_ns;
+    uint64_t prefetch_ns;
+    uint64_t direct_load_ns;
+    uint64_t scan_ns;
+} fake_prediction;
+
+static uint64_t fake_clock(void *context) {
+    return ((fake_prediction *)context)->now_ns;
+}
+
+static void fake_predict(void *context) {
+    fake_prediction *p = (fake_prediction *)context;
+    p->now_ns += p->prefetch_ns;
+    *p->lib_ns += p->prefetch_ns;
+    p->now_ns += p->direct_load_ns;
+    *p->lib_ns += p->direct_load_ns;
+    p->now_ns += p->scan_ns;
+}
+
+static void test_frame_aggregation(void) {
+    nvn_timing_totals previous = {0, 0, 0};
+    nvn_timing_frame frame;
+
+    nvn_timing_totals current = {150, 200, 100};
+    nvn_timing_frame_delta(&previous, &current, 1, &frame);
+    assert(frame.deltas_valid && frame.make_valid);
+    assert(frame.lib_ns == 150 && frame.pso_ns == 200 && frame.predict_lib_ns == 100);
+    assert(frame.make_ns == 250);  // Old additive total was 350 units.
+
+    previous = current;
+    current = (nvn_timing_totals){240, 225, 100};
+    nvn_timing_frame_delta(&previous, &current, 1, &frame);
+    assert(frame.deltas_valid && frame.make_valid && frame.make_ns == 115);
+
+    previous = (nvn_timing_totals){0, 0, 0};
+    current = (nvn_timing_totals){95, 80, 80};
+    nvn_timing_frame_delta(&previous, &current, 1, &frame);
+    assert(frame.deltas_valid && frame.make_valid && frame.make_ns == 95);
+
+    current = (nvn_timing_totals){30, 40, 31};
+    nvn_timing_frame_delta(&previous, &current, 1, &frame);
+    assert(frame.deltas_valid && !frame.make_valid);
+
+    current = (nvn_timing_totals){UINT64_MAX, 1, 0};
+    nvn_timing_frame_delta(&previous, &current, 1, &frame);
+    assert(frame.deltas_valid && !frame.make_valid);  // Addition must not wrap.
+
+    current = (nvn_timing_totals){10, 10, 0};
+    nvn_timing_frame_delta(&current, &previous, 1, &frame);
+    assert(!frame.deltas_valid && !frame.make_valid);  // A cumulative counter went backwards.
+
+    nvn_timing_frame_delta(&previous, &current, 0, &frame);
+    assert(!frame.deltas_valid && !frame.make_valid);  // The source marked its snapshot invalid.
+}
+
+static void test_accounted_prediction_wrapper(void) {
+    uint64_t lib_ns = 11, pso_ns = 23, predict_lib_ns = 4;
+    int valid = 1;
+    lib_ns += 5;  // A load before prediction must not enter predict_lib_ns.
+    fake_prediction p = {1000, &lib_ns, 70, 20, 10};
+
+    assert(nvn_timing_account_prediction(&lib_ns, &pso_ns, &predict_lib_ns, &valid,
+                                         fake_clock, fake_predict, &p));
+    assert(valid && pso_ns == 123 && lib_ns == 106 && predict_lib_ns == 94);
+    lib_ns += 7;  // A load after prediction must not enter predict_lib_ns.
+
+    nvn_timing_totals previous = {11, 23, 4};
+    nvn_timing_totals current = {lib_ns, pso_ns, predict_lib_ns};
+    nvn_timing_frame frame;
+    nvn_timing_frame_delta(&previous, &current, valid, &frame);
+    assert(frame.deltas_valid && frame.make_valid);
+    assert(frame.lib_ns == 102 && frame.pso_ns == 100 && frame.predict_lib_ns == 90);
+    assert(frame.make_ns == 112);  // 5 ns before + 100 ns prediction + 7 ns after.
+
+    p.now_ns = UINT64_MAX - 5;  // A wrapping clock invalidates aggregation rather than inventing a duration.
+    assert(!nvn_timing_account_prediction(&lib_ns, &pso_ns, &predict_lib_ns, &valid,
+                                          fake_clock, fake_predict, &p));
+    assert(!valid);
+
+    lib_ns = 10; pso_ns = 5; predict_lib_ns = UINT64_MAX - 2; valid = 1;
+    p = (fake_prediction){500, &lib_ns, 2, 1, 0};
+    assert(!nvn_timing_account_prediction(&lib_ns, &pso_ns, &predict_lib_ns, &valid,
+                                          fake_clock, fake_predict, &p));
+    assert(!valid && pso_ns == 8 && predict_lib_ns == UINT64_MAX - 2);
+}
+
+int main(void) {
+    test_frame_aggregation();
+    test_accounted_prediction_wrapper();
+    puts("PASS: NVN inclusive PSO, nested library and frame aggregate timing");
+    return 0;
+}
