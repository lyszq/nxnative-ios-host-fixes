index 0000000..e85a68b
--- /dev/null
+++ b/dm/gfx/tests/test_nvn_pair_batch.py
@@ -0,0 +1,97 @@
+"""Source guards for the strict opt-in, demand-only VS+FS batch loader."""
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[3]
+SOURCE = ROOT / "dm/gfx/nvn/nvn_mtl.m"
+HELPER = ROOT / "dm/gfx/nvn/nvn_pair_batch.h"
+NATIVE = ROOT / "dm/gfx/tests/run_nvn_pair_batch_native.py"
+
+
+def function_body(source: str, signature: str) -> str:
+    start = source.index(signature)
+    brace = source.index("{", start)
+    depth = 0
+    quote = None
+    escaped = False
+    i = brace
+    while i < len(source):
+        ch = source[i]
+        if quote:
+            if escaped:
+                escaped = False
+            elif ch == "\\":
+                escaped = True
+            elif ch == quote:
+                quote = None
+            i += 1
+            continue
+        if source.startswith("//", i):
+            newline = source.find("\n", i + 2)
+            i = len(source) if newline < 0 else newline + 1
+            continue
+        if source.startswith("/*", i):
+            end = source.find("*/", i + 2)
+            if end < 0:
+                raise AssertionError(f"unclosed comment in: {signature}")
+            i = end + 2
+            continue
+        if ch in ('"', "'"):
+            quote = ch
+        elif ch == "{":
+            depth += 1
+        elif ch == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start:i + 1]
+        i += 1
+    raise AssertionError(f"unclosed function body: {signature}")
+
+
+class NVNPairBatchTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.source = SOURCE.read_text(encoding="utf-8")
+        cls.helper = HELPER.read_text(encoding="utf-8")
+
+    def test_flag_is_strict_opt_in_and_pair_is_demand_only(self):
+        flag = function_body(self.source, "static int pair_load_on(void)")
+        self.assertIn('getenv("DM_NVN_PAIR_LOAD")', flag)
+        self.assertIn('!strcmp(e, "1")', flag)
+        self.assertIn("if (p->nstage == 2 && pair_load_on())", function_body(self.source, "static __unsafe_unretained NvProg *prog_get"))
+        self.assertNotIn("pso_predict_rest", function_body(self.source, "static __unsafe_unretained NvProg *prog_get"))
+
+    def test_exact_stage_cache_and_warm_gates(self):
+        eligible = function_body(self.helper, "static inline BOOL nvn_pair_load_eligible")
+        self.assertIn("keys.count != 2 || stages.count != 2", eligible)
+        self.assertIn("stage0 == 0 && stage1 == 1", eligible)
+        self.assertIn("stage0 == 1 && stage1 == 0", eligible)
+        self.assertIn("[key0 isEqualToString:key1]", eligible)
+        self.assertIn("cache[key0] == nil && cache[key1] == nil", eligible)
+        self.assertIn("!warm_started || warm_running || warm_ready", eligible)
+
+    def test_worker_results_are_local_and_submission_thread_publishes_in_order(self):
+        body = function_body(self.source, "static __unsafe_unretained NvProg *prog_get")
+        batch = body.index("pair_results = nvn_pair_load_joined")
+        publish = body.index("g_shcache[key] = sh", batch)
+        record = body.index('pso_record("S\\t%s\\t%d\\n", key.UTF8String, stage)', publish)
+        consume = body.index("if (pair_attempted && i < pair_results.count)", record)
+        self.assertLess(batch, publish)
+        self.assertLess(publish, record)
+        self.assertLess(record, consume)
+        self.assertIn("uint64_t dt = bp_now() - t0; unsigned got = 0", body)
+        self.assertIn("g_bp_lib_n += got; g_bp_lib_ns += dt", body)
+        self.assertIn("g_pair_failed += 2 - got", body)
+        self.assertNotIn("g_shcache", self.helper)
+        self.assertNotIn("pso_record", self.helper)
+
+    @unittest.skipUnless(sys.platform == "darwin", "native Foundation batch fixture requires macOS/Xcode")
+    def test_native_foundation_fake_loader(self):
+        subprocess.run([sys.executable, str(NATIVE)], cwd=ROOT, check=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
