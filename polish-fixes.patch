+#!/usr/bin/env python3
+"""Compile and run the pure-C NVN timing helper tests with Zig on Windows or Clang on macOS."""
+from pathlib import Path
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[3]
+SOURCE = Path(__file__).with_name("nvn_timing_native.c")
+
+
+def main():
+    if sys.platform == "darwin":
+        compiler = shutil.which("xcrun")
+        if not compiler:
+            print("SKIP: xcrun is required for the macOS native timing test")
+            return 77
+        command = [compiler, "clang"]
+    elif sys.platform == "win32":
+        compiler = shutil.which("zig")
+        if not compiler:
+            print("SKIP: Zig is required for the Windows native timing test")
+            return 77
+        command = [compiler, "cc"]
+    else:
+        compiler = shutil.which("clang") or shutil.which("cc")
+        if not compiler:
+            print("SKIP: a C compiler is required for the native timing test")
+            return 77
+        command = [compiler]
+
+    with tempfile.TemporaryDirectory(prefix="nvn-timing-native-") as temp:
+        executable = Path(temp) / ("nvn_timing_test.exe" if sys.platform == "win32" else "nvn_timing_test")
+        compile_command = command + ["-std=c11", "-Wall", "-Wextra", "-Werror",
+                                     "-I", str(ROOT / "dm/gfx/nvn"), str(SOURCE), "-o", str(executable)]
+        env = os.environ.copy()
+        if sys.platform == "win32" and not env.get("ZIG_LIB_DIR"):
+            zig_lib = Path(compiler).resolve().parent / "lib"
+            if zig_lib.is_dir():
+                env["ZIG_LIB_DIR"] = str(zig_lib)
+        subprocess.run(compile_command, cwd=ROOT, env=env, check=True)
+        subprocess.run([str(executable)], cwd=ROOT, check=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/dm/gfx/tests/t_nvn_pair_batch.m b/dm/gfx/tests/t_nvn_pair_batch.m
new file mode 100644
index 0000000..f0df234
--- /dev/null
+++ b/dm/gfx/tests/t_nvn_pair_batch.m
@@ -0,0 +1,121 @@
+// Joined cold VS+FS shader loads: pure Foundation and fake loaders, no Metal device.
+#import <Foundation/Foundation.h>
+#include <assert.h>
+#import "../nvn/nvn_pair_batch.h"
+
+static NSArray<NSString *> *pair_keys(void) { return @[@"pixel-key_b", @"vertex-key_b"]; }
+static NSArray<NSNumber *> *pair_stages(void) { return @[@1, @0]; }
+
+static NSArray *run_pair(NSArray<NSString *> *keys, NSArray<NSNumber *> *stages,
+                         NSDictionary<NSString *, id> *cache, BOOL enabled,
+                         BOOL warm_started, BOOL warm_running, BOOL warm_ready,
+                         nvn_pair_shader_loader loader, BOOL *attempted) {
+    return nvn_pair_load_joined(keys, stages, cache, enabled, warm_started,
+                                warm_running, warm_ready, loader, attempted);
+}
+
+static void test_eligibility_gates(void) {
+    NSDictionary *empty = @{};
+    __block int calls = 0;
+    nvn_pair_shader_loader loader = ^id(NSString *key, NSInteger stage) { (void)key; (void)stage; calls++; return [NSObject new]; };
+    struct { BOOL enabled, started, running, ready; } gates[] = {
+        {NO, YES, NO, NO}, {YES, NO, NO, NO}, {YES, YES, YES, NO}, {YES, YES, NO, YES}
+    };
+    for (NSUInteger i = 0; i < sizeof gates / sizeof gates[0]; i++) {
+        BOOL attempted = YES;
+        NSArray *result = run_pair(pair_keys(), pair_stages(), empty, gates[i].enabled,
+                                   gates[i].started, gates[i].running, gates[i].ready, loader, &attempted);
+        assert(!attempted && !result && calls == 0);
+    }
+    BOOL attempted = YES;
+    assert(!run_pair(pair_keys(), @[@0, @0], empty, YES, YES, NO, NO, loader, &attempted));
+    assert(!attempted && calls == 0);  // Two vertices (or two pixels) are not a render pair.
+    assert(!run_pair(@[@"same", @"same"], @[@0, @1], empty, YES, YES, NO, NO, loader, &attempted));
+    assert(!attempted && calls == 0);
+    assert(!run_pair(@[@"", @"pixel"], @[@0, @1], empty, YES, YES, NO, NO, loader, &attempted));
+    assert(!attempted && calls == 0);
+    NSArray *keys = pair_keys();
+    assert(!run_pair(keys, pair_stages(), @{keys[0]: @YES}, YES, YES, NO, NO, loader, &attempted));
+    assert(!attempted && calls == 0);  // Either cached stage keeps the serial/cache-hit path.
+    assert(!run_pair(keys, pair_stages(), @{keys[1]: @YES}, YES, YES, NO, NO, loader, &attempted));
+    assert(!attempted && calls == 0);
+    assert(!run_pair(pair_keys(), pair_stages(), empty, YES, YES, NO, NO, nil, &attempted));
+    assert(!attempted && calls == 0);
+}
+
+static void test_joined_parallel_identity(void) {
+    NSCondition *condition = [NSCondition new];
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+    __block NSUInteger entered = 0, max_entered = 0;
+    __block BOOL released = NO, attempted = NO;
+    __block NSArray *result = nil;
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        result = run_pair(pair_keys(), pair_stages(), @{}, YES, YES, NO, NO,
+                          ^id(NSString *key, NSInteger stage) {
+            [condition lock];
+            entered++; if (entered > max_entered) max_entered = entered;
+            [condition broadcast];
+            while (!released) [condition wait];
+            [condition unlock];
+            return [NSString stringWithFormat:@"%@:%ld", key, (long)stage];
+        }, &attempted);
+        dispatch_semaphore_signal(done);
+    });
+    [condition lock];
+    NSDate *deadline = [NSDate dateWithTimeIntervalSinceNow:5.0];
+    while (entered < 2 && [condition waitUntilDate:deadline]) {}
+    BOOL overlapped = entered == 2;
+    released = YES; [condition broadcast]; [condition unlock];
+    long finished = dispatch_semaphore_wait(done, dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC));
+    assert(finished == 0 && overlapped && max_entered == 2 && attempted);
+    assert(result.count == 2);
+    assert([result[0] isEqual:@"pixel-key_b:1"] && [result[1] isEqual:@"vertex-key_b:0"]);
+}
+
+static void test_failure_is_local_and_not_retried(void) {
+    NSMutableDictionary<NSString *, NSNumber *> *calls = [NSMutableDictionary dictionary];
+    @synchronized (calls) { calls[@"pixel-key_b"] = @0; calls[@"vertex-key_b"] = @0; }
+    BOOL attempted = NO;
+    NSArray *result = run_pair(pair_keys(), pair_stages(), @{}, YES, YES, NO, NO,
+                               ^id(NSString *key, NSInteger stage) {
+        (void)stage;
+        @synchronized (calls) { calls[key] = @(calls[key].intValue + 1); }
+        return [key isEqualToString:@"pixel-key_b"] ? nil : [NSObject new];
+    }, &attempted);
+    assert(attempted && result.count == 2 && result[0] == NSNull.null && result[1] != NSNull.null);
+    @synchronized (calls) { assert(calls[@"pixel-key_b"].intValue == 1 && calls[@"vertex-key_b"].intValue == 1); }
+}
+
+static void test_result_owns_worker_object(void) {
+    __block __weak NSObject *pixel_object = nil, *vertex_object = nil;
+    NSArray *result = nil;
+    BOOL attempted = NO;
+    @autoreleasepool {
+        result = run_pair(pair_keys(), pair_stages(), @{}, YES, YES, NO, NO,
+                          ^id(NSString *key, NSInteger stage) {
+            (void)key;
+            NSObject *value = [NSObject new];
+            if (stage == 1) pixel_object = value; else vertex_object = value;
+            return value;
+        }, &attempted);
+    }
+    // Weak loads can create autoreleased strong temporaries. Drain those before
+    // testing release of the array's ownership, rather than retaining the objects
+    // ourselves until the test's outer autorelease pool closes.
+    @autoreleasepool {
+        assert(attempted && pixel_object != nil && vertex_object != nil && result[0] != NSNull.null && result[1] != NSNull.null);
+    }
+    result = nil;
+    assert(pixel_object == nil && vertex_object == nil);
+}
+
+int main(void) {
+    @autoreleasepool {
+        test_eligibility_gates();
+        test_joined_parallel_identity();
+        test_failure_is_local_and_not_retried();
+        test_result_owns_worker_object();
+    }
+    puts("PASS: NVN opt-in cold VS+FS batch gates, joined execution, local failures and ownership");
+    return 0;
+}
