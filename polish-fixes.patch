+#include "../nvn/nvn_rt_survey.h"
+#undef NDEBUG
+#include <assert.h>
+#include <stdio.h>
+
+int main(void) {
+    nvn_rt_survey survey = {0};
+    nvn_rt_survey_key key = {0};
+    key.nvn_w = key.mtl_w = 1600; key.nvn_h = key.mtl_h = 900;
+    key.effective_w = key.pass_w = 1600; key.effective_h = key.pass_h = 900;
+    key.samples = key.layers = 1;
+    assert(nvn_rt_survey_add(&survey, &key) == 1);
+    assert(nvn_rt_survey_add(&survey, &key) == 0 && survey.count == 1);
+
+    // Every independently reported property must distinguish otherwise identical configurations.
+    uint32_t fields[19]; memcpy(fields, &key, sizeof fields);
+    for (unsigned i = 0; i < 19; i++) {
+        uint32_t changed[19]; memcpy(changed, fields, sizeof fields); changed[i]++;
+        nvn_rt_survey_key other; memcpy(&other, changed, sizeof other);
+        assert(nvn_rt_survey_add(&survey, &other) == 1);
+        assert(nvn_rt_survey_add(&survey, &other) == 0);
+    }
+    assert(survey.count == 20);
+    while (survey.count < NVN_RT_SURVEY_LIMIT) {
+        key.mtl_format = 1000 + survey.count;
+        assert(nvn_rt_survey_add(&survey, &key) == 1);
+    }
+    nvn_rt_survey before = survey;
+    key.mtl_format = 999999;
+    assert(nvn_rt_survey_add(&survey, &key) == -1);
+    assert(!memcmp(&survey, &before, sizeof survey));
+    assert(nvn_rt_survey_add(&survey, &survey.keys[0]) == 0);
+    puts("PASS: RT survey distinguishes logical/Metal/mip/pass layouts, deduplicates, and saturates without mutation");
+    return 0;
+}
