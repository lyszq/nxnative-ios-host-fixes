diff --git a/dm/gfx/nvn/nvn_pair_batch.h b/dm/gfx/nvn/nvn_pair_batch.h
new file mode 100644
index 0000000..2dc5fce
--- /dev/null
+++ b/dm/gfx/nvn/nvn_pair_batch.h
@@ -0,0 +1,59 @@
+#ifndef NVN_PAIR_BATCH_H
+#define NVN_PAIR_BATCH_H
+
+#import <Foundation/Foundation.h>
+#import <dispatch/dispatch.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+// Joined, demand-driven loading of exactly one vertex and one pixel library.
+// The caller owns cache publication; loader workers only return per-attempt objects.
+typedef id _Nullable (^nvn_pair_shader_loader)(NSString *key, NSInteger stage);
+
+static inline BOOL nvn_pair_load_eligible(NSArray<NSString *> * _Nullable keys,
+                                          NSArray<NSNumber *> * _Nullable stages,
+                                          NSDictionary<NSString *, id> * _Nullable cache,
+                                          BOOL enabled,
+                                          BOOL warm_started,
+                                          BOOL warm_running,
+                                          BOOL warm_ready) {
+    if (!enabled || !warm_started || warm_running || warm_ready || !keys || !stages || !cache ||
+        keys.count != 2 || stages.count != 2) return NO;
+    NSString *key0 = keys[0], *key1 = keys[1];
+    if (![key0 isKindOfClass:NSString.class] || !key0.length ||
+        ![key1 isKindOfClass:NSString.class] || !key1.length || [key0 isEqualToString:key1]) return NO;
+    id stage0_value = stages[0], stage1_value = stages[1];
+    if (![stage0_value isKindOfClass:NSNumber.class] || ![stage1_value isKindOfClass:NSNumber.class]) return NO;
+    NSInteger stage0 = [stage0_value integerValue], stage1 = [stage1_value integerValue];
+    if (!((stage0 == 0 && stage1 == 1) || (stage0 == 1 && stage1 == 0))) return NO;
+    return cache[key0] == nil && cache[key1] == nil;
+}
+
+// Results stay aligned with input order. NSNull marks an attempted load failure,
+// so the submit-thread caller can avoid immediately retrying that stage serially.
+static inline NSArray * _Nullable nvn_pair_load_joined(NSArray<NSString *> * _Nullable keys,
+                                                        NSArray<NSNumber *> * _Nullable stages,
+                                                        NSDictionary<NSString *, id> * _Nullable cache,
+                                                        BOOL enabled,
+                                                        BOOL warm_started,
+                                                        BOOL warm_running,
+                                                        BOOL warm_ready,
+                                                        nvn_pair_shader_loader _Nullable loader,
+                                                        BOOL * _Nullable attempted) {
+    if (attempted) *attempted = NO;
+    if (!loader || !nvn_pair_load_eligible(keys, stages, cache, enabled,
+                                           warm_started, warm_running, warm_ready)) return nil;
+    if (attempted) *attempted = YES;
+    NSMutableArray *results = [NSMutableArray arrayWithObjects:NSNull.null, NSNull.null, nil];
+    NSLock *result_lock = [NSLock new];
+    dispatch_apply(2, DISPATCH_APPLY_AUTO, ^(size_t i) { @autoreleasepool {
+        id value = loader(keys[i], stages[i].integerValue);
+        if (value) {
+            [result_lock lock]; results[i] = value; [result_lock unlock];
+        }
+    } });
+    return [results copy];
+}
+
+NS_ASSUME_NONNULL_END
+#endif
diff --git a/dm/gfx/nvn/nvn_rt_survey.h b/dm/gfx/nvn/nvn_rt_survey.h
