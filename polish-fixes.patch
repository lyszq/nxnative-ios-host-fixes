@@ -0,0 +1,156 @@
+#!/usr/bin/env python3
+"""Exercise the actual NVN text parsers with LF and CRLF fixtures on macOS."""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[3]
+SOURCE = ROOT / "dm/gfx/nvn/nvn_mtl.m"
+
+
+def extract_function(source: str, signature: str) -> str:
+    start = source.index(signature)
+    brace = source.index("{", start)
+    depth = 0
+    quote = None
+    line_comment = False
+    block_comment = False
+    escaped = False
+    i = brace
+    while i < len(source):
+        ch = source[i]
+        nxt = source[i + 1] if i + 1 < len(source) else ""
+        if line_comment:
+            if ch == "\n":
+                line_comment = False
+        elif block_comment:
+            if ch == "*" and nxt == "/":
+                block_comment = False
+                i += 1
+        elif quote:
+            if escaped:
+                escaped = False
+            elif ch == "\\":
+                escaped = True
+            elif ch == quote:
+                quote = None
+        elif ch == "/" and nxt == "/":
+            line_comment = True
+            i += 1
+        elif ch == "/" and nxt == "*":
+            block_comment = True
+            i += 1
+        elif ch in ('"', "'"):
+            quote = ch
+        elif ch == "{":
+            depth += 1
+        elif ch == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start:i + 1]
+        i += 1
+    raise ValueError(f"unclosed function body: {signature}")
+
+
+def main() -> int:
+    if sys.platform != "darwin":
+        print("SKIP: native Foundation parser test requires macOS/Xcode")
+        return 77
+
+    text = SOURCE.read_text(encoding="utf-8")
+    signatures = (
+        "static NSString *nvn_line_without_cr(NSString *line)",
+        "static void pso_user_add_existing_lines(NSMutableSet<NSString *> *lines, NSString *txt)",
+        "static NSString *warm_key(const char *s, size_t n)",
+        "static int warm_stale(NSString *key, NSMutableSet<NSString *> *stale)",
+        "static NSArray<NSArray<NSString *> *> *pre_parse(NSString *txt)",
+        "static NSArray<WarmTask *> *warm_parse(NSArray<NSString *> *paths, long *lines)",
+    )
+    functions = "\n\n".join(extract_function(text, signature) for signature in signatures)
+    harness = r'''
+#import <Foundation/Foundation.h>
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "nvn_pso_skey.h"
+
+static NSMutableDictionary<NSString *, NSString *> *g_shmap;
+static uint64_t g_warm_skip_stale;
+@interface WarmTask : NSObject { @public int kind, stage; NSString *key, *vkey, *fkey; NSMutableArray<NSData *> *rs; }
+@end
+@implementation WarmTask @end
+#define MLOG(...) ((void)0)
+
+/* ACTUAL_PARSER_FUNCTIONS */
+
+static void check_tasks(NSArray<WarmTask *> *tasks, long lines) {
+    assert(lines == 3 && tasks.count == 3);
+    WarmTask *shader = nil, *compute = nil, *render = nil;
+    for (WarmTask *task in tasks) {
+        if (task->kind == 0) shader = task;
+        else if (task->kind == 2) compute = task;
+        else if (task->kind == 1) render = task;
+    }
+    assert(shader && [shader->key isEqualToString:@"shader-a"] && shader->stage == 0);
+    assert(compute && [compute->key isEqualToString:@"compute-a"] && compute->stage == 5);
+    assert(render && [render->vkey isEqualToString:@"shader-a"] && [render->fkey isEqualToString:@"shader-b"]);
+    assert(render->rs.count == 1);
+}
+
+static void check_warm_file(NSString *text, NSString *name) {
+    NSString *path = [NSTemporaryDirectory() stringByAppendingPathComponent:name];
+    assert([text writeToFile:path atomically:YES encoding:NSUTF8StringEncoding error:nil]);
+    long lines = 0;
+    NSArray<WarmTask *> *tasks = warm_parse(@[path], &lines);
+    check_tasks(tasks, lines);
+    [NSFileManager.defaultManager removeItemAtPath:path error:nil];
+}
+
+int main(void) { @autoreleasepool {
+    assert([nvn_line_without_cr(@"row \r") isEqualToString:@"row "]);
+    assert([nvn_line_without_cr(@"row\r\r") isEqualToString:@"row\r"]);
+    assert([nvn_line_without_cr(@"row ") isEqualToString:@"row "]);
+
+    NSString *pairText = @"vs-a\tfs-a\nvs-a\tfs-a\r\nvs-b \tfs-b\r\n# comment\r\n\r\n";
+    NSArray<NSArray<NSString *> *> *pairs = pre_parse(pairText);
+    assert(pairs.count == 2);
+    assert([pairs[0][0] isEqualToString:@"vs-a"] && [pairs[0][1] isEqualToString:@"fs-a"]);
+    assert([pairs[1][0] isEqualToString:@"vs-b "] && [pairs[1][1] isEqualToString:@"fs-b"]);
+
+    NSString *records = @"# manifest\nS\tshader-a\t0\nS\tshader-a\t0\nC\tcompute-a\nC\tcompute-a\nR\t%s\nR\t%s\n";
+    pso_skey key = {0}; strcpy(key.vs, "shader-a"); strcpy(key.fs, "shader-b");
+    char hex[sizeof key * 2 + 1]; pso_skey_hex(&key, hex);
+    NSString *lf = [NSString stringWithFormat:records, hex, hex];
+    NSString *crlf = [lf stringByReplacingOccurrencesOfString:@"\n" withString:@"\r\n"];
+    g_shmap = [@{@"shader-a": @"lib", @"shader-b": @"lib", @"compute-a": @"lib"} mutableCopy];
+    check_warm_file(lf, @"nvn-lines-lf.tsv");
+    check_warm_file(crlf, @"nvn-lines-crlf.tsv");
+
+    NSString *userCRLF = @"# prior seed\r\nS\tshader-a\t0\r\nS\tshader-a\t0\r\nC\tcompute-a \r\n";
+    NSString *userLF = [userCRLF stringByReplacingOccurrencesOfString:@"\r\n" withString:@"\n"];
+    NSMutableSet<NSString *> *a = [NSMutableSet set], *b = [NSMutableSet set];
+    pso_user_add_existing_lines(a, userCRLF); pso_user_add_existing_lines(b, userLF);
+    assert([a isEqualToSet:b] && a.count == 2);
+    assert([a containsObject:@"S\tshader-a\t0"] && [a containsObject:@"C\tcompute-a "]);
+    puts("PASS: actual pre_parse, pso_user row extraction, and warm_parse accept equivalent LF/CRLF S/R/C rows; pair and row dedup preserve spaces");
+} return 0; }
+'''.replace("/* ACTUAL_PARSER_FUNCTIONS */", functions)
+
+    with tempfile.TemporaryDirectory(prefix="nvn-text-lines-") as td:
+        source = Path(td) / "test.m"
+        executable = Path(td) / "test"
+        source.write_text(harness, encoding="utf-8", newline="\n")
+        subprocess.run([
+            "xcrun", "clang", "-fobjc-arc", "-Wall", "-Wextra",
+            "-I", str(ROOT / "dm/gfx/nvn"), "-framework", "Foundation",
+            "-I", str(ROOT / "dm/gfx/nvn/include"),
+            str(source), "-o", str(executable),
+        ], check=True)
+        subprocess.run([str(executable)], check=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
