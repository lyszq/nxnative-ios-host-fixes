+static void common(void) {
+    equal("DM_NVN_TBDR","0"); equal("DM_NVN_PASSDUMP","4200-4202"); equal("DM_NVN_PASSDUMP_ALL","1");
+    equal("DM_NVN_SHMAP","bundle/shader_map.tsv"); equal("DM_MSL_DIR","Documents/msl");
+    equal("DM_NVN_ENC_THREAD","1"); equal("DM_SAVE","Documents/save");
+}
