+    size_t bytes=0;for(int i=0;i<g_nhostseg;i++){bytes+=g_hostseg[i].n;free(g_hostseg[i].mem);}assert(bytes==g_hostseg_bytes);free(g_hostseg);
+    puts("PASS actual production command-memory helpers: 200000 regrants bounded to 2 segments, cached handles, overlap, chain, command precedence, fresh owner, invalid and unknown ranges");return 0;
+}
+"""
+def source(text, objects):
+    start=objects.index('typedef struct {',objects.index('// Command buffer:'))
+    end=objects.index('} cmd_t;',start)+len('} cmd_t;')
+    declaration=objects[start:end]
+    if 'control_size' not in declaration:
+        declaration=declaration.replace('} cmd_t;','uint8_t *control; size_t control_size; } cmd_t;')
+    pool=text[text.index('#define HOSTSEG_SZ'):text.index('NVN(nvnCommandBufferAddCommandMemory,')]
+    start=text.index('NVN(nvnCommandBufferAddControlMemory,')
+    pos=text.index('{',start);depth=1;end=pos+1
+    while depth:
+        if text[end]=='{':depth+=1
+        elif text[end]=='}':depth-=1
+        end+=1
+    grant=text[start:end]
+    return PREAMBLE+declaration+'\ntypedef cmd_t NVNcommandBuffer;\n#define CB(c) ((cmd_t *)(c))\n#define NVN(name,ret,...) static ret h_##name(__VA_ARGS__)\n'+pool+grant+'\n'+TEST
+
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument('--cc');ap.add_argument('--baseline',type=Path);ap.add_argument('--report',type=Path);args=ap.parse_args()
+    command=args.cc or os.environ.get('CC')
+    if command:cc=shlex.split(command,posix=os.name!='nt')
+    else:
+        name=next((shutil.which(n) for n in ('cc','clang','gcc','zig') if shutil.which(n)),None)
+        if not name:ap.error('No C compiler; pass --cc')
+        cc=[name]+(['cc'] if Path(name).stem.lower()=='zig' else [])
+    current=(ROOT/'dm/gfx/nvn/hle_nvn.c').read_text(encoding='utf-8');objects=(ROOT/'dm/gfx/nvn/nvn_obj.h').read_text(encoding='utf-8')
+    results=[]
+    with tempfile.TemporaryDirectory(prefix='command-memory-') as tmp:
+        tmp=Path(tmp);env=dict(os.environ)
+        if Path(cc[0]).stem.lower()=='zig':
+            env['ZIG_LIB_DIR']=str(Path(cc[0]).parent/'lib');env['ZIG_LOCAL_CACHE_DIR']=str(tmp/'local');env['ZIG_GLOBAL_CACHE_DIR']=str(tmp/'global')
+        variants=[('fixed',current,objects,[])]
+        if args.baseline:
+            with zipfile.ZipFile(args.baseline) as z:
+                variants.insert(0,('baseline',z.read('dm/gfx/nvn/hle_nvn.c').decode(),z.read('dm/gfx/nvn/nvn_obj.h').decode(),['baseline']))
+        for label,text,obj,extra in variants:
+            file=tmp/(label+'.c');exe=tmp/(label+('.exe' if os.name=='nt' else ''));file.write_text(source(text,obj),encoding='utf-8')
+            subprocess.run(cc+['-std=c11','-O1','-UNDEBUG','-Wall','-Wextra','-Werror','-Wno-unused-function',str(file),'-o',str(exe)],check=True,env=env,timeout=120)
+            r=subprocess.run([str(exe)]+extra,capture_output=True,text=True,timeout=30)
+            if label=='fixed':assert r.returncode==0,r.stdout+r.stderr
+            else:assert r.returncode!=0,'Baseline unexpectedly passed regression'
+            result={'variant':label,'returncode':r.returncode,'stdout':r.stdout.strip(),'stderr':r.stderr[-1200:].strip()};results.append(result);print(json.dumps(result))
+    if args.report:args.report.write_text(json.dumps({'scope':'Actual production helper C; single-thread synthetic lifetime tests; no GPU/device result','results':results},indent=2)+'\n',encoding='utf-8')
+if __name__=='__main__':main()
