+static void write_fixture_file(const char *path, const void *bytes, size_t size) {
+    int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+    assert(fd >= 0);
+    write_all(fd, bytes, size);
+    assert(close(fd) == 0);
+}
+
+static void test_optional_hud_assets(const char *root) {
+    // Exercise the production header with synthetic bytes, not proprietary SZS.
+    char synthetic[PATH_MAX], layout[PATH_MAX], paths[5][PATH_MAX], error[256];
+    assert(snprintf(synthetic, sizeof synthetic, "%s/synthetic", root) < (int)sizeof synthetic);
+    assert(snprintf(layout, sizeof layout, "%s/LayoutData", synthetic) < (int)sizeof layout);
+    make_dir(synthetic); make_dir(layout);
+    char small_hash[65], large_hash[65];
+    sha256_hex("abc", 3, small_hash);
+    const size_t large_size = 113146;
+    char *large = malloc(large_size);
+    assert(large); memset(large, 'L', large_size);
+    sha256_hex(large, large_size, large_hash);
+    dm_overlay_asset_record records[] = {
+        {"LayoutData/A.szs", 3, small_hash}, {"LayoutData/B.szs", 3, small_hash},
+        {"LayoutData/C.szs", 3, small_hash}, {"LayoutData/D.szs", 3, small_hash},
+        {"LayoutData/E.szs", 113146, large_hash},
+    };
+    for (size_t i = 0; i < 5; i++)
+        assert(dm_overlay_asset_join(paths[i], sizeof paths[i], synthetic, records[i].path));
+#define SET_OK() dm_overlay_validate_optional_set(synthetic, records, 5, 113146, error, sizeof error)
+    assert(SET_OK()); // All absent is the backwards-compatible F5 case.
+    write_fixture_file(paths[0], "abc", 3);
+    assert(!SET_OK() && strstr(error, "incomplete"));
+    for (size_t i = 1; i < 4; i++) write_fixture_file(paths[i], "abc", 3);
+    write_fixture_file(paths[4], large, large_size);
+    assert(SET_OK() && !error[0]); // Includes a real file above the old 64 KiB limit.
+    assert(!dm_overlay_validate_optional_set(synthetic, records, 5, 65536, error, sizeof error));
+    write_fixture_file(paths[0], "abd", 3);
+    assert(!SET_OK() && strstr(error, "SHA-256"));
+    write_fixture_file(paths[0], "ab", 2);
+    assert(!SET_OK() && strstr(error, "bounded regular"));
+    write_fixture_file(paths[0], "abcd", 4);
+    assert(!SET_OK());
+    write_fixture_file(paths[0], "abc", 3);
+    assert(unlink(paths[4]) == 0);
+    assert(!SET_OK() && strstr(error, "incomplete"));
+    write_fixture_file(paths[4], large, large_size);
+    assert(unlink(paths[0]) == 0);
+    assert(symlink(paths[1], paths[0]) == 0);
+    assert(!SET_OK() && strstr(error, "not a regular"));
+    assert(unlink(paths[0]) == 0);
+    assert(symlink("missing-target", paths[0]) == 0);
+    assert(!SET_OK()); // A dangling link is not an absent old-bundle asset.
+    assert(unlink(paths[0]) == 0);
+    make_dir(paths[0]); assert(!SET_OK()); assert(rmdir(paths[0]) == 0);
+    assert(mkfifo(paths[0], 0600) == 0);
+    assert(!SET_OK()); // Must not block opening a FIFO.
+    assert(unlink(paths[0]) == 0);
+    write_fixture_file(paths[0], "abc", 3);
+    dm_overlay_asset_record bad = {"../escape.szs", 3, small_hash};
+    assert(!dm_overlay_validate_optional_set(synthetic, &bad, 1, 113146, error, sizeof error));
+    bad = records[0]; bad.sha256 = "bad";
+    assert(!dm_overlay_validate_optional_set(synthetic, &bad, 1, 113146, error, sizeof error));
+    dm_overlay_asset_record duplicate[] = {records[0], records[0]};
+    assert(!dm_overlay_validate_optional_set(synthetic, duplicate, 2, 113146, error, sizeof error));
+    char long_root[PATH_MAX + 1]; memset(long_root, 'x', sizeof long_root - 1); long_root[sizeof long_root - 1] = 0;
+    assert(!dm_overlay_validate_optional_set(long_root, records, 5, 113146, error, sizeof error));
+    // fd 0 is a legitimate opened asset; preserve/restore the caller's stdin.
+    int saved_stdin = dup(STDIN_FILENO);
+    close(STDIN_FILENO);
+    assert(SET_OK());
+    if (saved_stdin >= 0) { assert(dup2(saved_stdin, STDIN_FILENO) == STDIN_FILENO); close(saved_stdin); }
+    for (size_t i = 0; i < 5; i++) assert(unlink(paths[i]) == 0);
+    assert(rmdir(layout) == 0); assert(rmdir(synthetic) == 0); free(large);
+#undef SET_OK
+
+    // Exercise the actual public validator's trusted table and profile routing.
+    // It must reject even a single one of the five known filenames; output is
+    // not published on failure. No test-only production-table override is used.
+    char profile[PATH_MAX], hud_layout[PATH_MAX], file[PATH_MAX], output[PATH_MAX];
+    assert(snprintf(profile, sizeof profile, "%s/4x3/1080p", root) < (int)sizeof profile);
+    assert(snprintf(hud_layout, sizeof hud_layout, "%s/LayoutData", profile) < (int)sizeof hud_layout);
+    make_dir(hud_layout);
+    dm_odyssey_display_config config;
+    assert(dm_odyssey_display_policy_parse("1080p", "1", &config));
+    assert(dm_odyssey_display_validate_asset(root, &config, output, sizeof output, error, sizeof error));
+    const char *names[] = {"CounterCoin", "CounterCollectCoin", "CounterLife", "CounterLifeKids", "CounterLifeUp"};
+    for (size_t i = 0; i < 5; i++) {
+        assert(snprintf(file, sizeof file, "%s/%s.szs", hud_layout, names[i]) < (int)sizeof file);
+        write_fixture_file(file, "abc", 3);
+        strcpy(output, "unpublished");
+        assert(!dm_odyssey_display_validate_asset(root, &config, output, sizeof output, error, sizeof error));
+        assert(strstr(error, "incomplete") && !strcmp(output, "unpublished"));
+        assert(unlink(file) == 0);
+    }
+    for (size_t i = 0; i < 5; i++) {
+        assert(snprintf(file, sizeof file, "%s/%s.szs", hud_layout, names[i]) < (int)sizeof file);
+        write_fixture_file(file, "abc", 3);
+    }
+    assert(!dm_odyssey_display_validate_asset(root, &config, output, sizeof output, error, sizeof error));
+    assert(strstr(error, "bounded regular")); // All names present, wrong trusted lengths.
+    // Existing initializer rejection path leaves callbacks/viewport/overlays
+    // untouched, including the original high-profile global heap restoration.
+    for (int high = 0; high <= 1; high++) {
+        pid_t child = fork(); assert(child >= 0);
+        if (!child) {
+            g_highres_profile = high;
+            dm_odyssey_display_init();
+            assert_inactive();
+            assert(g_gate_set_count == high);
+            if (high) test_memory_callback(OBS_ODYSSEY_GLOBAL_HEAP, 0, UINT32_C(0xc3000000));
+            _exit(0);
+        }
+        int status; assert(waitpid(child, &status, 0) == child);
+        assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+    }
+    // A 16:9 selected root is independent even if the 4:3 HUD set is invalid.
+    write_selected_asset(root, "16x9", "1080p", "abc");
+    assert(dm_odyssey_display_policy_parse("1080p", "0", &config));
+    assert(dm_odyssey_display_validate_asset(root, &config, output, sizeof output, error, sizeof error));
+    assert(strstr(output, "/16x9/1080p"));
+    char wide_system[PATH_MAX], wide_profile[PATH_MAX], wide_aspect[PATH_MAX];
+    assert(snprintf(wide_aspect, sizeof wide_aspect, "%s/16x9", root) < (int)sizeof wide_aspect);
+    assert(snprintf(wide_profile, sizeof wide_profile, "%s/1080p", wide_aspect) < (int)sizeof wide_profile);
+    assert(snprintf(wide_system, sizeof wide_system, "%s/SystemData", wide_profile) < (int)sizeof wide_system);
+    assert(snprintf(file, sizeof file, "%s/ProjectGraphicsQuality.szs", wide_system) < (int)sizeof file);
+    assert(unlink(file) == 0); assert(rmdir(wide_system) == 0);
+    assert(rmdir(wide_profile) == 0); assert(rmdir(wide_aspect) == 0);
+    for (size_t i = 0; i < 5; i++) {
+        assert(snprintf(file, sizeof file, "%s/%s.szs", hud_layout, names[i]) < (int)sizeof file);
+        assert(unlink(file) == 0);
+    }
+    assert(rmdir(hud_layout) == 0);
+    puts("PASS: optional HUD synthetic set validation and initializer rejection");
+}
