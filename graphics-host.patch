+    assert(SET_OK() && !error[0]); // Includes a real file above the old 64 KiB limit.
+    assert(!dm_overlay_validate_optional_set(synthetic, records, 5, 65536, error, sizeof error));
+    write_fixture_file(paths[0], "abd", 3);
+    assert(!SET_OK() && strstr(error, "SHA-256"));
+    write_fixture_file(paths[0], "ab", 2);
+    assert(!SET_OK() && strstr(error, "bounded regular"));
+    write_fixture_file(paths[0], "abcd", 4);
+    assert(!SET_OK());
+    write_fixture_file(paths[0], "abc", 3);
