+    char long_root[PATH_MAX + 1]; memset(long_root, 'x', sizeof long_root - 1); long_root[sizeof long_root - 1] = 0;
+    assert(!dm_overlay_validate_optional_set(long_root, records, 5, 113146, error, sizeof error));
