+#!/usr/bin/env python3
+"""Compile actual host segment/lifetime code; no Metal or game files required."""
+from pathlib import Path
+import argparse, json, os, re, shlex, shutil, subprocess, tempfile, zipfile
+ROOT = Path(__file__).resolve().parents[3]
+PREAMBLE = r"""
+#include <assert.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+typedef void NVNdevice;
+typedef void (*PFNNVNCOMMANDBUFFERMEMORYCALLBACKPROC)(void);
+typedef int pthread_mutex_t;
+#define PTHREAD_MUTEX_INITIALIZER 0
+#define pthread_mutex_lock(p) ((void)(p))
+#define pthread_mutex_unlock(p) ((void)(p))
+static void fixture_log(const char *fmt, ...) { (void)fmt; }
+#define LOG fixture_log
+static void die(const char *fmt, ...) { fprintf(stderr,"%s\n",fmt); exit(2); }
+static uint64_t frame;
+uint64_t dm_nvn_frame_count(void) { return ++frame; }
+"""
+TEST = r"""
+int main(int argc, char **argv) {
+    (void)argv;
+    _Static_assert(offsetof(cmd_t,nvn_flag10)==0x10,"guest inline ABI moved");
+    _Static_assert(sizeof(cmd_t)<=160,"NVN command-buffer object overflow");
+    static unsigned char controls[4][512], guest[256];
+    cmd_t a={0}, b={0};
+    if (argc>1) {
+        for (int i=0;i<2048;i++) {
+            h_nvnCommandBufferAddControlMemory(&a,controls[0],512);
+            a.recording=0;
+            a.cur=hostseg_take(&a,HOSTSEG_SMALL);a.end=a.cur+HOSTSEG_SMALL;
+            a.cur[0]=0x35;
+        }
+        printf("BASELINE segments=%d bytes=%llu\n",g_nhostseg,(unsigned long long)g_hostseg_bytes);
+        assert(g_nhostseg==1); return 0;
+    }
+    // Independent native handles remain live despite finalize/reinitialization
+    // of their command-buffer object, many frames, and reuse of another block.
+    h_nvnCommandBufferAddControlMemory(&a,controls[0],512);
+    unsigned char *first=hostseg_take(&a,HOSTSEG_SMALL);memset(first,0x35,HOSTSEG_SMALL);
+    a=(cmd_t){0};
+    h_nvnCommandBufferAddControlMemory(&b,controls[1],512);
+    b.cur=hostseg_take(&b,HOSTSEG_SMALL);b.end=b.cur+HOSTSEG_SMALL;
+    assert(b.cur!=first);memset(b.cur,0x6a,HOSTSEG_SMALL);
+    for (int i=0;i<200000;i++) {
+        h_nvnCommandBufferAddControlMemory(&b,controls[1],512);
+        b.recording=0;
+        unsigned char *next=hostseg_take(&b,HOSTSEG_SMALL);
+        assert(next==b.cur && first[0]==0x35 && first[HOSTSEG_SMALL-1]==0x35);
+        b.cur=next;b.end=next+HOSTSEG_SMALL;
+    }
+    assert(g_nhostseg==2 && g_hostseg_bytes==2*HOSTSEG_SMALL);
+    // An overlap invalidates only that native control block's handles.
+    h_nvnCommandBufferAddControlMemory(&a,controls[0]+256,128);
+    a.cur=hostseg_take(&a,HOSTSEG_SMALL);a.end=a.cur+HOSTSEG_SMALL;
+    assert(a.cur==first);
+    // Chained host-only overflows inherit the same control owner.
+    a.recording=1;a.begin=a.cur;a.cur+=32;
+    unsigned char *chain=hostseg_take(&a,HOSTSEG_SZ);
+    int ci=g_nhostseg-1;
+    assert(chain==g_hostseg[ci].mem && g_hostseg[ci].org_lo==(uintptr_t)(controls[0]+256));
+    h_nvnCommandBufferAddControlMemory(&a,controls[0]+256,128);
+    assert(!g_hostseg[ci].busy);
+    // Valid command-memory origins remain authoritative while recording.
+    cmd_t c={0};h_nvnCommandBufferAddControlMemory(&c,controls[2],512);
+    c.recording=1;c.begin=guest;c.cur=guest+32;c.end=guest+sizeof guest;
+    unsigned char *gc=hostseg_take(&c,HOSTSEG_SZ);int gi=-1;
+    for (int i=0;i<g_nhostseg;i++) if(g_hostseg[i].mem==gc) gi=i;
+    assert(gi>=0 && g_hostseg[gi].org_lo==(uintptr_t)guest && g_hostseg[gi].org_hi==(uintptr_t)(guest+48));
+    h_nvnCommandBufferAddControlMemory(&c,controls[2],512);
+    assert(g_hostseg[gi].busy);
+    hostseg_release((uintptr_t)guest+16,(uintptr_t)guest+64);
+    assert(!g_hostseg[gi].busy);
+    // Idle empty-pool grant belongs to the NEW control block, never an old host cursor.
+    h_nvnCommandBufferAddControlMemory(&b,controls[3],512);b.recording=0;
+    unsigned char *fresh=hostseg_take(&b,HOSTSEG_SMALL);int fi=-1;
+    for(int i=0;i<g_nhostseg;i++) if(g_hostseg[i].mem==fresh) fi=i;
+    assert(fi>=0 && g_hostseg[fi].org_lo==(uintptr_t)controls[3]);
+    // Unknown ownership stays conservative. No frame-based recycling.
+    cmd_t u={0};unsigned char *unknown=hostseg_take(&u,HOSTSEG_SMALL);int ui=g_nhostseg-1;
+    assert(unknown==g_hostseg[ui].mem && !g_hostseg[ui].org_lo && g_hostseg[ui].busy);
+    h_nvnCommandBufferAddControlMemory(&u,(void *)(UINTPTR_MAX-1),8);
+    assert(!u.control && !u.control_size && g_hostseg[ui].busy);
+    h_nvnCommandBufferAddControlMemory(&u,NULL,512);
