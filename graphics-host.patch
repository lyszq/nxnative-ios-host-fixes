+#!/usr/bin/env python3
+"""Exercise the actual store-decision body under Metal's legal discard contract.
+
+The encoder model invalidates discarded contents, even when the pass did not
+write them. This is a specification regression, not physical GPU evidence.
+"""
+from pathlib import Path
+import subprocess, tempfile
+ROOT=Path(__file__).resolve().parents[3]
+PRE=r'''
+#import <Foundation/Foundation.h>
+#include <assert.h>
+#include <stdint.h>
+#include <string.h>
+typedef enum { MTLStoreActionDontCare=0, MTLStoreActionStore=1 } MTLStoreAction;
+static MTLStoreAction observed_store;
+static void flw_store(MTLStoreAction action) { observed_store=action; }
+@interface Encoder:NSObject { @public MTLStoreAction action[10]; }
+-(void)setColorStoreAction:(MTLStoreAction)s atIndex:(NSUInteger)i;
+-(void)setDepthStoreAction:(MTLStoreAction)s;
+-(void)setStencilStoreAction:(MTLStoreAction)s;
+@end
+@implementation Encoder
+-(void)setColorStoreAction:(MTLStoreAction)s atIndex:(NSUInteger)i { action[i]=s; }
+-(void)setDepthStoreAction:(MTLStoreAction)s { action[8]=s; }
+-(void)setStencilStoreAction:(MTLStoreAction)s { action[9]=s; }
+@end
+static Encoder *g_enc;
+typedef struct { uint64_t serial; } tex_t;
+static struct { struct { int n; tex_t *color[8]; } rt; } R;
+static uint64_t g_sd_n_all,g_sd_n_dead,g_sd_dead_bytes,g_bw_store,g_udc_saved_bytes,g_xv_dc;
+static int lookahead,next_state,enabled;
+static int tbdr_on(void) { return lookahead; }
+static int udc_on(void) { return enabled; }
+static int sdx_decide(uint8_t st[9]) { for(int i=0;i<9;i++)st[i]=next_state;return 1; }
+static int xv_on(void) { return 0; }
+static int xv_present(uint64_t s) { (void)s;return 0; }
+static int xv_first_good(uint64_t s,uint32_t l,uint32_t a) { (void)s;(void)l;(void)a;return 0; }
+static int xv_disabled(uint64_t s) { (void)s;return 0; }
+static uint64_t xv_tag_pass(tex_t *t,uint32_t l,int i,const void *r) { (void)t;(void)l;(void)i;(void)r;return 0; }
+static int xv_trial_get(uint64_t s,int i) { (void)s;(void)i;return 0; }
+static void xv_set(uint64_t s,uint32_t l,uint32_t a,int i,uint64_t t) { (void)s;(void)l;(void)a;(void)i;(void)t; }
+enum { XV_TRIAL=3,XV_PROBE=1,XV_INVALID=2 };
+#define PD(...) ((void)0)
+'''
+TEST=r'''
+int main(void) { @autoreleasepool {
+    g_enc=[Encoder new];
+    for(enabled=0;enabled<2;enabled++) for(int load=0;load<2;load++) for(int wrote=0;wrote<2;wrote++) {
+        lookahead=0;g_nsd=3;memset(g_sd,0,sizeof g_sd);g_bw_store=24;
+        uint8_t backing[3][8],expected[3][8];
+        for(int i=0;i<3;i++) {
+            g_sd[i]=(sd_att){.ser=(uint64_t)i+1,.bytes=8,.idx=0,.depth=(uint8_t)i,.load=(uint8_t)load,.wrote=(uint8_t)wrote};
+            memset(backing[i],0x35+i,8);memcpy(expected[i],backing[i],8);
+        }
+        sd_finish();
+        MTLStoreAction actions[]={g_enc->action[0],g_enc->action[8],g_enc->action[9]};
+        for(int i=0;i<3;i++) {
+            // A conforming GPU may replace DontCare attachments with arbitrary data.
+            if(actions[i]==MTLStoreActionDontCare) memset(backing[i],0xef,8);
+            assert(!memcmp(backing[i],expected[i],8)); // next pass samples the preserved plane
+            assert(actions[i]==MTLStoreActionStore);
+        }
+        assert(g_bw_store==24 && g_udc_saved_bytes==0 && g_nsd==0);
+    }
+    // An independent next-use full-clear proof still permits dead-store removal.
+    for(int needed=0;needed<2;needed++) {
+        lookahead=1;next_state=needed?4:2;g_nsd=1;g_sd[0]=(sd_att){.bytes=8,.idx=0,.load=1};g_bw_store=8;
+        sd_finish();assert(g_enc->action[0]==(needed?MTLStoreActionStore:MTLStoreActionDontCare));
+        assert(observed_store==g_enc->action[0]);
+        assert(g_bw_store==(needed?8u:0u));
+    }
+    puts("PASS: production store decision preserves color/depth/stencil with legal discard poisoning; independent dead-store proof retained");
+} }
+'''
+def body(text):
+    declaration=text[text.index('typedef struct { uint64_t ser, bytes;'):text.index('static int g_udc_ab =')]
+    need=text[text.index('static void sd_need('):text.index('static int sdx_decide(uint8_t st[9]);')]
+    start=text.index('static void sd_finish(void) {');end=text.index('\n// Continue scanning in real replay order:',start)
+    return PRE+declaration+need+text[start:end]+TEST
+def main():
+    text=(ROOT/'dm/gfx/nvn/nvn_mtl.m').read_text(encoding='utf-8')
+    original='int dead = t->state == 2 || xvdead;'
+    assert original in text
+    negative=text.replace(original,'int dead = t->state == 2 || (udc_on() && t->load && !t->wrote) || xvdead;',1)
+    with tempfile.TemporaryDirectory(prefix='store-contract-') as td:
+        td=Path(td)
+        for name,src in [('old-decision-negative',negative),('fixed',text)]:
+            path=td/(name+'.m');exe=td/name;path.write_text(body(src),encoding='utf-8')
+            subprocess.run(['clang','-fobjc-arc','-O1','-UNDEBUG','-Wall','-Wextra','-Werror','-Wno-unused-function','-framework','Foundation',str(path),'-o',str(exe)],check=True,timeout=60)
+            result=subprocess.run([str(exe)],capture_output=True,text=True,timeout=20)
+            assert (result.returncode==0)==(name=='fixed'),result.stdout+result.stderr
+            print(name,result.returncode,result.stdout.strip(),result.stderr[-350:].strip())
+if __name__=='__main__':main()
