 // Changing the policy requires a new epoch so old prep markers cannot skip it.
-#define DM_SHELL_NVN_MSL_EPOCH @"nvn-inv1"
+#define DM_SHELL_NVN_MSL_EPOCH @"nvn-inv2-relaxed"
+
+// A compiled package may retain a matching MSL sidecar for output-type learning.
+// The ordinary loader still takes the binary; source is read only on demand.
+static inline NSString *dm_shell_nvn_source(NSString *libraryPath) {
+    NSString *sidecar = [[libraryPath stringByDeletingPathExtension] stringByAppendingPathExtension:@"metal"];
+    NSString *source = [NSString stringWithContentsOfFile:sidecar encoding:NSUTF8StringEncoding error:nil];
+    if ([source hasPrefix:@"#"]) return source;
+    source = [NSString stringWithContentsOfFile:libraryPath encoding:NSUTF8StringEncoding error:nil];
+    return [source hasPrefix:@"#"] ? source : nil;
+}
 
 static inline MTLCompileOptions *dm_shell_nvn_compile_options(void) {
     MTLCompileOptions *options = [MTLCompileOptions new];
     // [[position, invariant]] only guarantees agreement when this is enabled.
-    // Leave math and optimization defaults unchanged in this isolated fix.
     options.preserveInvariance = YES;
+    // Match ios_metal.py's -fmetal-math-mode=relaxed: translated Maxwell
+    // shaders use isnan selects, which the default fast mode may remove.
+    // The shell targets iOS 26; mathMode is public from iOS 18 / macOS 15.
+    // Keep the independent FP32 function and optimization policies at their
+    // defaults. Public optimizationLevel offers default / -Os, not -O1.
+    options.mathMode = MTLMathModeRelaxed;
     return options;
 }
 #endif
