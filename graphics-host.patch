diff --git a/dm/gfx/tools/windows_metal_run.py b/dm/gfx/tools/windows_metal_run.py
new file mode 100644
index 0000000..8eea879
--- /dev/null
+++ b/dm/gfx/tools/windows_metal_run.py
@@ -0,0 +1,92 @@
+#!/usr/bin/env python3
+"""Run the iOS-only shader chain with Apple's Windows Metal compiler.
+
+Usage: windows_metal_run.py <script.py> [args...]
+METAL_WINDOWS_BIN names the directory containing metal.exe and metallib.exe.
+METAL_MODULE_CACHE may name a workspace-local compiler module-cache directory.
+
+ios_metal.py executes the actual Windows compiler commands. This adapter only
+maps xcrun's version probes to the actual tools, reports that no platform SDK is
+used, and implements the two POSIX file/tool helpers the build invokes. It never
+copies shader source into a library or intercepts a compile's result.
+"""
+import hashlib
+import os
+from pathlib import Path
+import runpy
+import shutil
+import subprocess
+import sys
+
+_real = subprocess.run
+
+
+def tool(name):
+    directory = os.environ.get('METAL_WINDOWS_BIN')
+    if not directory:
+        raise RuntimeError('METAL_WINDOWS_BIN must name the Apple Windows Metal bin directory')
+    path = Path(directory).resolve() / (name + '.exe')
+    if not path.is_file():
+        raise FileNotFoundError(f'Apple Windows Metal tool missing: {path}')
+    return path
+
+
+def sdk_identity(sdk, build=False):
+    # These probes are opaque cache-identity strings, not a fabricated Xcode
+    # SDK version. Compiler built-in headers and the explicit AIR target are
+    # used; no macOS/iPhoneOS SDK is installed or selected by this adapter.
+    if build:
+        hashes = ' '.join(name + '=' + hashlib.sha256(tool(name).read_bytes()).hexdigest()
+                          for name in ('metal', 'metallib'))
+        return f'windows-metal-no-platform-sdk query={sdk} {hashes}\n'
+    return f'windows-metal-no-platform-sdk query={sdk} target=air64-apple-ios18.0\n'
+
+
+def completed(args, stdout, kwargs, returncode=0):
+    if not (kwargs.get('text') or kwargs.get('universal_newlines') or kwargs.get('encoding')):
+        stdout = stdout.encode(kwargs.get('encoding') or 'utf-8')
+        stderr = b''
+    else:
+        stderr = ''
+    result = subprocess.CompletedProcess(args, returncode, stdout=stdout, stderr=stderr)
+    if kwargs.get('check'):
+        result.check_returncode()
+    return result
+
+
+def run(args, *a, **kwargs):
+    if isinstance(args, (list, tuple)) and args:
+        command = [str(x) for x in args]
+        if command[0] == 'xcrun':
+            if len(command) >= 4 and command[1] == '-sdk' and command[2] in ('macosx', 'iphoneos'):
+                query = command[3:]
+                if len(query) == 2 and query[0] in ('metal', 'metallib') and query[1] == '--version':
+                    return _real([str(tool(query[0])), '--version'], *a, **kwargs)
+                if query in (['--show-sdk-version'], ['--show-sdk-build-version']):
+                    return completed(args, sdk_identity(command[2], query == ['--show-sdk-build-version']), kwargs)
+            raise RuntimeError(f'Windows Metal adapter only accepts xcrun identity probes; compile through ios_metal.py: {command!r}')
+        if command[0] == 'which' and len(command) == 2:
+            found = shutil.which(command[1])
+            return completed(args, (found + '\n') if found else '', kwargs, 0 if found else 1)
+        if command[0] == 'cp' and len(command) == 4 and command[1] == '-c':
+            shutil.copyfile(command[2], command[3])
+            return completed(args, '', kwargs)
+    return _real(args, *a, **kwargs)
+
+
+def main():
+    if len(sys.argv) < 2:
+        raise SystemExit(__doc__)
+    tool('metal'); tool('metallib')
+    targets = os.environ.setdefault('DMSH_TARGETS', 'ios')
+    if {x.strip() for x in targets.split(',') if x.strip()} != {'ios'}:
+        raise SystemExit('Windows Metal adapter requires DMSH_TARGETS=ios; macOS compilation is not supported here')
+    subprocess.run = run
+    script = os.path.abspath(sys.argv[1])
+    sys.argv = sys.argv[1:]
+    sys.path.insert(0, os.path.dirname(script))
+    runpy.run_path(script, run_name='__main__')
+
+
+if __name__ == '__main__':
+    main()
