+    n=fread(text,1,sizeof text-1,logfile); text[n]=0;
+    CHECK(strstr(text,needle)!=NULL); CHECK(fseek(logfile,0,SEEK_END)==0);
+}
+static void reset(void) { memset(envs,0,sizeof envs); writes=fail_at=0; }
