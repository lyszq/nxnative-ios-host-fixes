+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--cc", help="Compiler command, e.g. 'zig cc'")
+    ap.add_argument("--report", type=Path)
+    args = ap.parse_args()
+    command = args.cc or os.environ.get("CC")
+    if command:
+        cc = shlex.split(command, posix=os.name != "nt")
+    else:
+        compiler = next((shutil.which(n) for n in ("cc", "clang", "gcc", "zig") if shutil.which(n)), None)
+        if not compiler:
+            ap.error("No C compiler found; use --cc. No native result was obtained.")
+        cc = [compiler] + (["cc"] if Path(compiler).stem == "zig" else [])
+    results = []
+    with tempfile.TemporaryDirectory(prefix="f6-flicker-") as tmp:
+        tmp = Path(tmp)
+        source = tmp / "fixture.c"
+        source.write_text(SOURCE, encoding="utf-8")
+        env = dict(os.environ)
+        env["ZIG_LOCAL_CACHE_DIR"] = str(tmp / "zig-local")
+        env["ZIG_GLOBAL_CACHE_DIR"] = str(tmp / "zig-global")
+        if Path(cc[0]).stem.lower() == "zig":
+            # Some Windows launch environments cannot infer the installation
+            # root from the executable handle; use its existing library tree.
+            zig_exe = Path(shutil.which(cc[0]) or cc[0])
+            env.setdefault("ZIG_LIB_DIR", str(zig_exe.parent / "lib"))
+        for enabled in (0, 1):
+            for player in (0, 1):
+                exe = tmp / (f"fixture-{enabled}-{player}" + (".exe" if os.name == "nt" else ""))
+                cmd = cc + ["-std=c11", "-Wall", "-Wextra", "-Werror", "-pedantic",
+                            f"-DDM_FLICKER_DIAGNOSTICS={enabled}", f"-DDM_PLAYER_BUILD={player}",
+                            "-I", str(ROOT / "dm/ios/Sources"), str(source), "-o", str(exe)]
+                subprocess.run(cmd, check=True, env=env, timeout=120)
+                result = subprocess.run([str(exe)], check=True, capture_output=True, text=True, timeout=10)
+                print(result.stdout.strip())
+                results.append({"enabled": enabled, "player": player, "output": result.stdout.strip()})
+    if args.report:
+        args.report.write_text(json.dumps({"scope": "Real C header; synthetic environment; no iOS/GPU test",
+                                          "compiler": cc, "results": results}, indent=2) + "\n", encoding="utf-8")
+
