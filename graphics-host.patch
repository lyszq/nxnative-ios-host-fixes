@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""Run the hook language matrix against production C on any native C platform.
+
+Apple's t_language target includes the full host implementation and sanitizers.
+This runner extracts its exact language section so Windows can execute the same
+matrix without the unrelated Mach, pthread QoS and shared-font dependencies.
+"""
+from __future__ import annotations
+
+import os
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+MARKER = "// ---------- settings: language enum <-> language code ----------"
+
+
+def compiler() -> list[str]:
+    if os.environ.get("CC"):
+        return shlex.split(os.environ["CC"])
+    for name in ("clang", "gcc", "cc"):
+        if found := shutil.which(name):
+            return [found]
+    if found := shutil.which("zig"):
+        return [found, "cc"]
+    raise RuntimeError("no native C compiler; set CC or install clang/gcc/zig")
+
+
+def language_section(source: str) -> str:
+    if source.count(MARKER) != 1:
+        raise RuntimeError("production language section missing or ambiguous")
+    section = source.split(MARKER, 1)[1]
+    # This section is the file's last section. Fail if that boundary changes,
+    # rather than silently compiling only a hand-maintained model of the hooks.
+    if section.count("HLE_FORCE(") != 5 or "h_set_AvailLangN" not in section:
+        raise RuntimeError("unexpected production language section boundary")
+    return (
+        "#include <stdint.h>\n#include <stdio.h>\n#include <string.h>\n"
+        "#define HLE_FORCE(symbol, why, ret, name, ...) static ret name(__VA_ARGS__)\n"
+        + section
+    )
+
+
+def run(source: str) -> int:
+    with tempfile.TemporaryDirectory(prefix="dm-language-") as td:
+        root = Path(td)
+        (root / "language_hooks.inc").write_text(language_section(source), encoding="utf-8", newline="\n")
+        binary = root / ("language.exe" if os.name == "nt" else "language")
+        subprocess.run(
+            compiler() + ["-std=c11", "-O1", "-Wall", "-Wextra", "-Werror",
+                          "-DDM_LANGUAGE_PORTABLE", "-I", str(root),
+                          str(ROOT / "dm/host/tests/t_language.c"), "-o", str(binary)],
+            check=True,
+        )
+        return subprocess.run([str(binary)], check=False).returncode
+
+
+def main() -> int:
+    return run((ROOT / "dm/host/hle_sdk16.c").read_text(encoding="utf-8"))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
