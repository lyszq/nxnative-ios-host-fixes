+def load(name, relative):
+    spec = importlib.util.spec_from_file_location(name, ROOT / relative)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class WindowsMetalTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(prefix='windows-metal-')
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name).resolve()
+        self.bin = self.root / 'tools with spaces'
+        self.bin.mkdir()
+        (self.bin / 'metal.exe').write_bytes(b'synthetic compiler identity')
+        (self.bin / 'metallib.exe').write_bytes(b'synthetic linker identity')
+        self.env = mock.patch.dict(os.environ, {'METAL_WINDOWS_BIN': str(self.bin),
+                                  'METAL_MODULE_CACHE': str(self.root / 'module cache')})
+        self.env.start(); self.addCleanup(self.env.stop)
+
+    def test_mac_command_and_record_are_unchanged_without_override(self):
+        with mock.patch.dict(os.environ):
+            os.environ.pop('METAL_WINDOWS_BIN', None)
+            module = load('ios_metal_mac_test', 'dm/ios/tools/ios_metal.py')
+        self.assertEqual(module.METAL, ['xcrun', '-sdk', 'iphoneos', 'metal', '-c', '-O1',
+                                     '-mios-version-min=18.0', '-fmetal-math-mode=relaxed', '-fpreserve-invariance'])
+        self.assertEqual(module.RECORD, ' '.join(module.METAL) + '; ' + ' '.join(module.METALLIB))
+
+    def test_windows_compiles_with_real_commands_and_exact_record(self):
+        module = load('ios_metal_windows_test', 'dm/ios/tools/ios_metal.py')
+        self.assertEqual(module.METAL[:5], [str(self.bin / 'metal.exe'), '-target', 'air64-apple-ios18.0', '-std=ios-metal2.3', '-c'])
+        for flag in ('-O1', '-fmetal-math-mode=relaxed', '-fpreserve-invariance'):
+            self.assertIn(flag, module.METAL)
+        self.assertIn('-fmodules-cache-path=' + os.environ['METAL_MODULE_CACHE'], module.METAL)
+        self.assertEqual(module.RECORD, subprocess.list2cmdline(module.METAL) + '; ' + subprocess.list2cmdline(module.METALLIB))
+        with mock.patch.object(module.subprocess, 'run') as run:
+            module.compile('source with spaces.metal', 'test.air', 'test.metallib')
+        self.assertEqual(run.call_args_list, [mock.call([*module.METAL, 'source with spaces.metal', '-o', 'test.air'], check=True),
+                                             mock.call([*module.METALLIB, 'test.air', '-o', 'test.metallib'], check=True)])
+
+    def test_version_queries_call_actual_tool_and_preserve_errors(self):
+        adapter = load('windows_metal_probe_test', 'dm/gfx/tools/windows_metal_run.py')
+        result = subprocess.CompletedProcess(['actual metal'], 9, stdout='actual version', stderr='failure')
+        with mock.patch.object(adapter, '_real', return_value=result) as run:
+            self.assertIs(adapter.run(['xcrun', '-sdk', 'iphoneos', 'metal', '--version'], capture_output=True, text=True), result)
+        run.assert_called_once_with([str(self.bin / 'metal.exe'), '--version'], capture_output=True, text=True)
+
+    def test_sdk_probes_report_no_sdk_and_hash_real_tools(self):
+        adapter = load('windows_metal_sdk_test', 'dm/gfx/tools/windows_metal_run.py')
+        result = adapter.run(['xcrun', '-sdk', 'macosx', '--show-sdk-version'], capture_output=True, text=True)
+        self.assertIn('no-platform-sdk query=macosx', result.stdout)
+        before = adapter.sdk_identity('iphoneos', True)
+        (self.bin / 'metal.exe').write_bytes(b'another compiler')
+        self.assertNotEqual(before, adapter.sdk_identity('iphoneos', True))
+        self.assertIn('metal=', before)
+        self.assertIn('metallib=', before)
+
+    def test_adapter_cannot_turn_source_into_successful_library(self):
+        adapter = load('windows_metal_reject_test', 'dm/gfx/tools/windows_metal_run.py')
+        with self.assertRaisesRegex(RuntimeError, 'only accepts xcrun identity probes'):
+            adapter.run(['xcrun', '-sdk', 'iphoneos', 'metal', '-c', 'source.metal', '-o', 'test.air'])
+        with self.assertRaises(FileNotFoundError):
+            (self.bin / 'metallib.exe').unlink()
+            load('ios_metal_missing_test', 'dm/ios/tools/ios_metal.py')
+
+    def test_only_posix_helpers_are_emulated_and_other_commands_are_deferred(self):
+        adapter = load('windows_metal_helpers_test', 'dm/gfx/tools/windows_metal_run.py')
+        source, target = Path(self.tmp.name) / 'source', Path(self.tmp.name) / 'target'
+        source.write_bytes(b'ordinary data')
+        adapter.run(['cp', '-c', source, target], check=True)
+        self.assertEqual(target.read_bytes(), source.read_bytes())
+        with mock.patch.object(adapter.shutil, 'which', return_value=None):
+            with self.assertRaises(subprocess.CalledProcessError):
+                adapter.run(['which', 'missing'], check=True)
+        with mock.patch.object(adapter, '_real') as run:
+            adapter.run(['actual-compiler.exe', '-c', 'source'], check=True)
+        run.assert_called_once_with(['actual-compiler.exe', '-c', 'source'], check=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
