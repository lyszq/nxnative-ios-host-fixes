@@ -0,0 +1,150 @@
+#!/usr/bin/env python3
+"""Execute production argument invalidation and ended-encoder recovery in C.
+
+The fixture supplies fake encoder identities; it does not validate Metal texture
+upgrades or GPU execution. Apple CI still compiles the real API and the full host.
+"""
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import tempfile
+from pathlib import Path
+
+from run_nvn_sbw_native import _compiler, _extract_function
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def fixture() -> str:
+    source = (ROOT / "dm/gfx/nvn/nvn_mtl.m").read_text(encoding="utf-8")
+    globals_ = []
+    for pattern in (
+        r"(?m)^static uint8_t g_args_dirty\[6\][^\n]*",
+        r"(?m)^static uint64_t g_args_reg_seen[^\n]*",
+        r"(?m)^static int g_red_once\[\d+\];",
+    ):
+        found = re.search(pattern, source)
+        if not found:
+            raise RuntimeError("production resource declaration missing: " + pattern)
+        globals_.append(found.group())
+    count = int(re.search(r"static int g_red_once\[(\d+)\]", source).group(1))
+    indices = [int(i) for i in re.findall(r"\bRED_ONCE\(\s*(\d+)\s*,", source)]
+    if max(indices) >= count:
+        raise RuntimeError("production RED_ONCE index is outside its storage")
+    block = re.search(r"    if \(g_enc != en\) \{\n.*?^    \}", source, re.M | re.S)
+    if not block:
+        raise RuntimeError("production encoder recovery block is missing")
+    lod = re.search(r"d\.lodBias = (.*?);", source)
+    if not lod:
+        raise RuntimeError("production sampler LOD-bias assignment is missing")
+    signature = "if (@available(macOS 26.0, iOS 26.0, tvOS 26.0, *))"
+    if signature not in source[source.index("static id<MTLSamplerState> samp_by_id"):source.index("static inline __attribute__((always_inline)) void *samp_fast")]:
+        raise RuntimeError("the Metal 26 LOD-bias property must have an availability guard")
+    return r'''
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <math.h>
+static uint64_t g_reg_gen, g_ser_gen, dirty_gen;
+static uint64_t nvn_dirty_now(void) { return dirty_gen; }
+static int cases, failed, retries, skipped, encoded, binds, upgrades, next_encoder;
+static uintptr_t g_enc;
+static unsigned long long g_stat_pass;
+#define CHECK(label, want, got) do { uint64_t w = (want), g = (got); cases++; \
+    if (w != g) { failed++; fprintf(stderr, "%s: expected %llu got %llu\n", label, \
+        (unsigned long long)w, (unsigned long long)g); } } while (0)
+#define RED_ONCE(k, ...) do { g_red_once[k]++; skipped++; } while (0)
+#define PD(...) do { retries++; } while (0)
+typedef struct { int unused; } p_draw;
+typedef struct { int unused; } p_draw_idx;
+''' + "\n".join(globals_) + "\n" + "\n".join(
+        _extract_function(source, name) for name in ("args_dirty_all", "args_sync_dirty")
+    ) + "\nstatic float lod_bias(float value) { struct { float lod_bias; } p = {value}; return " + lod.group(1) + "; }\n" + r'''
+// Supply a new encoder and simulate argument binding ending it. The recovery
+// block itself is extracted verbatim from production draw_, including its guard.
+static void draw(const p_draw *dw, const p_draw_idx *di) {
+    if (!g_enc) g_enc = (uintptr_t)++next_encoder;
+    uintptr_t en = g_enc;
+    binds++;
+    if (upgrades) { upgrades--; g_enc = 0; }
+''' + block.group() + r'''
+    CHECK("a draw uses the current live encoder", g_enc, en);
+    encoded++;
+}
+static void clear_dirty(void) { memset(g_args_dirty, 0, sizeof g_args_dirty); }
+static void check_dirty(int want, const char *name) {
+    for (unsigned i = 0; i < sizeof g_args_dirty; i++) CHECK(name, want, g_args_dirty[i]);
+}
+static void test_generation_invalidation(void) {
+    clear_dirty(); args_sync_dirty(); check_dirty(0, "unchanged generations reuse arguments");
+    g_reg_gen++; args_sync_dirty(); check_dirty(1, "registration change invalidates all stages");
+    clear_dirty(); args_sync_dirty(); check_dirty(0, "stable registration can reuse again");
+    dirty_gen++; args_sync_dirty(); check_dirty(1, "guest write invalidates all stages");
+    clear_dirty(); args_sync_dirty(); check_dirty(0, "stable dirty generation can reuse again");
+    // The missing case: same binding/program IDs, but a replaced Metal object.
+    g_ser_gen++; args_sync_dirty(); check_dirty(1, "replacement texture invalidates all stages");
+    CHECK("serial generation is remembered", g_ser_gen, g_args_ser_seen);
+    clear_dirty(); args_sync_dirty(); check_dirty(0, "stable replacement can reuse again");
+    g_reg_gen++; g_ser_gen++; dirty_gen++;
+    args_sync_dirty(); check_dirty(1, "simultaneous generation changes invalidate");
+    clear_dirty(); args_sync_dirty(); check_dirty(0, "simultaneous changes settle to reuse");
+}
+static void test_encoder_recovery(void) {
+    p_draw dw = {0}; p_draw_idx di = {0};
+    draw(&dw, NULL);
+    CHECK("normal draw: one bind", 1, binds);
+    CHECK("normal draw: no retry", 0, retries);
+    CHECK("normal draw: emitted once", 1, encoded);
+    upgrades = 1; g_enc = 0;
+    draw(NULL, &di);
+    CHECK("one texture upgrade: rebound once", 3, binds);
+    CHECK("one texture upgrade: one retry", 1, retries);
+    CHECK("one texture upgrade: emitted once", 2, encoded);
+    CHECK("one texture upgrade: not skipped", 0, skipped);
+    upgrades = 2; g_enc = 0;
+    draw(&dw, NULL);
+    CHECK("repeated encoder end: only two attempts", 5, binds);
+    CHECK("repeated encoder end: bounded retry", 2, retries);
+    CHECK("repeated encoder end: skipped", 1, skipped);
+    CHECK("repeated encoder end: no ended draw", 2, encoded);
+    CHECK("bounded failure records its diagnostic slot", 1, g_red_once[130]);
+    upgrades = 1; g_enc = 0;
+    draw(&dw, NULL);
+    CHECK("next draw resets recovery guard", 3, retries);
+    CHECK("next draw can be emitted", 3, encoded);
+    CHECK("next draw has no additional skip", 1, skipped);
+}
+static void test_sampler_bias(void) {
+    CHECK("large negative bias clamps", 1, lod_bias(-100) == -16.0f);
+    CHECK("negative bound unchanged", 1, lod_bias(-16) == -16.0f);
+    CHECK("fractional negative bias unchanged", 1, lod_bias(-1.25f) == -1.25f);
+    CHECK("zero bias unchanged", 1, lod_bias(0) == 0.0f);
+    CHECK("fractional positive bias unchanged", 1, lod_bias(2.5f) == 2.5f);
+    CHECK("positive bound unchanged", 1, lod_bias(15.99f) == 15.99f);
+    CHECK("large positive bias clamps", 1, lod_bias(100) == 15.99f);
+}
+int main(void) {
+    test_generation_invalidation();
+    test_encoder_recovery();
+    test_sampler_bias();
+    printf("RESOURCE_REBIND_NATIVE cases=%d failed=%d\n", cases, failed);
+    return failed != 0;
+}
+'''
+
+
+def main() -> int:
+    with tempfile.TemporaryDirectory(prefix="nvn-resource-rebind-") as td:
+        path = Path(td)
+        source = path / "rebind.c"
+        binary = path / ("rebind.exe" if os.name == "nt" else "rebind")
+        source.write_text(fixture(), encoding="utf-8", newline="\n")
+        subprocess.run(_compiler() + ["-std=c11", "-O2", "-Wall", "-Wextra",
+            "-Wno-unused-variable", str(source), "-o", str(binary)], check=True)
+        return subprocess.run([str(binary)]).returncode
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
