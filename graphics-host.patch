+    put(manifest,@"[]"); assert(!dm_ios_shader_root(app,doc,&why));
+    put(manifest,@"{\"schema\":1,\"chain\":\"../../escape12\",\"resources\":2}");
+    assert(!dm_ios_shader_root(app,doc,&why));
+    put(manifest,@"{\"schema\":1,\"chain\":\"b-123456abcdef\",\"resources\":\"2\"}");
+    assert(!dm_ios_shader_root(app,doc,&why));
