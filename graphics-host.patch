diff --git a/dm/tools/tests/test_windows_metal.py b/dm/tools/tests/test_windows_metal.py
new file mode 100644
index 0000000..8512506
--- /dev/null
+++ b/dm/tools/tests/test_windows_metal.py
@@ -0,0 +1,93 @@
+"""Windows Apple Metal command/identity integration without proprietary shaders."""
+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from unittest import mock
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def load(name, relative):
+    spec = importlib.util.spec_from_file_location(name, ROOT / relative)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class WindowsMetalTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(prefix='windows-metal-')
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name).resolve()
+        self.bin = self.root / 'tools with spaces'
+        self.bin.mkdir()
+        (self.bin / 'metal.exe').write_bytes(b'synthetic compiler identity')
+        (self.bin / 'metallib.exe').write_bytes(b'synthetic linker identity')
+        self.env = mock.patch.dict(os.environ, {'METAL_WINDOWS_BIN': str(self.bin),
+                                  'METAL_MODULE_CACHE': str(self.root / 'module cache')})
+        self.env.start(); self.addCleanup(self.env.stop)
+
+    def test_mac_command_and_record_are_unchanged_without_override(self):
+        with mock.patch.dict(os.environ):
+            os.environ.pop('METAL_WINDOWS_BIN', None)
+            module = load('ios_metal_mac_test', 'dm/ios/tools/ios_metal.py')
+        self.assertEqual(module.METAL, ['xcrun', '-sdk', 'iphoneos', 'metal', '-c', '-O1',
+                                     '-mios-version-min=18.0', '-fmetal-math-mode=relaxed', '-fpreserve-invariance'])
+        self.assertEqual(module.RECORD, ' '.join(module.METAL) + '; ' + ' '.join(module.METALLIB))
+
+    def test_windows_compiles_with_real_commands_and_exact_record(self):
+        module = load('ios_metal_windows_test', 'dm/ios/tools/ios_metal.py')
+        self.assertEqual(module.METAL[:5], [str(self.bin / 'metal.exe'), '-target', 'air64-apple-ios18.0', '-std=ios-metal2.3', '-c'])
+        for flag in ('-O1', '-fmetal-math-mode=relaxed', '-fpreserve-invariance'):
+            self.assertIn(flag, module.METAL)
+        self.assertIn('-fmodules-cache-path=' + os.environ['METAL_MODULE_CACHE'], module.METAL)
+        self.assertEqual(module.RECORD, subprocess.list2cmdline(module.METAL) + '; ' + subprocess.list2cmdline(module.METALLIB))
+        with mock.patch.object(module.subprocess, 'run') as run:
+            module.compile('source with spaces.metal', 'test.air', 'test.metallib')
+        self.assertEqual(run.call_args_list, [mock.call([*module.METAL, 'source with spaces.metal', '-o', 'test.air'], check=True),
+                                             mock.call([*module.METALLIB, 'test.air', '-o', 'test.metallib'], check=True)])
+
+    def test_version_queries_call_actual_tool_and_preserve_errors(self):
+        adapter = load('windows_metal_probe_test', 'dm/gfx/tools/windows_metal_run.py')
+        result = subprocess.CompletedProcess(['actual metal'], 9, stdout='actual version', stderr='failure')
+        with mock.patch.object(adapter, '_real', return_value=result) as run:
+            self.assertIs(adapter.run(['xcrun', '-sdk', 'iphoneos', 'metal', '--version'], capture_output=True, text=True), result)
+        run.assert_called_once_with([str(self.bin / 'metal.exe'), '--version'], capture_output=True, text=True)
+
+    def test_sdk_probes_report_no_sdk_and_hash_real_tools(self):
+        adapter = load('windows_metal_sdk_test', 'dm/gfx/tools/windows_metal_run.py')
+        result = adapter.run(['xcrun', '-sdk', 'macosx', '--show-sdk-version'], capture_output=True, text=True)
+        self.assertIn('no-platform-sdk query=macosx', result.stdout)
+        before = adapter.sdk_identity('iphoneos', True)
+        (self.bin / 'metal.exe').write_bytes(b'another compiler')
+        self.assertNotEqual(before, adapter.sdk_identity('iphoneos', True))
+        self.assertIn('metal=', before)
+        self.assertIn('metallib=', before)
+
+    def test_adapter_cannot_turn_source_into_successful_library(self):
+        adapter = load('windows_metal_reject_test', 'dm/gfx/tools/windows_metal_run.py')
+        with self.assertRaisesRegex(RuntimeError, 'only accepts xcrun identity probes'):
+            adapter.run(['xcrun', '-sdk', 'iphoneos', 'metal', '-c', 'source.metal', '-o', 'test.air'])
+        with self.assertRaises(FileNotFoundError):
+            (self.bin / 'metallib.exe').unlink()
+            load('ios_metal_missing_test', 'dm/ios/tools/ios_metal.py')
+
+    def test_only_posix_helpers_are_emulated_and_other_commands_are_deferred(self):
+        adapter = load('windows_metal_helpers_test', 'dm/gfx/tools/windows_metal_run.py')
+        source, target = Path(self.tmp.name) / 'source', Path(self.tmp.name) / 'target'
+        source.write_bytes(b'ordinary data')
+        adapter.run(['cp', '-c', source, target], check=True)
+        self.assertEqual(target.read_bytes(), source.read_bytes())
+        with mock.patch.object(adapter.shutil, 'which', return_value=None):
+            with self.assertRaises(subprocess.CalledProcessError):
+                adapter.run(['which', 'missing'], check=True)
+        with mock.patch.object(adapter, '_real') as run:
+            adapter.run(['actual-compiler.exe', '-c', 'source'], check=True)
+        run.assert_called_once_with(['actual-compiler.exe', '-c', 'source'], check=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/docs/agents/04-graphics.md b/docs/agents/04-graphics.md
index 6e40b47..0a68525 100644
--- a/docs/agents/04-graphics.md
+++ b/docs/agents/04-graphics.md
@@ -83,6 +83,7 @@ What earlier titles needed beyond sections 1–5 is filed by mechanism: textures
 | `DM_NVN_BLIT_ORDER=0` | No barriers between dependent operations in the copy encoder (reproduces the fountain bug) |
 | `DM_NVN_KEYDUMP=<fs key>[:n[:every]]` | For up to n draws of that fragment shader (default 6; at most one every `every` frames), the `PASSDUMP` binding lines plus `[kd]` lines: vertex attribute formats, each vertex stream's data (all instances of per-instance streams) and every value of both stages' uniform buffers. Meant for devices: no frame number to guess; compare with the same switch on the Mac |
 | `DM_NVN_MAGSCAN=<fs key>[:every[:phase]]` | Device self-check for solid colour blocks. Every `every` frames (default 30) a compute kernel reads each render pass's colour attachments as the pass ends and logs `[mag]` lines for 16×16 blocks that hold one magenta value throughout, or non-finite pixels, naming the pass relative to the one holding that shader. Every `phase` frames (default 600) it rotates: 0 draws as usual, 1 drops that shader's draws, 2 / 3 keep its geometry with a constant grey / bright magenta fragment output. Each phase ends with a summary line, including the magenta pixel count in that shader's own pass |
+| `DM_NVN_LIGHT_PROBE=<fragment-key>:<first>:<count>` | Bounded light diagnosis (1..1200 frames): at a single-draw pass selected by its full fragment key, sample actual texture inputs r0/r4 and stored output c0 after the pass on a 16x12 grid. Logs linear RGB and spatial luma only after its GPU fence completes; no wait or rendering replacement. Aliased inputs, discarded outputs and unsupported textures skip. Readback offsets are never reused (at most 10.6 MiB). This adds a compute encoder and barriers; it may change the timing of a race. It does not detect or cure a flash by itself. The Odyssey iOS `DM_FLICKER_PROFILE=light:first:count` adapter sets its traced composite key without allowing arbitrary saved NVN switches. |
 | `DM_NVN_PREDICT=0` | No parallel precompile prediction: a pipeline miss compiles only the pipeline it needs. For telling a fault of the look-ahead from one of the pipelines ([reference](../reference/shaders.md#the-precompile-look-ahead-restores-the-scissor)) |
 | `DM_NVN_FB_SNAP=0` / `all` / `<keys>` | Which fragment shaders get the snapshot for same-pass feedback sampling (a draw sampling a colour attachment of its own render pass reads a copy taken just before it): none, every shader (slow, see BotW above), or a comma-separated key list instead of the profile's `feedback_snap` |
 | `DM_NVN_CUT=<draws>` | Commit the replay's command buffer every that many draws, between passes (default 64; 0 = one command buffer per submission, except the cut at the first pass boundary after a buffer → texture copy, which always happens: Seen in Catherine: Full Body). Growing segments (64, 128, 256 … draws) were tried for fewer commits: Breath of the Wild fell from 60 to 30 fps in the same scene (GPU idle while the long last segments were encoded), and the commits cost little once the residency set stopped churning |
diff --git a/docs/agents/symptoms.md b/docs/agents/symptoms.md
index b643b5f..38d8ec4 100644
--- a/docs/agents/symptoms.md
+++ b/docs/agents/symptoms.md
@@ -11,6 +11,8 @@ One line per symptom in the [subsystem references](../reference/): what you see
 - reducing the iPhone transfer to one image still creates thousands of resource files on the Mac, and build scanners require the expanded folder. → [Building creates a full RomFS tree before packing its image](../reference/packing.md#building-creates-a-full-romfs-tree-before-packing-its-image)
 - the NSP script stops at the shader split of a registered profile with `[RED] 13744 file(s) could not be read, their shaders are left out (first: AI/FileEntry/FileEntry.Product.100.byml.zs: CalledProcessError: Command ['zstd', '-d', '-c', '-q', '…/extract/v0/RomFS.img/AI/…'] returned non-zero exit status 1.)`. → [The zstd command given a path inside the image](../reference/packing.md#the-zstd-command-given-a-path-inside-the-image)
 - starting a Mac app through a front end with unchanged settings enables the encode thread, and can disable Metal 4 pipelines and the pipeline archive; starting the same app from Finder keeps the host's defaults. → [A Mac front end's default settings change Metal execution paths](../reference/packing.md#a-mac-front-ends-default-settings-change-metal-execution-paths)
+- a shader-heavy IPA is too large or contains too many resources for a player's sideload workflow. → [Separate iOS shader delivery](../reference/packing.md#separate-ios-shader-delivery)
+- Play waits again on every launch even though the selected pack contains compiled Metal libraries. → [Precompiled shader preparation inventory](../reference/packing.md#precompiled-shader-preparation-inventory)
 - `decompress NSZ` stops immediately with `nsz: error: unrecognized arguments: --keys …`. → [NSZ decompression rejects `--keys`](../reference/packing.md#nsz-decompression-rejects---keys)
 - the extraction of a game whose base is an XCI that also carries its update (a "1G+1U" dump) stops with `[RED] nx_extract exit code -6`. `extract_v<version>.log` lists the update's build IDs even for the base game alone, then ends in an unhandled exception from the RomFS (`ResultFsNonRealDataVerificationFailed (2002-4604): Hash error!` from `RomFsFileSystem..ctor`, or `ArgumentException` / `InvalidOperationException` from the patch layers). → [A cartridge dump with its update on it extracts the update as the base game](../reference/packing.md#a-cartridge-dump-with-its-update-on-it-extracts-the-update-as-the-base-game)
 - a build on exFAT or FAT finishes its Metal libraries, then `c1_guard.py` stops with a UTF-8 decoding error; Metal cache prefill may reject an otherwise valid folder. → [AppleDouble files are not shader build outputs](../reference/packing.md#appledouble-files-are-not-shader-build-outputs)
@@ -182,6 +184,7 @@ One line per symptom in the [subsystem references](../reference/): what you see
 - the boot sits at a black loading screen for good, CPU nearly idle, every thread waiting, about 1 boot in 6 (3 in 4 with four Mac hosts at once); the title movie is never opened, and the save files are never probed. → [Network requests stay on hold before they settle](../reference/services.md#network-requests-stay-on-hold-before-they-settle)
 - one thread at 100% CPU from boot, with one SVC in 99 s (`NexusRevolution Socket`, `main+0x92c7c4`, the game's network thread). → [Socket `Poll` and `Select` with nothing to wait on](../reference/services.md#socket-poll-and-select-with-nothing-to-wait-on)
