+#!/usr/bin/env python3
+"""Exercise the production vertex-bound arithmetic without requiring a Metal GPU.
+
+The GPU copy, ordering and pulling paths remain covered by t_vbuf and t_pull.
+"""
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+from run_nvn_sbw_native import _compiler, _extract_function
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def fixture() -> str:
+    source = (ROOT / "dm/gfx/nvn/nvn_mtl.m").read_text(encoding="utf-8")
+    obj = (ROOT / "dm/gfx/nvn/nvn_obj.h").read_text(encoding="utf-8")
+    declarations = []
+    for name in ("va_st", "vs_st", "p_draw", "p_draw_idx"):
+        found = re.search(r"(?m)^typedef struct \{[^\n]+\} " + name + r";", obj)
+        if not found:
+            raise RuntimeError("production declaration missing: " + name)
+        declarations.append(found.group())
+    functions = "\n".join(_extract_function(source, name) for name in ("vattr_bytes", "vstream_last", "vbuf_need"))
+    return r'''
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "nvn_refl.h"
+''' + "\n".join(declarations) + r'''
+static struct { va_st attr[16]; int nattr; vs_st stream[16];
+    struct { uint64_t address, size; } vbuf[16]; } S;
+static uint64_t g_vbuf_need[16];
+static int cases, failed;
+#define CHECK(label, want, got) do { uint64_t w = (want), g = (got); cases++; \
+    if (w != g) { failed++; fprintf(stderr, "%s: expected %llu got %llu\n", label, \
+        (unsigned long long)w, (unsigned long long)g); } } while (0)
+''' + functions + r'''
+int main(void) {
+    // Format widths independently specified by the NVN component classes.
+    const int widths[12] = {1,1,1,1,2,2,2,2,2,4,4,4};
+    for (int n = 1; n <= 4; n++) for (int c = 0; c < 12; c++)
+        CHECK("component format byte width", n * widths[c], vattr_bytes((n-1)*12+c+1));
+    CHECK("RGB32F", 12, vattr_bytes(0x22));
+    CHECK("packed 10:10:10:2", 4, vattr_bytes(0x3d));
+    CHECK("packed 11:11:10", 4, vattr_bytes(0x3f));
+    CHECK("BGRA8", 4, vattr_bytes(0x9a));
+    CHECK("invalid zero", 0, vattr_bytes(0));
+    CHECK("invalid high", 0, vattr_bytes(0xff));
+    nvn_refl rf = {0}; rf.nv = 1; rf.v[0].nvn = 0;
+    S.nattr = 1; S.attr[0] = (va_st){.fmt = 0x22, .stream = 0};
+    S.stream[0].stride = 12; S.vbuf[0].address = 0x1000; S.vbuf[0].size = 36;
+    p_draw dw = {.count = 9, .instances = 1};
+    vbuf_need(&rf, &dw, NULL);
+    CHECK("Odyssey: bound triangle followed by six zero vertices", 108, g_vbuf_need[0]);
+    dw.count = 3; vbuf_need(&rf, &dw, NULL);
+    CHECK("exactly in bound: no copy", 0, g_vbuf_need[0]);
+    dw.first = 2; dw.count = 2; vbuf_need(&rf, &dw, NULL);
+    CHECK("first vertex contributes to end", 48, g_vbuf_need[0]);
+    S.attr[0].offset = 4; vbuf_need(&rf, &dw, NULL);
+    CHECK("attribute offset contributes to end", 52, g_vbuf_need[0]);
+    S.attr[0].offset = 0;
+    dw.first = -1; vbuf_need(&rf, &dw, NULL);
+    CHECK("negative first is unknown", 0, g_vbuf_need[0]);
+    dw.first = 0; dw.count = 0; vbuf_need(&rf, &dw, NULL);
+    CHECK("empty vertex draw is unknown", 0, g_vbuf_need[0]);
+    dw.count = 9; dw.ind = 1; vbuf_need(&rf, &dw, NULL);
+    CHECK("indirect vertex range remains unbounded", 0, g_vbuf_need[0]);
+    dw.ind = 0; dw.mdi_cnt = 1; vbuf_need(&rf, &dw, NULL);
+    CHECK("indirect multi draw remains unbounded", 0, g_vbuf_need[0]);
+    dw.mdi_cnt = 0; S.stream[0].stride = 0; S.vbuf[0].size = 8;
+    vbuf_need(&rf, &dw, NULL);
+    CHECK("constant vertex stream needs one full element", 12, g_vbuf_need[0]);
+    S.stream[0].stride = 12; S.stream[0].divisor = 2;
+    dw.instances = 5; dw.base_instance = 3; S.vbuf[0].size = 36;
+    vbuf_need(&rf, &dw, NULL);
+    CHECK("instance divisor and base instance", 72, g_vbuf_need[0]);
+    dw.instances = 0; vbuf_need(&rf, &dw, NULL);
+    CHECK("zero instances follows host's one-instance convention", 48, g_vbuf_need[0]);
+    dw.base_instance = -1; vbuf_need(&rf, &dw, NULL);
+    CHECK("negative base instance is unknown", 0, g_vbuf_need[0]);
+    p_draw_idx di = {.count = 3, .instances = 2, .base_instance = 3};
+    vbuf_need(&rf, NULL, &di);
+    CHECK("indexed per-instance input can be bounded", 48, g_vbuf_need[0]);
+    S.stream[0].divisor = 0; vbuf_need(&rf, NULL, &di);
+    CHECK("indexed per-vertex range stays unknown", 0, g_vbuf_need[0]);
+    dw = (p_draw){.count = 9, .instances = 1};
+    S.vbuf[0].size = 0; vbuf_need(&rf, &dw, NULL);
+    CHECK("zero bound size is entirely zero padded", 108, g_vbuf_need[0]);
+    S.vbuf[0].address = 0; vbuf_need(&rf, &dw, NULL);
+    CHECK("unbound address is skipped", 0, g_vbuf_need[0]);
+    S.vbuf[0].address = 0x1000; S.attr[0].fmt = 0;
+    vbuf_need(&rf, &dw, NULL);
+    CHECK("disabled attribute is skipped", 0, g_vbuf_need[0]);
+    S.attr[0].fmt = 0x22; S.attr[0].stream = 31;
+    vbuf_need(&rf, &dw, NULL);
+    CHECK("invalid stream is skipped", 0, g_vbuf_need[0]);
+    S.attr[0].stream = 0; rf.v[0].nvn = 31;
+    vbuf_need(&rf, &dw, NULL);
+    CHECK("invalid attribute is skipped", 0, g_vbuf_need[0]);
+    rf.v[0].nvn = 0; rf.nv = 2; rf.v[1].nvn = 1; S.nattr = 2;
+    S.attr[1] = (va_st){.fmt = 0x22, .offset = 16, .stream = 0};
+    vbuf_need(&rf, &dw, NULL);
+    CHECK("multiple attributes use furthest byte in stream", 124, g_vbuf_need[0]);
+    S.attr[1].stream = 1; S.stream[1].stride = 16;
+    S.vbuf[1].address = 0x2000; S.vbuf[1].size = 16;
+    vbuf_need(&rf, &dw, NULL);
+    CHECK("first stream length independent", 108, g_vbuf_need[0]);
+    CHECK("second stream length independent", 156, g_vbuf_need[1]);
+    vbuf_need(NULL, NULL, NULL);
+    CHECK("null reflection resets stale first length", 0, g_vbuf_need[0]);
+    CHECK("null reflection resets stale second length", 0, g_vbuf_need[1]);
+    printf("VBUF_BOUNDS_NATIVE cases=%d failed=%d\n", cases, failed);
+    return failed != 0;
+}
+'''
+
+
+def main() -> int:
+    with tempfile.TemporaryDirectory(prefix="nvn-vbuf-bounds-") as td:
+        path = Path(td)
+        source = path / "bounds.c"
+        binary = path / ("bounds.exe" if os.name == "nt" else "bounds")
+        source.write_text(fixture(), encoding="utf-8", newline="\n")
+        subprocess.run(_compiler() + ["-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
+            "-I", str(ROOT / "dm/gfx/nvn"), str(source), "-o", str(binary)], check=True)
+        return subprocess.run([str(binary)]).returncode
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
