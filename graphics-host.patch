diff --git a/dm/ios/Sources/dm_shader_inventory.h b/dm/ios/Sources/dm_shader_inventory.h
new file mode 100644
--- /dev/null
+++ b/dm/ios/Sources/dm_shader_inventory.h
@@ -0,0 +1,46 @@
+// Preparation inventory only. Runtime binary loading and learning sidecars are unchanged.
+#pragma once
+#import <Foundation/Foundation.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef struct {
+    NSUInteger header_probes;
+    double listing_ms, probing_ms;
+    BOOL precompiled;
+} dm_shader_inventory_stats;
+
+static inline NSArray<NSString *> *dm_shader_inventory(NSString *root, NSString *directory,
+                                                       NSString *validatedBinaryDirectory,
+                                                       dm_shader_inventory_stats *stats) {
+    *stats = (dm_shader_inventory_stats){0};
+    NSMutableArray<NSString *> *sources = [NSMutableArray array];
+    stats->precompiled = directory && validatedBinaryDirectory &&
+                         [directory isEqualToString:validatedBinaryDirectory];
+    if (directory && !stats->precompiled) {
+        double start = NSProcessInfo.processInfo.systemUptime;
+        NSArray *names = [[NSFileManager.defaultManager contentsOfDirectoryAtPath:directory error:nil]
+                          sortedArrayUsingSelector:@selector(compare:)];
+        stats->listing_ms += (NSProcessInfo.processInfo.systemUptime - start) * 1000;
+        start = NSProcessInfo.processInfo.systemUptime;
+        for (NSString *name in names) if ([name hasSuffix:@".metallib"]) {
+            NSString *path = [directory stringByAppendingPathComponent:name];
+            stats->header_probes++;
+            FILE *file = fopen(path.fileSystemRepresentation, "rb");
+            if (!file) continue;
+            char header[4] = {0}; size_t size = fread(header, 1, sizeof header, file); fclose(file);
+            if (size == 4 && memcmp(header, "MTLB", 4)) [sources addObject:path];
+        }
+        stats->probing_ms = (NSProcessInfo.processInfo.systemUptime - start) * 1000;
+    }
+    // A binary NVN pack never bypasses independent GL/Vulkan source preparation.
+    double start = NSProcessInfo.processInfo.systemUptime;
+    for (NSString *api in @[@"gl/src", @"vk/src"]) {
+        NSString *path = [root stringByAppendingPathComponent:api];
+        for (NSString *name in [[NSFileManager.defaultManager contentsOfDirectoryAtPath:path error:nil]
+                                sortedArrayUsingSelector:@selector(compare:)])
+            if ([name hasSuffix:@".metal"]) [sources addObject:[path stringByAppendingPathComponent:name]];
+    }
+    stats->listing_ms += (NSProcessInfo.processInfo.systemUptime - start) * 1000;
+    return sources;
+}
