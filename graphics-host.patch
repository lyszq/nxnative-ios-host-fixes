+    assert(!SET_OK() && strstr(error, "incomplete"));
+    write_fixture_file(paths[4], large, large_size);
+    assert(unlink(paths[0]) == 0);
+    assert(symlink(paths[1], paths[0]) == 0);
+    assert(!SET_OK() && strstr(error, "not a regular"));
+    assert(unlink(paths[0]) == 0);
+    assert(symlink("missing-target", paths[0]) == 0);
