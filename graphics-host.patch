+"""Compile/run the actual bounded light-probe parser and linear RGB statistics.
+
+No Metal, game assets, network, or host edits. Supports cc/clang/gcc or zig cc.
+This verifies the boot adapter with a synthetic environment, not iOS rendering.
+"""
+from pathlib import Path
+import argparse
+import ast
+import platform
+import re
+import json
+import os
+import shlex
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[3]
+SOURCE = r'''
+#include <stdio.h>
+#include <stdlib.h>
+#include <math.h>
+#include "dm_light_probe.h"
+static unsigned checks;
+#define CHECK(x) do { checks++; if (!(x)) { fprintf(stderr,"line %d: %s\n",__LINE__,#x); exit(1); } } while(0)
+int main(void) {
+    dm_light_plan p, old; float v[DM_LIGHT_POINTS*4];
+    CHECK(dm_light_parse("1068aa25d67ab129_b:18000:1200",&p));
+    CHECK(p.first==18000 && p.last==19199 && !strcmp(p.key,"1068aa25d67ab129_b"));
+    CHECK(!dm_light_in_range(&p,17999) && dm_light_in_range(&p,18000) && dm_light_in_range(&p,19199) && !dm_light_in_range(&p,19200));
+    CHECK(DM_LIGHT_BYTES%256==0 && (uint64_t)DM_LIGHT_BYTES*DM_LIGHT_MAX_FRAMES<12*1024*1024);
+    old=p;
+    const char *bad[]={"", "1068aa25d67ab129_b:1:0", "1068aa25d67ab129_b:1:1201", "1068aa25d67ab129_b:-1:2", "1068aa25d67ab129_b:+1:2", "1068aa25d67ab129_b:999999999:3", "1068aa25d67ab129_b:1:1x", "1068aa25d67ab129_b:1:1:2", "1068aa25d67ab129_b:1:1\n", "1068aa25d67ab129_b:99999999999999999999:1", "../../secret:1:1", "1068aa25d67ab12g_b:1:1", "1068aa25d67ab129_a:1:1"};
+    for (unsigned i=0;i<sizeof bad/sizeof *bad;i++) { CHECK(!dm_light_parse(bad[i],&p)); CHECK(!memcmp(&p,&old,sizeof p)); }
+    CHECK(!dm_light_parse(NULL,&p) && !dm_light_parse("1068aa25d67ab129_b:1:1",NULL));
+    for(unsigned i=0;i<DM_LIGHT_POINTS*4;i++) v[i]=.25f;
+    dm_light_stats a=dm_light_measure(v),b;
+    CHECK(a.finite==DM_LIGHT_POINTS && a.bad==0 && a.rgb[0]==.25 && fabs(a.max_luma-.25)<1e-6);
+    for(unsigned i=0;i<9;i++) CHECK(a.tile_n[i] && fabs(a.tile[i]-.25)<1e-6);
+    b=dm_light_measure(v); CHECK(b.hash==a.hash);
+    // A localized flash in the central tile must survive aggregation; distant
+    // tiles remain constant. This is synthetic data, not a device flash claim.
+    for(unsigned y=4;y<8;y++) for(unsigned x=6;x<11;x++) for(unsigned c=0;c<3;c++) v[(y*16+x)*4+c]=5.f;
+    b=dm_light_measure(v); CHECK(b.hash!=a.hash && b.tile[4]>4.9 && b.rgb[0]>.25 && b.tile[0]==a.tile[0]);
+    v[0]=NAN; v[4]=INFINITY; b=dm_light_measure(v); CHECK(b.bad==2 && b.finite==190 && isfinite(b.rgb[0]));
+    for(unsigned i=0;i<DM_LIGHT_POINTS*4;i++) v[i]=NAN;
+    b=dm_light_measure(v); CHECK(b.bad==DM_LIGHT_POINTS && b.finite==0 && b.max_luma==0);
+    for(unsigned i=0;i<DM_LIGHT_POINTS*4;i++) v[i]=-2.f;
+    b=dm_light_measure(v); CHECK(b.rgb[0]==-2 && fabs(b.max_luma+2)<1e-6);
+    printf("PASS light plan / linear stats checks=%u\n",checks); return 0;
+}
+'''
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--cc", help="Compiler command, e.g. 'zig cc'")
+    ap.add_argument("--report", type=Path)
+    args = ap.parse_args()
+    command = args.cc or os.environ.get("CC")
+    if command:
+        cc = shlex.split(command, posix=os.name != "nt")
+    else:
+        compiler = next((shutil.which(n) for n in ("cc", "clang", "gcc", "zig") if shutil.which(n)), None)
+        if not compiler:
+            ap.error("No C compiler found; use --cc. No native result was obtained.")
+        cc = [compiler] + (["cc"] if Path(compiler).stem == "zig" else [])
+    results = []
+    with tempfile.TemporaryDirectory(prefix="light-probe-") as tmp:
+        tmp = Path(tmp)
+        source = tmp / "fixture.c"
+        source.write_text(SOURCE, encoding="utf-8")
+        env = dict(os.environ)
+        env["ZIG_LOCAL_CACHE_DIR"] = str(tmp / "zig-local")
+        env["ZIG_GLOBAL_CACHE_DIR"] = str(tmp / "zig-global")
+        if Path(cc[0]).stem.lower() == "zig":
+            # Some Windows launch environments cannot infer the installation
+            # root from the executable handle; use its existing library tree.
+            zig_exe = Path(shutil.which(cc[0]) or cc[0])
+            env.setdefault("ZIG_LIB_DIR", str(zig_exe.parent / "lib"))
+        exe = tmp / ("fixture" + (".exe" if os.name == "nt" else ""))
+        cmd = cc + ["-std=c11", "-Wall", "-Wextra", "-Werror", "-pedantic",
+                    "-I", str(ROOT / "dm/gfx/nvn"), str(source), "-o", str(exe)]
+        subprocess.run(cmd, check=True, env=env, timeout=120)
+        result = subprocess.run([str(exe)], check=True, capture_output=True, text=True, timeout=10)
+        print(result.stdout.strip())
+        results.append({"output": result.stdout.strip()})
+    if platform.system() == "Darwin":
+        # Compile the exact embedded kernel, not a second copy of its source.
+        text = (ROOT / "dm/gfx/nvn/nvn_light_probe.inc").read_text(encoding="utf-8")
+        body = text.split("static const char k_flw_msl[] =", 1)[1].split(";\nstatic int flw_on", 1)[0]
+        kernel = "".join(ast.literal_eval(x) for x in re.findall(r'"(?:[^"\\]|\\.)*"', body))
+        with tempfile.TemporaryDirectory(prefix="light-metal-") as td:
+            metal = Path(td) / "probe.metal"
+            metal.write_text(kernel, encoding="utf-8")
+            subprocess.run(["xcrun", "-sdk", "iphoneos", "metal", "-c", str(metal), "-o", str(Path(td)/"probe.air")], check=True, timeout=120)
+        results.append({"embedded_iphoneos_metal_kernel": "compiled; not GPU executed"})
+    if args.report:
+        args.report.write_text(json.dumps({"scope": "Real C header; synthetic environment; no iOS/GPU test",
+                                          "compiler": cc, "results": results}, indent=2) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
