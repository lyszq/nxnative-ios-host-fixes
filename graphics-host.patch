+static unsigned checks;
+#define CHECK(x) do { checks++; if (!(x)) { fprintf(stderr, "line %d: %s\n", __LINE__, #x); exit(1); } } while (0)
+typedef struct { char key[64], value[512]; int used; } entry;
+static entry envs[64];
+static int writes, fail_at;
+static const char *get(const char *k) {
+    unsigned i; for (i=0; i<64; i++) if (envs[i].used && !strcmp(envs[i].key,k)) return envs[i].value;
+    return NULL;
+}
+static int put(const char *k, const char *v, int overwrite) {
+    unsigned i, slot=64;
+    if (++writes == fail_at) { fail_at=0; return -1; }
+    for (i=0; i<64; i++) {
+        if (!envs[i].used && slot==64) slot=i;
+        if (envs[i].used && !strcmp(envs[i].key,k)) { if (!overwrite) return 0; slot=i; break; }
+    }
+    CHECK(slot<64 && strlen(k)<64 && strlen(v)<512);
+    strcpy(envs[slot].key,k); strcpy(envs[slot].value,v); envs[slot].used=1; return 0;
+}
+static int drop(const char *k) {
+    if (++writes == fail_at) { fail_at=0; return -1; }
+    unsigned i; for (i=0; i<64; i++) if (envs[i].used && !strcmp(envs[i].key,k)) memset(&envs[i],0,sizeof envs[i]);
+    return 0;
+}
+#define DM_FLICKER_GETENV get
+#define DM_FLICKER_SETENV put
+#define DM_FLICKER_UNSETENV drop
+#include "dm_flicker_diagnostics.h"
