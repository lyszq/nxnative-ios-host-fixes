+#!/usr/bin/env python3
+"""Execute actual fill and deferred-retirement bodies with a Foundation GPU model.
+
+Copies consume retained source bytes only on simulated completion. This checks
+resource lifetime and fill correctness, not Metal-driver/device performance.
+"""
+from pathlib import Path
+import argparse, subprocess, tempfile, zipfile
+ROOT = Path(__file__).resolve().parents[3]
+PRE = r'''
+#import <Foundation/Foundation.h>
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+@protocol MTLResource <NSObject> @end
+@protocol MTLBuffer <MTLResource>
+@property(readonly) void *contents;
+@end
+enum { MTLResourceStorageModeShared=0 };
+@interface Buf:NSObject<MTLBuffer> { NSMutableData *_data; }
+-(instancetype)initBytes:(const void *)bytes length:(NSUInteger)n;
+@end
+@implementation Buf
+-(instancetype)initBytes:(const void *)bytes length:(NSUInteger)n { self=[super init];if(self) _data=bytes?[NSMutableData dataWithBytes:bytes length:n]:[NSMutableData dataWithLength:n];return self; }
+-(void *)contents { return _data.mutableBytes; }
+@end
+static unsigned allocations;
+@interface Dev:NSObject
+-(id<MTLBuffer>)newBufferWithBytes:(const void *)b length:(NSUInteger)n options:(unsigned)o;
+@end
+@implementation Dev
+-(id<MTLBuffer>)newBufferWithBytes:(const void *)b length:(NSUInteger)n options:(unsigned)o { (void)o;++allocations;return [[Buf alloc]initBytes:b length:n]; }
+@end
+@interface Copy:NSObject
+@property id<MTLBuffer> src,dst;
+@property NSUInteger so,doff,n;
+@end
+@implementation Copy @end
+static Dev *g_dev; static Buf *destination;
+static NSMutableArray<Copy *> *copies;
+static NSMutableSet *g_res_objects;
+static pthread_mutex_t g_res_mu=PTHREAD_MUTEX_INITIALIZER;
+static uint64_t g_fence,g_done,g_mdx_epoch;
+static int delayed;
+static void res_add(id obj) { [g_res_objects addObject:obj]; }
+static void res_remove(id<MTLResource> obj) { [g_res_objects removeObject:obj]; }
+static void complete_copies(void) {
+    for(Copy *c in copies) { assert([g_res_objects containsObject:c.src]);memcpy((char *)c.dst.contents+c.doff,(char *)c.src.contents+c.so,c.n); }
+    [copies removeAllObjects];
+}
+@interface Enc:NSObject
+-(void)fillBuffer:(id<MTLBuffer>)b range:(NSRange)r value:(uint8_t)v;
+@end
+@implementation Enc
+-(void)fillBuffer:(id<MTLBuffer>)b range:(NSRange)r value:(uint8_t)v { memset((char *)b.contents+r.location,v,r.length); }
+@end
+static Enc *encoder;
+static void pend_add(uint64_t d,uint64_t n,int k) { (void)d;(void)n;(void)k; }
+static int mtl_addr(uint64_t d,uint64_t n,void **b,uint64_t *off) { assert(d>=0x100000 && d+n<=0x140000);*b=(__bridge void *)destination;*off=d-0x100000;return 1; }
+static Enc *blit_buf(uint64_t a,uint64_t b,uint64_t c,uint64_t d) { (void)a;(void)b;(void)c;(void)d;return encoder; }
+static void enc_b_copy_buffer(Enc *e,id<MTLBuffer>s,uint64_t so,id<MTLBuffer>d,uint64_t off,uint64_t n) {
+    (void)e;Copy *c=[Copy new];c.src=s;c.dst=d;c.so=so;c.doff=off;c.n=n;[copies addObject:c];
+    if(!delayed) complete_copies();
+}
+#define MDIE(...) abort()
+'''
+TEST = r'''
+static void check(NSUInteger off,NSUInteger n,uint32_t v) {
+    const uint8_t *bytes=(const uint8_t *)&v,*out=destination.contents;
+    for(NSUInteger i=0;i<n;i++) assert(out[off+i]==bytes[i%4]);
+}
+int main(void) { @autoreleasepool {
+    g_dev=[Dev new];encoder=[Enc new];copies=[NSMutableArray array];g_res_objects=[NSMutableSet set];
+    destination=[[Buf alloc]initBytes:NULL length:0x40000];
+    mtl_sub_fill(0x100000,0,0x12345678);assert(!allocations);
+    for(int mode=0;mode<2;mode++) { delayed=mode;
+        for(int i=0;i<3000;i++) { @autoreleasepool {
+            uint32_t a=0x12345678u+(unsigned)i*3,b=a^0x89abcdefu;
+            mtl_sub_fill(0x100000,0x10003,a);mtl_sub_fill(0x120000,37,b);
+            // Completion has not advanced: old patterns must remain resident.
+            defer_drain();assert(g_res_objects.count>=2);
+            complete_copies();check(0,0x10003,a);check(0x20000,37,b);
+            g_done=++g_fence;defer_drain();assert(g_res_objects.count==1);
+            unsigned before=allocations;mtl_sub_fill(0x130000,17,b);assert(allocations==before);
+            complete_copies();check(0x30000,17,b);
+        } }
+    }
+    unsigned before=allocations;mtl_sub_fill(0x100000,53,0xa5a5a5a5);assert(allocations==before);check(0,53,0xa5a5a5a5);
+    puts("PASS: actual fill/deferred-release bodies; 12000 pattern changes, completion-gated residency, multi-chunk and byte fills");
+} }
+'''
+def source(text):
+    deferred=text[text.index('@interface NvDeferredRelease'):text.index('static pthread_mutex_t g_bf_want_mu')]
+    fill=text[text.index('void mtl_sub_fill('):text.index('\nstatic void post(',text.index('void mtl_sub_fill('))]
+    return PRE+'\n'+deferred+'\n'+fill+'\n'+TEST
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument('--baseline',type=Path);args=ap.parse_args()
+    variants=[('fixed',(ROOT/'dm/gfx/nvn/nvn_mtl.m').read_text(encoding='utf-8'))]
+    if args.baseline:
+        with zipfile.ZipFile(args.baseline) as z: variants.insert(0,('baseline',z.read('dm/gfx/nvn/nvn_mtl.m').decode()))
+    with tempfile.TemporaryDirectory(prefix='fill-pattern-') as td:
+        td=Path(td)
+        for label,text in variants:
+            src=td/(label+'.m');exe=td/label;src.write_text(source(text),encoding='utf-8')
+            subprocess.run(['clang','-fobjc-arc','-O1','-UNDEBUG','-Wall','-Wextra','-Werror','-Wno-unused-function','-framework','Foundation',str(src),'-o',str(exe)],check=True,timeout=60)
+            p=subprocess.run([str(exe)],capture_output=True,text=True,timeout=45)
+            if label=='fixed': assert p.returncode==0,p.stdout+p.stderr
+            else: assert p.returncode!=0,'Old production code unexpectedly passed'
+            print(label,p.returncode,p.stdout.strip(),p.stderr[-700:].strip())
+if __name__=='__main__':main()
