+    const char *p = *at; uint64_t n = 0;
+    if (*p < '0' || *p > '9') return 0;
+    do { unsigned d = (unsigned)(*p++ - '0'); if (n > (1000000000ULL-d)/10) return 0; n=n*10+d; }
+    while (*p >= '0' && *p <= '9');
+    *at=p; *out=n; return 1;
+}
+// Exact key:first:count; full translated fragment key, no paths or assignments.
+static inline int dm_light_parse(const char *spec, dm_light_plan *out) {
+    dm_light_plan p = {0}; const char *q; uint64_t count; size_t n=0;
+    if (!spec || !out) return 0;
+    while (n <= 80 && spec[n]) n++;
+    if (n < 22 || n > 80) return 0;
+    for (n=0;n<16;n++) if (!((spec[n]>='0' && spec[n]<='9') || (spec[n]>='a' && spec[n]<='f'))) return 0;
+    if (memcmp(spec+16,"_b:",3)) return 0;
+    memcpy(p.key,spec,18); q=spec+19;
+    if (!dm_light_decimal(&q,&p.first) || *q++!=':' || !dm_light_decimal(&q,&count) || *q ||
+        !count || count>DM_LIGHT_MAX_FRAMES || p.first>1000000000ULL-(count-1)) return 0;
+    p.last=p.first+count-1; *out=p; return 1;
+}
+static inline int dm_light_in_range(const dm_light_plan *p, uint64_t frame) {
+    return frame>=p->first && frame<=p->last;
+}
+typedef struct { double rgb[3], tile[9], max_luma; unsigned finite, bad, tile_n[9]; uint64_t hash; } dm_light_stats;
+// RGB is linear after Metal's format decode; no display-gamma conversion/clamp.
+// A non-finite point is counted separately and never poisons the finite means.
+static inline dm_light_stats dm_light_measure(const float *rgba) {
+    dm_light_stats s = {0}; s.hash=1469598103934665603ULL; s.max_luma=-INFINITY;
+    for (unsigned i=0;i<DM_LIGHT_POINTS;i++) {
+        const float *v=rgba+4*i;
+        for (unsigned k=0;k<3;k++) { uint32_t bits; memcpy(&bits,v+k,4); s.hash=(s.hash^bits)*1099511628211ULL; }
+        if (!isfinite(v[0]) || !isfinite(v[1]) || !isfinite(v[2])) { s.bad++; continue; }
+        double y=.2126*v[0]+.7152*v[1]+.0722*v[2];
+        unsigned tile=(i/DM_LIGHT_W*3/DM_LIGHT_H)*3+(i%DM_LIGHT_W*3/DM_LIGHT_W);
+        for (unsigned k=0;k<3;k++) s.rgb[k]+=v[k];
+        s.finite++; s.tile[tile]+=y; s.tile_n[tile]++; if (y>s.max_luma) s.max_luma=y;
+    }
+    if (s.finite) for (unsigned k=0;k<3;k++) s.rgb[k]/=s.finite;
+    else s.max_luma=0;
+    for (unsigned k=0;k<9;k++) if (s.tile_n[k]) s.tile[k]/=s.tile_n[k];
+    return s;
+}
+#endif
diff --git a/dm/gfx/nvn/nvn_light_probe.inc b/dm/gfx/nvn/nvn_light_probe.inc
new file mode 100644
--- /dev/null
+++ b/dm/gfx/nvn/nvn_light_probe.inc
@@ -0,0 +1,129 @@
+// Included by nvn_mtl.m after encoder / residency helpers. Diagnostics only.
+// At a selected single-draw pass, sample its actual texture inputs r0/r4 and
+// color output 0 AFTER that pass, BEFORE later passes. Inputs must not alias
+// its output. No shader replacement, bloom suppression or CPU/GPU wait.
+#include "dm_light_probe.h"
+static int g_flw_init, g_flw_on, g_flw_failed, g_flw_draws, g_flw_match, g_flw_stored;
+static dm_light_plan g_flw_plan;
+static id<MTLTexture> g_flw_tex[3];
+static id<MTLBuffer> g_flw_buf;
+static id<MTLComputePipelineState> g_flw_ps;
+static id<MTL4ArgumentTable> g_flw_at;
+typedef struct { uint64_t frame, pass, fence; unsigned w[3], h[3]; } flw_record;
+static flw_record g_flw_rec[DM_LIGHT_MAX_FRAMES];
+static unsigned g_flw_n, g_flw_read, g_flw_skipped, g_flw_duplicate;
+static uint64_t g_flw_last = UINT64_MAX;
+static int g_flw_summary;
+static const char k_flw_msl[] =
+"#include <metal_stdlib>\nusing namespace metal;\n"
+"kernel void light_probe(texture2d<float,access::read> a [[texture(0)]],\n"
+"texture2d<float,access::read> b [[texture(1)]], texture2d<float,access::read> c [[texture(2)]],\n"
+"device float4 *out [[buffer(0)]], uint i [[thread_position_in_grid]]) {\n"
+"if(i>=192) return; uint2 p=uint2(i%16,i/16);\n"
+"uint2 x=min((p*2+1)*uint2(a.get_width(),a.get_height())/uint2(32,24),uint2(a.get_width()-1,a.get_height()-1));\n"
+"uint2 y=min((p*2+1)*uint2(b.get_width(),b.get_height())/uint2(32,24),uint2(b.get_width()-1,b.get_height()-1));\n"
+"uint2 z=min((p*2+1)*uint2(c.get_width(),c.get_height())/uint2(32,24),uint2(c.get_width()-1,c.get_height()-1));\n"
+"out[i]=a.read(x); out[192+i]=b.read(y); out[384+i]=c.read(z); }\n";
+static int flw_on(void) {
+    if (!g_flw_init) { g_flw_init=1; const char *e=getenv("DM_NVN_LIGHT_PROBE");
+        if (e && *e) {
+            if (!dm_light_parse(e,&g_flw_plan)) MLOG("[RED] light probe: rejected key:first:count (count 1..1200)");
+            else { g_flw_on=1; MLOG("[light] armed key=%s frames=%llu-%llu grid=16x12 stages=input-r0,input-r4,output-c0 max_bytes=%llu no_gpu_wait=1",
+                g_flw_plan.key,(unsigned long long)g_flw_plan.first,(unsigned long long)g_flw_plan.last,
+                (unsigned long long)((g_flw_plan.last-g_flw_plan.first+1)*DM_LIGHT_BYTES)); }
+        }
+    }
+    return g_flw_on && !g_flw_failed;
+}
+static int flw_target(const char *key, int stage) {
+    return flw_on() && stage==1 && dm_light_in_range(&g_flw_plan,atomic_load(&g_cur_frame)) && !strcmp(key,g_flw_plan.key);
+}
+static void flw_collect(void) {
+    while (g_flw_read<g_flw_n && g_flw_rec[g_flw_read].fence<=g_done) {
+        flw_record *r=&g_flw_rec[g_flw_read];
+        const float *p=(const float *)((const uint8_t *)g_flw_buf.contents+(size_t)g_flw_read*DM_LIGHT_BYTES);
+        char line[1800]; size_t off=0;
+        for (unsigned stage=0;stage<3;stage++) {
+            dm_light_stats s=dm_light_measure(p+stage*DM_LIGHT_POINTS*4);
+            off+=(size_t)snprintf(line+off,sizeof line-off," s%u=%ux%u,rgb:%g,%g,%g,max:%g,bad:%u,hash:%016llx,tiles:",
+                stage,r->w[stage],r->h[stage],s.rgb[0],s.rgb[1],s.rgb[2],s.max_luma,s.bad,(unsigned long long)s.hash);
+            for (unsigned j=0;j<9;j++) off+=(size_t)snprintf(line+off,sizeof line-off,"%s%g",j?",":"",s.tile[j]);
+        }
+        MLOG("[light] F%llu pass=%llu%s",(unsigned long long)r->frame,(unsigned long long)r->pass,line);
+        g_flw_read++;
+    }
+    if (!g_flw_summary && atomic_load(&g_cur_frame)>g_flw_plan.last && g_flw_read==g_flw_n) {
+        g_flw_summary=1; MLOG("[light] complete captured=%u expected_frames=%llu skipped=%u duplicate_passes=%u; sparse samples, not full images; no flash detection implied",
+            g_flw_n,(unsigned long long)(g_flw_plan.last-g_flw_plan.first+1),g_flw_skipped,g_flw_duplicate);
+    }
+}
+static void flw_note(id desc) {
+    if (!flw_on()) return;
+    flw_collect();
+    for (int i=0;i<3;i++) g_flw_tex[i]=nil;
+    g_flw_draws=g_flw_match=0;
+    if (!dm_light_in_range(&g_flw_plan,atomic_load(&g_cur_frame))) return;
+    MTL4RenderPassDescriptor *pd=desc;
+    g_flw_stored=pd.colorAttachments[0].storeAction==MTLStoreActionStore;
+    if (!pd.colorAttachments[0].level && !pd.colorAttachments[0].slice && !pd.colorAttachments[0].depthPlane)
+        g_flw_tex[2]=pd.colorAttachments[0].texture;
+}
+static void flw_input(const char *key,int stage,int reg,id<MTLTexture> t) {
+    if ((reg==0 || reg==4) && flw_target(key,stage)) g_flw_tex[reg==4]=t;
+}
+static void flw_store(MTLStoreAction action) { if (g_flw_on) g_flw_stored=action==MTLStoreActionStore; }
+static void flw_draw(const char *key) {
+    if (!g_flw_on || g_flw_failed) return;
+    g_flw_draws++;
+    if (flw_target(key,1)) g_flw_match=1;
+}
+static int flw_texture_ok(id<MTLTexture> t) {
+    if (!t || t.textureType!=MTLTextureType2D || t.sampleCount!=1 || !t.width || !t.height ||
+        t.storageMode==MTLStorageModeMemoryless || !(t.usage&MTLTextureUsageShaderRead)) return 0;
+    switch (t.pixelFormat) {
+        case MTLPixelFormatRG11B10Float: case MTLPixelFormatRGB10A2Unorm:
+        case MTLPixelFormatRGBA8Unorm: case MTLPixelFormatRGBA8Unorm_sRGB:
+        case MTLPixelFormatBGRA8Unorm: case MTLPixelFormatBGRA8Unorm_sRGB:
+        case MTLPixelFormatRGBA16Float: case MTLPixelFormatRGBA32Float: return 1;
+        default: return 0;
+    }
+}
+static void flw_after(void) {
+    if (!g_flw_match) return;
+    g_flw_match=0;
+    uint64_t f=atomic_load(&g_cur_frame);
+    if (g_flw_last==f) { g_flw_duplicate++; goto release; }
+    if (!g_flw_stored || g_flw_draws!=1 || !flw_texture_ok(g_flw_tex[0]) || !flw_texture_ok(g_flw_tex[1]) || !flw_texture_ok(g_flw_tex[2])) {
+        if (!g_flw_skipped++) MLOG("[light] skipped discarded output, unsupported texture or multi-draw target pass");
+        goto release;
+    }
+    for (int i=0;i<2;i++) if ((g_flw_tex[i].parentTexture ?: g_flw_tex[i])==(g_flw_tex[2].parentTexture ?: g_flw_tex[2])) {
+        if (!g_flw_skipped++) MLOG("[light] skipped target pass: input aliases output");
+        goto release;
+    }
+    if (!g_flw_ps) {
+        NSError *e=nil; id<MTLLibrary> lib=[g_dev newLibraryWithSource:@(k_flw_msl) options:nil error:&e];
+        id<MTLFunction> fn=lib ? [lib newFunctionWithName:@"light_probe"] : nil;
+        g_flw_ps=fn ? [g_dev newComputePipelineStateWithFunction:fn error:&e] : nil;
+        MTL4ArgumentTableDescriptor *ad=[MTL4ArgumentTableDescriptor new]; ad.maxTextureBindCount=3; ad.maxBufferBindCount=1;
+        g_flw_at=rec_table([g_dev newArgumentTableWithDescriptor:ad error:&e]);
+        g_flw_buf=[g_dev newBufferWithLength:(g_flw_plan.last-g_flw_plan.first+1)*DM_LIGHT_BYTES options:MTLResourceStorageModeShared];
+        if (!g_flw_ps || !g_flw_at || !g_flw_buf) {
+            g_flw_failed=1; MLOG("[RED] light probe: allocation / pipeline failed %s",e.localizedDescription.UTF8String); goto release;
+        }
+        res_add(g_flw_buf);
+    }
+    if (g_flw_n>=DM_LIGHT_MAX_FRAMES || g_flw_n>g_flw_plan.last-g_flw_plan.first) { g_flw_skipped++; goto release; }
+    if (g_blit) { enc_b_end(g_blit); g_blit=nil; }
+    { id<MTL4ComputeCommandEncoder> ce=enc_c_begin(NULL); [ce setArgumentTable:g_flw_at];
+      [g_flw_at setAddress:g_flw_buf.gpuAddress+(size_t)g_flw_n*DM_LIGHT_BYTES atIndex:0];
+      flw_record *r=&g_flw_rec[g_flw_n]; r->frame=f; r->pass=g_stat_pass; r->fence=g_fence+1;
+      for (unsigned i=0;i<3;i++) { [g_flw_at setTexture:g_flw_tex[i].gpuResourceID atIndex:i]; r->w[i]=(unsigned)g_flw_tex[i].width; r->h[i]=(unsigned)g_flw_tex[i].height; defer_obj_unref(g_flw_tex[i]); }
+      enc_c_pso(ce,g_flw_ps); enc_c_dispatch(ce,MTLSizeMake(3,1,1),MTLSizeMake(64,1,1)); enc_c_end(ce);
+      args_dirty_all(); g_flw_n++; g_flw_last=f;
+    }
+release:
+    // Buffer offsets are never reused. Extra references above keep every
+    // sampled view alive through the same submission's completion fence.
+    for (int i=0;i<3;i++) g_flw_tex[i]=nil;
+}
diff --git a/dm/host/dm_odyssey_ui.h b/dm/host/dm_odyssey_ui.h
new file mode 100644
--- /dev/null
+++ b/dm/host/dm_odyssey_ui.h
@@ -0,0 +1,228 @@
+// Exact Odyssey 1.4.1 primary-layout adapter. Included by hle_odyssey_display.c.
+// No guest executable, shader, animation or serialized layout is changed.
+typedef void (*od_ui_calc_fn)(void *, void *, int);
+typedef void (*od_ui_draw_fn)(void *, void *, void *);
+typedef void (*od_ui_stage_fn)(void *);
+static od_ui_calc_fn od_ui_calc_original;
+static od_ui_draw_fn od_ui_draw_original;
+static od_ui_stage_fn od_ui_stage_original;
+static uintptr_t od_ui_base;
+static int od_ui_enabled;
+static _Atomic unsigned od_ui_seen;
+static _Atomic int od_ui_menu = 1;
+static _Atomic float od_ui_visual_aspect = 16.0f/9.0f;
+static atomic_flag od_ui_transition_lock = ATOMIC_FLAG_INIT;
+typedef struct { float from, to; uint64_t began; } od_ui_transition;
+static od_ui_transition od_ui_motion = {16.0f/9.0f,16.0f/9.0f,0};
+#define OD_UI_TRANSITION_NS UINT64_C(220000000)
+static float od_ui_transition_sample(const od_ui_transition *t, uint64_t now) {
+    if (t->from == t->to) return t->to;
+    if (now <= t->began) return t->from;
+    uint64_t elapsed = now - t->began;
+    if (elapsed >= OD_UI_TRANSITION_NS) return t->to;
+    double x = (double)elapsed / OD_UI_TRANSITION_NS;
+    double eased = x*x*x*(x*(x*6-15)+10); // zero speed and acceleration at both ends
+    return (float)(t->from + (t->to-t->from)*eased);
+}
+static float od_ui_transition_advance(od_ui_transition *t, float target, uint64_t now) {
+    float value = od_ui_transition_sample(t,now);
+    if (target != t->to) *t = (od_ui_transition){value,target,now};
+    return value;
+}
+static _Thread_local unsigned od_ui_depth;
+enum { OD_UI_STAGE = 1, OD_UI_MENU = 2, OD_UI_PANES = 512, OD_UI_EDITS = 16 };
+
+static uintptr_t od_ui_ptr(const void *p, size_t n) { uintptr_t v; memcpy(&v, (const char *)p+n, sizeof v); return v; }
+static float od_ui_float(const void *p, size_t n) { float v; memcpy(&v, (const char *)p+n, sizeof v); return v; }
+static int od_ui_aligned(const void *p) { return p && !((uintptr_t)p & 7); }
+static int od_ui_name(const void *p, const char *name) {
+    const char *s = (const char *)p + 0xb8, *end = memchr(s, 0, 25);
+    return end && (size_t)(end-s) == strlen(name) && !memcmp(s, name, (size_t)(end-s));
+}
+static int od_ui_owner(void *layout, char name[64], uint8_t **root) {
+    if (!od_ui_aligned(layout) || od_ui_ptr(layout, 0) != od_ui_base+0x135d2c8) return 0;
+    void *screen = (void *)od_ui_ptr(layout, 0x88);
+    if (!od_ui_aligned(screen) || od_ui_ptr(screen, 0) != od_ui_base+0x12ed3e8 ||
+        od_ui_ptr(screen, 0x30) != (uintptr_t)layout) return 0;
+    const char *s = (const char *)od_ui_ptr(screen, 0xb8);
+    if (!s) return 0;
+    unsigned i;
+    for (i=0; i<63 && s[i]; i++) {
+        unsigned char c = s[i];
+        if (!((c>='a' && c<='z') || (c>='A' && c<='Z') ||
+              (c>='0' && c<='9') || c=='_')) return 0;
+        name[i] = c;
+    }
+    if (!i || s[i]) return 0;
+    name[i] = 0;
+    *root = (uint8_t *)od_ui_ptr(layout, 0x18);
+    if (!od_ui_aligned(*root) || od_ui_ptr(*root, 0x18) || !od_ui_name(*root,"RootPane") ||
+        (od_ui_ptr(*root,0) != od_ui_base+0x132b248 && od_ui_ptr(*root,0) != od_ui_base+0x135edc8)) return 0;
+    return 1;
+}
+static int od_ui_full_menu(const char *name) {
+    // These are full-screen owners, not the always-visible PlayGuideMenu HUD.
+    static const char *const names[] = {"Menu", "MiniGameMenu", "ModeSelect", "Title",
+        "TitleLogo", "TitleMenu", "Map", "MapMain", "MapWorld", "WorldMap",
+        "OptionConfig", "OptionData", "OptionLanguage", "OptionMode", "OptionProcess",
+        "OptionSelect", "Closet", "ClosetHead", "ClosetBody", "Shop", "ShopBG", "RankList"};
+    for (unsigned i=0; i<sizeof names/sizeof *names; i++) if (!strcmp(name,names[i])) return 1;
+    return 0;
+}
+static float od_ui_aspect(void) {
+    return od_ui_enabled ? atomic_load_explicit(&od_ui_visual_aspect,memory_order_acquire) :
+        dm_odyssey_display_aspect();
+}
+// The returned aspect belongs to the image just recorded. Classify the next
+// frame only afterwards; camera, layout and queued presentation share a latch.
+float dm_odyssey_display_present_aspect(void) {
+    if (!od_ui_enabled) return 0;
+    while (atomic_flag_test_and_set_explicit(&od_ui_transition_lock,memory_order_acquire)) { }
+    float aspect = od_ui_aspect();
+    unsigned seen = atomic_exchange_explicit(&od_ui_seen,0,memory_order_acq_rel);
+    int menu = (seen & OD_UI_MENU) || !(seen & OD_UI_STAGE);
+    int previous = atomic_exchange_explicit(&od_ui_menu,menu,memory_order_acq_rel);
+    float target = menu ? 16.0f/9.0f : dm_odyssey_display_aspect();
+    float next = od_ui_transition_advance(&od_ui_motion,target,now_ns());
+    atomic_store_explicit(&od_ui_visual_aspect,next,memory_order_release);
+    atomic_flag_clear_explicit(&od_ui_transition_lock,memory_order_release);
+    if (previous != menu) LOG("Odyssey UI composition: %s (next frame)", menu ? "16:9 menu" : "4:3 gameplay");
+    return aspect;
+}
+typedef struct { uint8_t *pane; unsigned offset; float before, after; } od_ui_edit;
+typedef struct {
+    uint8_t *panes[OD_UI_PANES]; unsigned char primary[OD_UI_PANES]; unsigned count;
+    od_ui_edit edits[OD_UI_EDITS]; unsigned edits_n;
+} od_ui_plan;
+static int od_ui_pane_valid(uint8_t *p) {
+    if (!od_ui_aligned(p) || !memchr(p+0xb8,0,25)) return 0;
+    for (unsigned off=0x30; off<=0x54; off+=4) {
+        float x=od_ui_float(p,off); if (!isfinite(x) || fabsf(x)>10000000) return 0;
+    }
+    return 1;
+}
+static int od_ui_tree(od_ui_plan *p, uint8_t *root) {
+    p->panes[p->count++]=root; p->primary[0]=1;
+    for (unsigned i=0; i<p->count; i++) {
+        uint8_t *parent=p->panes[i]; if (!od_ui_pane_valid(parent)) return 0;
+        uintptr_t sentinel=(uintptr_t)parent+0x20, node=od_ui_ptr(parent,0x28);
+        while (node!=sentinel) {
+            if (node<8 || (node&7) || p->count==OD_UI_PANES) return 0;
+            uint8_t *child=(uint8_t *)(node-8);
+            for (unsigned j=0; j<p->count; j++) if (p->panes[j]==child) return 0;
+            if (!od_ui_pane_valid(child) || od_ui_ptr(child,0x18)!=(uintptr_t)parent) return 0;
+            uintptr_t vt=od_ui_ptr(parent,0);
+            p->primary[p->count]=p->primary[i] && vt!=od_ui_base+0x1350278 && vt!=od_ui_base+0x135d1c8;
+            p->panes[p->count++]=child; node=od_ui_ptr(child,0x10);
+        }
+    }
+    return 1;
+}
+static uint8_t *od_ui_find(od_ui_plan *p, const char *name) {
+    uint8_t *found=NULL;
+    for (unsigned i=0;i<p->count;i++) if (p->primary[i] && od_ui_name(p->panes[i],name)) {
+        if (found) return NULL; found=p->panes[i];
+    }
+    return found;
+}
+static int od_ui_add(od_ui_plan *p, uint8_t *pane, unsigned off, float value) {
+    if (p->edits_n==OD_UI_EDITS || !isfinite(value) || fabsf(value)>100000) return 0;
+    p->edits[p->edits_n++]=(od_ui_edit){pane,off,od_ui_float(pane,off),value}; return 1;
+}
+static int od_ui_make(void *layout, od_ui_plan *p) {
+    char owner[64]; uint8_t *root;
+    if (!od_ui_owner(layout,owner,&root)) return 0;
+    static const char *const skip[]={"FooterParts","MapFooter","MapBG","FadeBlack","FadeWhite","CommonBgParts"};
+    for (unsigned i=0;i<sizeof skip/sizeof *skip;i++) if (!strcmp(owner,skip[i])) return 0;
+    float factor=od_ui_aspect()*9.0f/16.0f;
+    if (factor>=.99999f || factor<.5f) return 0;
+    if (od_ui_float(root,0x50)!=1280 || od_ui_float(root,0x54)!=720 ||
+        od_ui_float(root,0x3c)!=0 || od_ui_float(root,0x40)!=0 || od_ui_float(root,0x44)!=0 ||
+        od_ui_float(root,0x48)<.01f || od_ui_float(root,0x48)>8 ||
+        od_ui_float(root,0x4c)<.01f || od_ui_float(root,0x4c)>8 || !od_ui_tree(p,root)) return 0;
+    if (!od_ui_add(p,root,0x4c,od_ui_float(root,0x4c)*factor)) return 0;
+    static const struct { const char *owner,*anchor; int sign; } edges[]={
+        {"CounterCoin","All",1},{"CounterCollectCoin","All",1},
+        {"CounterLife","All",1},{"CounterLifeKids","All",1},{"CounterLifeUp","All",1},
+        {"CounterShine","All",1},{"MapMini","All",1},{"PlayGuideMenu","PicCaptureUse",1},
+        {"PlayGuideCamera","All",1},{"PlayGuideSkip","PicCaptureUse",1},
+        {"SaveMessage","All",-1},{"KidsMode","All",-1},{"PlayGuide","PicBase",-1},
+        {"PlayGuideMap","TxtGuide",-1},{"PlayGuideBgm","PicSh",-1},{"TalkMessage","PicBase",-1}};
+    for (unsigned i=0;i<sizeof edges/sizeof *edges;i++) if (!strcmp(owner,edges[i].owner)) {
+        if (!od_ui_find(p,edges[i].anchor)) return 0;
+        if (!od_ui_add(p,root,0x34,od_ui_float(root,0x34)+edges[i].sign*360*(1-factor))) return 0;
+    }
+    // Preserve full-screen capture/fade surfaces while correcting their text.
+    static const char *const fills[]={"PicCaptureUse","PicCaptureUse00","PicCaptureUse01",
+        "PicBG00","PicBG01","PicFade"};
+    for (unsigned i=0;i<sizeof fills/sizeof *fills;i++) {
+        uint8_t *pane=od_ui_find(p,fills[i]); if (!pane) continue;
+        if (od_ui_float(pane,0x50)==1280 && od_ui_float(pane,0x54)==720 &&
+            od_ui_float(pane,0x30)==0 && od_ui_float(pane,0x34)==0 &&
+            od_ui_float(pane,0x3c)==0 && od_ui_float(pane,0x40)==0 && od_ui_float(pane,0x44)==0 &&
+            !od_ui_add(p,pane,0x4c,od_ui_float(pane,0x4c)/factor)) return 0;
+    }
+    return 1;
+}
+static void od_ui_apply(od_ui_plan *p, int restore) {
+    for (unsigned i=0;i<p->edits_n;i++) {
+        od_ui_edit *e=&p->edits[i]; float v=restore?e->before:e->after;
+        memcpy(e->pane+e->offset,&v,4); e->pane[0x58]|=0x10;
+    }
+}
+static void od_ui_calc(void *layout, void *info, int recursive) {
+    if (od_ui_depth++) { od_ui_calc_original(layout,info,recursive); --od_ui_depth; return; }
+    od_ui_plan plan={0}; int ok=od_ui_make(layout,&plan);
+    if (ok) od_ui_apply(&plan,0);
+    od_ui_calc_original(layout,info,recursive);
+    if (ok) od_ui_apply(&plan,1);
+    --od_ui_depth;
+}
+static void od_ui_draw(void *layout, void *info, void *cmd) {
+    char owner[64]; uint8_t *root;
+    if (od_ui_owner(layout,owner,&root) && (root[0x58]&0x81)==0x81 && od_ui_full_menu(owner))
+        atomic_fetch_or_explicit(&od_ui_seen,OD_UI_MENU,memory_order_relaxed);
+    od_ui_draw_original(layout,info,cmd);
+}
+static void od_ui_stage(void *stage) {
+    atomic_fetch_or_explicit(&od_ui_seen,OD_UI_STAGE,memory_order_relaxed);
+    od_ui_stage_original(stage);
+}
+static int od_ui_install(const char *profile_root) {
+    module_t *m=NULL;
+    for (int i=0;i<g_nmod;i++) if (!strcmp(g_mod[i].name,"main")) { m=&g_mod[i]; break; }
+    if (!m || !m->base || m->size<0x135ee70 || strcmp(m->build_id,DM_ODYSSEY_MAIN_BUILD)) return 0;
+    // Refuse old serialized compensation rather than applying it twice.
+    const char *const old[]={"Menu","CounterCoin","CounterCollectCoin","CounterLife","CounterLifeKids","CounterLifeUp"};
+    for (unsigned i=0;i<sizeof old/sizeof *old;i++) {
+        char path[PATH_MAX]; int n=snprintf(path,sizeof path,"%s/LayoutData/%s.szs",profile_root,old[i]);
+        if (n<0 || (size_t)n>=sizeof path || access(path,F_OK)==0) return 0;
+    }
+    uint8_t *b=m->base; uintptr_t base=(uintptr_t)b;
+    static const struct { unsigned slot, target; } slots[]={
+        {0x135d358,0xa19b00},{0x135d328,0x903d60},{0x12c4e08,0x473270},
+        {0x132b2e0,0x909494},{0x135ee60,0x909494}};
+    for (unsigned i=0;i<sizeof slots/sizeof *slots;i++)
+        if (od_ui_ptr(b,slots[i].slot)!=base+slots[i].target) return 0;
+    if (memcmp(b+0xf97484,"N3eui8LayoutExE",15) || memcmp(b+0xf0e634,"N2al9EuiScreenE",15) ||
+        od_ui_ptr(b,0x12c4dc0)!=base+0x12c4e80 ||
+        od_ui_ptr(b,0x12c4e88)!=base+0xef742c || memcmp(b+0xef742c,"10StageScene",13)) return 0;
+    static const struct { unsigned at; uint32_t word; } words[]={
+        {0xa19b00,0xf9400c08},{0xa19b44,0xf9006275},{0xa19b50,0xf9404d08},
+        {0x903d60,0xf81d0ff5},{0x903da4,0xf9400ea0},{0x903dac,0xf9405108},
+        {0x909b44,0x0a090109},{0xa1cbfc,0xf9400288},
+        {0x473270,0xfc190fe8}};
+    for (unsigned i=0;i<sizeof words/sizeof *words;i++) {
+        uint32_t word; memcpy(&word,b+words[i].at,4); if (word!=words[i].word) return 0;
+    }
+    od_ui_base=base;
+    od_ui_calc_original=(od_ui_calc_fn)(b+0xa19b00);
+    od_ui_draw_original=(od_ui_draw_fn)(b+0x903d60);
+    od_ui_stage_original=(od_ui_stage_fn)(b+0x473270);
+    *(od_ui_calc_fn *)(b+0x135d358)=od_ui_calc;
+    *(od_ui_draw_fn *)(b+0x135d328)=od_ui_draw;
+    *(od_ui_stage_fn *)(b+0x12c4e08)=od_ui_stage;
+    od_ui_enabled=1;
+    LOG("Odyssey UI adapter enabled: runtime proportions at all presets; 16:9 menus / 4:3 gameplay; one-frame classification latch");
+    return 1;
+}
diff --git a/dm/host/dm_overlay_assets.h b/dm/host/dm_overlay_assets.h
new file mode 100644
--- /dev/null
+++ b/dm/host/dm_overlay_assets.h
@@ -0,0 +1,143 @@
+#ifndef DM_OVERLAY_ASSETS_H
+#define DM_OVERLAY_ASSETS_H
+
+// Optional, all-or-nothing asset sets. Records are trusted caller data, never
+// paths or hashes read from an untrusted overlay's own manifest.
+#include <CommonCrypto/CommonDigest.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+typedef struct {
+    const char *path;
+    uint32_t bytes;
+    const char *sha256;
+} dm_overlay_asset_record;
+
+static inline int dm_overlay_asset_fail(char *error, size_t size, const char *message) {
+    if (error && size) snprintf(error, size, "%s", message);
+    return 0;
+}
+
+static inline int dm_overlay_asset_path_ok(const char *path) {
+    if (!path || !*path || *path == '/' || strchr(path, '\\') || strchr(path, ':')) return 0;
+    const char *part = path;
+    for (const char *p = path;; p++) {
+        if (*p && *p != '/') continue;
+        size_t n = (size_t)(p - part);
+        if (!n || (n == 1 && part[0] == '.') || (n == 2 && part[0] == '.' && part[1] == '.')) return 0;
+        if (!*p) return 1;
+        part = p + 1;
+    }
+}
+
+static inline int dm_overlay_asset_hash_ok(const char *hash) {
+    if (!hash || strlen(hash) != 64) return 0;
+    for (const char *p = hash; *p; p++)
+        if (!((*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f'))) return 0;
+    return 1;
+}
+
+static inline int dm_overlay_asset_join(char *out, size_t size, const char *root, const char *relative) {
+    int n = snprintf(out, size, "%s/%s", root, relative);
+    return n >= 0 && (size_t)n < size;
+}
+
+static inline int dm_overlay_asset_hash_file(const char *path,
+        const dm_overlay_asset_record *record, uint32_t max_bytes, char *error, size_t error_size) {
+    int flags = O_RDONLY | O_NONBLOCK;
+#ifdef O_CLOEXEC
+    flags |= O_CLOEXEC;
+#endif
+#ifdef O_NOFOLLOW
+    flags |= O_NOFOLLOW;
+#endif
+    int fd = open(path, flags);
+    if (fd < 0) return dm_overlay_asset_fail(error, error_size, "cannot open optional overlay asset");
+    struct stat st;
+    if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size < 0 ||
+        (uint64_t)st.st_size > max_bytes || (uint64_t)st.st_size != record->bytes) {
+        close(fd);
+        return dm_overlay_asset_fail(error, error_size, "optional overlay asset is not an exact bounded regular file");
+    }
+    // Heap allocation keeps the larger asset bound off the guest's small stack.
+    uint8_t *bytes = malloc(record->bytes);
+    if (!bytes) {
+        close(fd);
+        return dm_overlay_asset_fail(error, error_size, "cannot allocate optional overlay asset buffer");
+    }
+    size_t used = 0;
+    while (used < record->bytes) {
+        ssize_t n = read(fd, bytes + used, record->bytes - used);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) break;
+        used += (size_t)n;
+    }
+    uint8_t extra;
+    ssize_t tail;
+    do { tail = read(fd, &extra, 1); } while (tail < 0 && errno == EINTR);
+    close(fd);
+    if (used != record->bytes || tail != 0) {
+        free(bytes);
+        return dm_overlay_asset_fail(error, error_size, "cannot read exact optional overlay asset length");
+    }
+    uint8_t digest[CC_SHA256_DIGEST_LENGTH];
+    int hashed = CC_SHA256(bytes, (CC_LONG)record->bytes, digest) != NULL;
+    free(bytes);
+    if (!hashed) return dm_overlay_asset_fail(error, error_size, "cannot hash optional overlay asset");
+    char actual[65];
+    static const char hex[] = "0123456789abcdef";
+    for (size_t i = 0; i < sizeof digest; i++) {
+        actual[2 * i] = hex[digest[i] >> 4];
+        actual[2 * i + 1] = hex[digest[i] & 15];
+    }
+    actual[64] = 0;
+    if (strcmp(actual, record->sha256))
+        return dm_overlay_asset_fail(error, error_size, "optional overlay asset SHA-256 mismatch");
+    return 1;
+}
+
+static inline int dm_overlay_validate_optional_set(const char *root,
+        const dm_overlay_asset_record *records, size_t count, uint32_t max_bytes,
+        char *error, size_t error_size) {
+    if (error && error_size) error[0] = 0;
+    if (!root || !*root || !records || !count || count > 64 || !max_bytes || max_bytes > 16u * 1024u * 1024u)
+        return dm_overlay_asset_fail(error, error_size, "invalid optional overlay set request");
+    char path[PATH_MAX];
+    size_t present = 0;
+    for (size_t i = 0; i < count; i++) {
+        const dm_overlay_asset_record *r = &records[i];
+        if (!dm_overlay_asset_path_ok(r->path) || !r->bytes || r->bytes > max_bytes || !dm_overlay_asset_hash_ok(r->sha256))
+            return dm_overlay_asset_fail(error, error_size, "invalid trusted optional overlay record");
+        for (size_t j = 0; j < i; j++)
+            if (!strcmp(r->path, records[j].path))
+                return dm_overlay_asset_fail(error, error_size, "duplicate optional overlay record");
+        if (!dm_overlay_asset_join(path, sizeof path, root, r->path))
+            return dm_overlay_asset_fail(error, error_size, "optional overlay asset path is too long");
+        struct stat st;
+        if (!lstat(path, &st)) {
+            // lstat counts a dangling link as present, then rejects it. Neither
+            // FIFO/device opens nor symlink targets are read in this pass.
+            if (!S_ISREG(st.st_mode))
+                return dm_overlay_asset_fail(error, error_size, "optional overlay asset is not a regular file");
+            present++;
+        } else if (errno != ENOENT) {
+            return dm_overlay_asset_fail(error, error_size, "cannot inspect optional overlay asset");
+        }
+    }
+    if (!present) return 1; // Old bundles intentionally have none of the set.
+    if (present != count) return dm_overlay_asset_fail(error, error_size, "optional overlay asset set is incomplete");
+    for (size_t i = 0; i < count; i++) {
+        if (!dm_overlay_asset_join(path, sizeof path, root, records[i].path) ||
+            !dm_overlay_asset_hash_file(path, &records[i], max_bytes, error, error_size)) return 0;
+    }
+    return 1;
+}
+
+#endif
diff --git a/dm/ios/Sources/dm_external_shaders.h b/dm/ios/Sources/dm_external_shaders.h
new file mode 100644
--- /dev/null
+++ b/dm/ios/Sources/dm_external_shaders.h
@@ -0,0 +1,85 @@
+// Separate shader delivery: opt in with a bundled manifest, keep saves and old packs intact.
+#pragma once
+#import <Foundation/Foundation.h>
+#include <stdio.h>
+
+// Outputs are process-owned evidence, never an environment-file opt-in. Schema 1's
+// bundled metallibs/fragment_sources counts describe binaries plus learning
+// sidecars. Older manifests without these fields retain header probing.
+static inline NSString *dm_ios_shader_root_checked(NSString *bundle, NSString *documents, NSString **reason,
+                                                  NSString **selected, NSString **precompiled) {
+    if (selected) *selected = nil;
+    if (precompiled) *precompiled = nil;
+    if (reason) *reason = nil;
+    NSFileManager *fm = NSFileManager.defaultManager;
+    NSString *bundled = [bundle stringByAppendingPathComponent:@"msl"];
+    NSString *manifest = [bundle stringByAppendingPathComponent:@"dm/external-shaders.json"];
+    if (![fm fileExistsAtPath:manifest]) return bundled;
+    NSData *expected = [NSData dataWithContentsOfFile:manifest];
+    id value = expected ? [NSJSONSerialization JSONObjectWithData:expected options:0 error:nil] : nil;
+    NSDictionary *meta = [value isKindOfClass:NSDictionary.class] ? value : nil;
+    id chainValue = meta[@"chain"];
+    NSString *chain = [chainValue isKindOfClass:NSString.class] ? chainValue : nil;
+    BOOL validChain = chain.length == 14 && [chain hasPrefix:@"b-"] &&
+        [[chain substringFromIndex:2] rangeOfCharacterFromSet:
+         [NSCharacterSet characterSetWithCharactersInString:@"0123456789abcdef"].invertedSet].location == NSNotFound;
+    id count = meta[@"resources"];
+    if (![meta[@"schema"] isEqual:@1] || !validChain || ![count isKindOfClass:NSNumber.class] || [count unsignedIntegerValue] == 0) {
+        if (reason) *reason = @"The app's shader delivery information is invalid. Install the matching IPA again.";
+        return nil;
+    }
+    NSString *root = [documents stringByAppendingPathComponent:@"msl"];
+    [fm createDirectoryAtPath:root withIntermediateDirectories:YES attributes:nil error:nil];
+    NSData *installed = [NSData dataWithContentsOfFile:[root stringByAppendingPathComponent:@"pack.json"]];
+    NSString *directory = [root stringByAppendingPathComponent:chain];
+    NSData *wantedStamp = [NSData dataWithContentsOfFile:[[bundled stringByAppendingPathComponent:chain] stringByAppendingPathComponent:@"inputs.tsv"]];
+    NSData *actualStamp = [NSData dataWithContentsOfFile:[directory stringByAppendingPathComponent:@"inputs.tsv"]];
+    if (!installed || ![installed isEqualToData:expected] || !wantedStamp || ![wantedStamp isEqualToData:actualStamp]) {
+        if (reason) *reason = @"Shaders are missing or belong to another version. Unzip the matching shader ZIP in Files and move its msl folder into this app under On My iPad. Then fully close and reopen the app. Keep your save and romfs.img.";
+        return nil;
+    }
+    // One directory listing, no per-file hash/CRC scan. This catches an interrupted copy.
+    double listingStart = NSProcessInfo.processInfo.systemUptime;
+    NSArray<NSString *> *names = [fm contentsOfDirectoryAtPath:directory error:nil];
+    if (names.count != [count unsignedIntegerValue]) {
+        if (reason) *reason = @"The shader folder is incomplete. Finish copying the matching msl folder in Files, then fully close and reopen the app.";
+        return nil;
+    }
+    double inventoryStart = NSProcessInfo.processInfo.systemUptime;
+    id libraries = meta[@"metallibs"], fragments = meta[@"fragment_sources"];
+    BOOL declaredCompiled = libraries != nil || fragments != nil;
+    BOOL compiled = [libraries isKindOfClass:NSNumber.class] &&
+        [fragments isKindOfClass:NSNumber.class] && [libraries doubleValue] > 0 && [libraries doubleValue] <= names.count &&
+        [fragments doubleValue] >= 0 && [fragments doubleValue] <= names.count &&
+        [libraries doubleValue] == [libraries unsignedIntegerValue] &&
+        [fragments doubleValue] == [fragments unsignedIntegerValue];
+    if (declaredCompiled && !compiled) {
+        if (reason) *reason = @"The app's compiled shader inventory is invalid. Install the matching IPA again.";
+        return nil;
+    }
+    NSUInteger libraryCount = 0, fragmentCount = 0;
+    if (compiled) {
+        for (NSString *name in names) {
+            if ([name hasSuffix:@".metallib"]) libraryCount++;
+            if ([name hasSuffix:@".metal"]) fragmentCount++;
+        }
+        if (libraryCount != [libraries unsignedIntegerValue] || fragmentCount != [fragments unsignedIntegerValue]) {
+            if (reason) *reason = @"The shader folder inventory does not match this app. Finish copying the matching msl folder.";
+            return nil;
+        }
+    }
+    // Identity/listing detect wrong or unfinished installs, not same-count content
+    // corruption. Metal still validates each binary when it is actually loaded.
+    fprintf(stderr, "boot timing: shader_pack_listing_ms=%.3f inventory_ms=%.3f resources=%lu\n",
+            (inventoryStart - listingStart) * 1000,
+            (NSProcessInfo.processInfo.systemUptime - inventoryStart) * 1000,
+            (unsigned long)names.count);
+    if (selected) *selected = directory;
+    if (compiled && precompiled) *precompiled = directory;
+    [[NSURL fileURLWithPath:root] setResourceValue:@YES forKey:NSURLIsExcludedFromBackupKey error:nil];
+    return root;
+}
+
+static inline NSString *dm_ios_shader_root(NSString *bundle, NSString *documents, NSString **reason) {
+    return dm_ios_shader_root_checked(bundle, documents, reason, NULL, NULL);
+}
diff --git a/dm/ios/Sources/dm_flicker_diagnostics.h b/dm/ios/Sources/dm_flicker_diagnostics.h
new file mode 100644
--- /dev/null
+++ b/dm/ios/Sources/dm_flicker_diagnostics.h
@@ -0,0 +1,149 @@
+// Optional, bounded renderer diagnostics. No shader or rendering fix is implied.
+// Include/call from boot_env AFTER env-file filtering, BEFORE any renderer use.
+// F6 may enable this capability in its one host; no profile means no changes.
+// Other hosts default to compiled out; a build override of 0 remains supported.
+#ifndef DM_FLICKER_DIAGNOSTICS_H
+#define DM_FLICKER_DIAGNOSTICS_H
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "../../gfx/nvn/dm_light_probe.h"
+
+#ifndef DM_FLICKER_DIAGNOSTICS
+#define DM_FLICKER_DIAGNOSTICS 0
+#endif
+#ifndef DM_FLICKER_GETENV
+#define DM_FLICKER_GETENV getenv
+#define DM_FLICKER_SETENV setenv
+#define DM_FLICKER_UNSETENV unsetenv
+#endif
+
+typedef struct {
+    const char *name;
+    unsigned long first, last;
+    int unwritten, predict, light;
+} dm_flicker_profile;
+
+static inline int dm_flicker_number(const char **cursor, unsigned long *value) {
+    const char *p = *cursor;
+    unsigned long n = 0;
+    if (*p < '0' || *p > '9') return 0;
+    do {
+        unsigned long digit = (unsigned long)(*p++ - '0');
+        if (n > (1000000000UL - digit) / 10) return 0;
+        n = n * 10 + digit;
+    } while (*p >= '0' && *p <= '9');
+    *cursor = p; *value = n; return 1;
+}
+
+// trace|unwritten-off|predict-off:first:count (1..3), light:first:count (1..1200).
+// Decimal numbers only, last <= 1e9. No arbitrary env assignments.
+// Parse failure leaves the caller's profile unchanged.
+static inline int dm_flicker_profile_parse(const char *spec, dm_flicker_profile *out) {
+    dm_flicker_profile p = {0};
+    const char *colon, *q;
+    unsigned long count;
+    size_t length = 0;
+    if (!spec || !out) return 0;
+    while (length <= 80 && spec[length]) length++;
+    if (length > 80 || !(colon = strchr(spec, ':'))) return 0;
+    p.unwritten = p.predict = 1;
+    if (colon - spec == 5 && !memcmp(spec, "trace", 5)) p.name = "trace";
+    else if (colon - spec == 13 && !memcmp(spec, "unwritten-off", 13)) { p.name = "unwritten-off"; p.unwritten = 0; }
+    else if (colon - spec == 11 && !memcmp(spec, "predict-off", 11)) { p.name = "predict-off"; p.predict = 0; }
+    else if (colon - spec == 5 && !memcmp(spec, "light", 5)) { p.name = "light"; p.light = 1; }
+    else return 0;
+    q = colon + 1;
+    if (!dm_flicker_number(&q, &p.first) || *q++ != ':' ||
+        !dm_flicker_number(&q, &count) || *q || count < 1 || count > (p.light ? DM_LIGHT_MAX_FRAMES : 3) ||
+        p.first > 1000000000UL - (count - 1)) return 0;
+    p.last = p.first + count - 1; *out = p; return 1;
+}
+
+// Returns 1 applied, 0 absent/compiled out, -1 invalid/conflicting/failed.
+// On -1 the caller must stop boot; never proceed with a partially applied plan.
+// The DM_NVN_* settings are intentionally applied directly after the player
+// filter, which still rejects arbitrary saved diagnostics. No launcher key,
+// profile path, cache identity or asset is changed here.
+static inline int dm_flicker_diagnostics_boot(FILE *log) {
+#if DM_FLICKER_DIAGNOSTICS
+    const char *spec = DM_FLICKER_GETENV("DM_FLICKER_PROFILE");
+    dm_flicker_profile p;
+    static const char *const conflicts[] = {
+        "DM_AB", "DM_NVN_UDC_AB", "DM_NVN_DEFER_AB", "DM_NVN_FB_SNAP",
+        "DM_NVN_HILITE", "DM_NVN_DEPTHOVR", "DM_NVN_SKIP_FS", "DM_NVN_SKIP_SMALL",
+        "DM_NVN_KEYDUMP", "DM_NVN_MAGSCAN", "DM_NVN_SHOT", "DM_NVN_SHOT_UI",
+        "DM_NVN_TEXDUMP", "DM_NVN_TEXSNAP", "DM_NVN_SNAPRAW", "DM_NVN_TEXRAW",
+        "DM_NVN_CBDUMP", "DM_NVN_VSDUMP", "DM_NVN_GPUPROF", "DM_NVN_RT_SURVEY",
+        "DM_NVN_REGLUM", "DM_NVN_T2T_TRACE", "DM_NVN_TSV", "DM_GPU_CAPTURE",
+        "MTL_CAPTURE_ENABLED", "MTL_DEBUG_LAYER", "MTL_SHADER_VALIDATION"
+    };
+    static const char *const keys[] = {
+        "DM_NVN_TBDR", "DM_NVN_UNWRITTEN_DC", "DM_NVN_PREDICT",
+        "DM_NVN_PASSDUMP", "DM_NVN_PASSDUMP_ALL", "DM_NVN_LIGHT_PROBE"
+    };
+    const char *values[6]; char range[48], light[80]; char *old[6] = {0};
+    unsigned i;
+    if (!spec || !*spec) return 0;
+    if (!log) log = stderr;
+    if (!dm_flicker_profile_parse(spec, &p)) {
+        fprintf(log, "[RED] boot: flicker diagnostic rejected: expected profile:first:count (trace 1..3, light 1..1200, last <= 1000000000)\n");
+        return -1;
+    }
+    // These switches can create unbounded logging/readback or contaminate A/B.
+    // Presence matters: several existing diagnostics treat even '=0' as on.
+    for (i = 0; i < sizeof conflicts / sizeof *conflicts; i++) {
+        if (DM_FLICKER_GETENV(conflicts[i])) {
+            fprintf(log, "[RED] boot: flicker diagnostic rejected: conflicting %s\n", conflicts[i]);
+            return -1;
+        }
+    }
+    snprintf(range, sizeof range, "%lu-%lu", p.first, p.last);
+    values[0] = "0"; values[1] = p.unwritten ? "1" : "0";
+    values[2] = p.predict ? "1" : "0"; values[3] = range; values[4] = "1";
+    values[5] = NULL;
+    if (p.light) {
+        // Trace F18000..18002 identifies this composite's actual r0 scene,
+        // r4 bloom and c0 output, before HUD. A diagnostic selector, no patch
+        // to the game's shader or image processing. Unsupported passes skip.
+        snprintf(light,sizeof light,"1068aa25d67ab129_b:%lu:%lu",p.first,p.last-p.first+1);
+        values[3] = values[4] = NULL; values[5] = light;
+    }
+    for (i = 0; i < 6; i++) {
+        const char *v = DM_FLICKER_GETENV(keys[i]);
+        if (v) {
+            old[i] = (char *)malloc(strlen(v) + 1);
+            if (!old[i]) {
+                while (i) free(old[--i]);
+                fprintf(log, "[RED] boot: flicker diagnostic rejected: snapshot allocation failed\n");
+                return -1;
+            }
+            strcpy(old[i], v);
+        }
+    }
+    for (i = 0; i < 6; i++) {
+        if (values[i] ? DM_FLICKER_SETENV(keys[i], values[i], 1) : DM_FLICKER_UNSETENV(keys[i])) {
+            unsigned j;
+            int rollback_failed = 0;
+            for (j = 0; j < i; j++) {
+                int rc = old[j] ? DM_FLICKER_SETENV(keys[j], old[j], 1) : DM_FLICKER_UNSETENV(keys[j]);
+                if (rc) rollback_failed = 1;
+            }
+            for (j = 0; j < 6; j++) free(old[j]);
+            fprintf(log, "[RED] boot: flicker diagnostic failed setting %s; rollback=%s; stop boot\n", keys[i], rollback_failed ? "failed" : "ok");
+            return -1;
+        }
+    }
+    for (i = 0; i < 6; i++) free(old[i]);
+    fprintf(log, "boot: flicker diagnostic v1 applied profile=%s renderer_frames=%lu-%lu max_frames=%d readbacks=%d intervention_scope=process\n", p.name, p.first, p.last, p.light ? DM_LIGHT_MAX_FRAMES : 3, p.light);
+    for (i = 0; i < 6; i++) {
+        const char *v=DM_FLICKER_GETENV(keys[i]);
+        fprintf(log, "boot: flicker effective %s=%s\n", keys[i], v ? v : "<unset>");
+    }
+    return 1;
+#else
+    (void)log;
+    return 0;
+#endif
+}
