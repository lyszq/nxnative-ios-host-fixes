+"""CPU and source-layout tests for the unconnected projection prerequisites."""
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from dm.tools.tests.run_obs_frame_native import extract_gate_body, first_gate_instruction
+
+
+ROOT = Path(__file__).resolve().parents[3]
+HOST = ROOT / "dm/host"
+
+
+class ProjectionPrereqTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.entry = (HOST / "entry.S").read_text(encoding="utf-8")
+        cls.frame_header = (HOST / "dm_obs_frame.h").read_text(encoding="utf-8")
+        cls.native_runner = (ROOT / "dm/tools/tests/run_obs_frame_native.py").read_text(encoding="utf-8")
+
+    def test_typed_frame_offsets_match_real_entry_assembly(self):
+        gate = self.entry.split("_dm_gate:", 1)[1].split("// 3) dm_thread_enter", 1)[0]
+        qstores = [tuple(map(int, m.groups())) for m in re.finditer(
+            r"\bstp\s+q(\d+),\s*q(\d+),\s*\[sp,\s*#(\d+)\]", gate)]
+        qloads = [tuple(map(int, m.groups())) for m in re.finditer(
+            r"\bldp\s+q(\d+),\s*q(\d+),\s*\[sp,\s*#(\d+)\]", gate)]
+        expected = [(q, q + 1, 256 + q * 16) for q in range(0, 32, 2)]
+        self.assertEqual(qstores, expected)
+        self.assertEqual(qloads, expected)
+        self.assertRegex(gate, r"sub\s+sp,\s*sp,\s*#800")
+        self.assertRegex(gate, r"add\s+sp,\s*sp,\s*#800")
+        for status, offset in (("nzcv", 768), ("fpsr", 776), ("fpcr", 784)):
+            self.assertRegex(gate, rf"mrs\s+x9,\s*{status}\s*\n\s*str\s+x9,\s*\[sp,\s*#{offset}\]")
+            self.assertRegex(gate, rf"ldr\s+x9,\s*\[sp,\s*#{offset}\]\s*\n\s*msr\s+{status},\s*x9")
+        self.assertIn("DM_OBS_FRAME_Q_OFFSET = 256", self.frame_header)
+        self.assertIn("DM_OBS_FRAME_Q_STRIDE = 16", self.frame_header)
+        self.assertIn("offsetof(dm_obs_frame, q) == DM_OBS_FRAME_Q_OFFSET", self.frame_header)
+        self.assertIn("sizeof(dm_obs_frame) == DM_OBS_FRAME_BYTES", self.frame_header)
+
+    def test_native_runner_extracts_gate_and_has_explicit_platform_skip(self):
+        self.assertEqual(first_gate_instruction(extract_gate_body(self.entry)), "sub sp, sp, #800")
+        self.assertIn('entry.index(".globl _dm_gate")', self.native_runner)
+        self.assertIn('entry.index(".globl _dm_thread_enter", start)', self.native_runner)
+        self.assertIn('sys.platform != "darwin"', self.native_runner)
+        self.assertIn('platform.machine().lower()', self.native_runner)
+        self.assertIn("gate_first_instruction", self.native_runner)
+        self.assertIn('projection_entry_instruction = "stp d11, d10, [sp, #-0x40]!"', self.native_runner)
+
+    def test_cpu_c_fixtures(self):
+        if sys.platform == "darwin" and shutil.which("xcrun"):
+            compiler = [shutil.which("xcrun"), "clang"]
+        elif shutil.which("zig"):
+            compiler = [shutil.which("zig"), "cc"]
+        elif shutil.which("clang") or shutil.which("cc"):
+            compiler = [shutil.which("clang") or shutil.which("cc")]
+        else:
+            self.skipTest("A C compiler is required")
+
+        cases = [
+            ("t_obs_frame.c", [str(HOST / "tests/t_obs_frame.c")]),
+            ("t_vertical_fov.c", [str(HOST / "tests/t_vertical_fov.c"),
+                                   str(HOST / "dm_vertical_fov.c"), "-lm"]),
+        ]
+        with tempfile.TemporaryDirectory(prefix="projection-prereq-") as td:
+            for name, sources in cases:
+                executable = Path(td) / Path(name).stem
+                command = compiler + ["-std=c11", "-O1", "-UNDEBUG", "-Wall", "-Wextra", "-Werror",
+                           "-I", str(HOST), *sources, "-o", str(executable)]
+                try:
+                    built = subprocess.run(command, text=True, capture_output=True, check=True)
+                except subprocess.CalledProcessError as exc:
+                    detail = (exc.stdout or "") + (exc.stderr or "")
+                    if "unable to find zig installation directory" in detail:
+                        self.skipTest("Zig is present but its WinGet package cannot locate its bundled lib directory")
+                    self.fail(f"C fixture compile failed: {command!r}\n{detail}")
+                self.assertEqual(built.returncode, 0)
+                ran = subprocess.run([str(executable)], text=True, capture_output=True)
+                self.assertEqual(ran.returncode, 0, ran.stdout + ran.stderr)
+                self.assertIn("PASS:", ran.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
