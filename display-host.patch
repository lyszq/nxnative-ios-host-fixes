@@ -0,0 +1,291 @@
+#!/usr/bin/env python3
+"""Run the saved-Q-lane and selected-GPR fixture on macOS ARM64 against _dm_gate.
+
+The Windows/Zig C fixtures are separate and cover the portable frame/math APIs.
+This native test additionally executes the extracted assembly body and replays
+the actual first instruction of the projection wrapper in isolation. It does
+not execute a game, install a hook, or test a complete OBS rewrite stub.
+"""
+from pathlib import Path
+import platform
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def extract_gate_body(entry):
+    start = entry.index(".globl _dm_gate")
+    end = entry.index(".globl _dm_thread_enter", start)
+    return entry[start:end]
+
+
+def first_gate_instruction(body):
+    instructions = body.split("_dm_gate:", 1)[1].splitlines()
+    for line in instructions:
+        instruction = line.split("//", 1)[0].strip()
+        if instruction:
+            return instruction
+    raise ValueError("_dm_gate body has no instructions")
+
+
+def build_assembly(entry):
+    start = entry.index(".globl _dm_gate")
+    end = entry.index(".globl _dm_thread_enter", start)
+    actual_gate_body = entry[start:end]
+    gate_first_instruction = first_gate_instruction(actual_gate_body)
+    if not gate_first_instruction.startswith("sub sp, sp, #800"):
+        raise ValueError(f"unexpected _dm_gate entry instruction: {gate_first_instruction}")
+
+    # Independently replay the verified retail wrapper's first instruction.
+    # main+0x73de60 decoded as STP D11,D10,[SP,#-0x40]! (word 0x6dbc2beb,
+    # little-endian bytes eb2bbc6d); this test does not read or patch the NSO.
+    projection_entry_instruction = "stp d11, d10, [sp, #-0x40]!"
+    qloads = "\n".join(
+        f"    ldp q{q}, q{q + 1}, [x16, #{q * 16}]" for q in range(0, 32, 2))
+    qstores = "\n".join(
+        f"    stp q{q}, q{q + 1}, [x16, #{q * 16}]" for q in range(0, 32, 2))
+    guest_gprs = tuple(range(18)) + tuple(range(19, 30))
+    gpr_stores = "\n".join(
+        f"    str x{reg}, [sp, #{256 + reg * 8}]" for reg in guest_gprs + (30,))
+    gpr_copies = "\n".join(
+        f"    ldr x17, [sp, #{256 + reg * 8}]\n    str x17, [x16, #{reg * 8}]"
+        for reg in guest_gprs + (30,))
+    gpr_sentinels = "\n".join(
+        f"    mov x{reg}, #{0x100 + reg}" for reg in guest_gprs)
+    projection_entry_replay = f"""
+.globl _dm_test_replay_projection_entry
+.p2align 2
+_dm_test_replay_projection_entry:
+    stp d10, d11, [sp, #-16]!
+    ldr d10, [x0]
+    ldr d11, [x0, #8]
+    mov x9, sp
+    {projection_entry_instruction}
+    ldr x10, [sp]
+    str x10, [x1]
+    ldr x10, [sp, #8]
+    str x10, [x1, #8]
+    mov x10, sp
+    sub x10, x9, x10
+    str x10, [x1, #16]
+    add sp, sp, #64
+    mov x10, sp
+    cmp x9, x10
+    cset w0, eq
+    ldp d10, d11, [sp], #16
+    ret
+"""
+    test_call_gate = f"""
+.globl _dm_test_invoke_gate
+.p2align 2
+_dm_test_invoke_gate:
+    sub sp, sp, #544
+    stp x29, x30, [sp, #0]
+    mov x29, sp
+    stp x19, x20, [sp, #16]
+    stp x21, x22, [sp, #32]
+    stp x23, x24, [sp, #48]
+    stp x25, x26, [sp, #64]
+    stp x27, x28, [sp, #80]
+    stp d8, d9, [sp, #96]
+    stp d10, d11, [sp, #112]
+    stp d12, d13, [sp, #128]
+    stp d14, d15, [sp, #144]
+    str x0, [sp, #184]
+    str x1, [sp, #192]
+    str x5, [sp, #200]
+    str x6, [sp, #208]
+    str x2, [sp, #160]
+    str x3, [sp, #168]
+    str x4, [sp, #176]
+    ldr x16, [sp, #184]
+{qloads}
+{gpr_sentinels}
+    ldr x16, [sp, #160]
+    msr nzcv, x16
+    ldr x16, [sp, #168]
+    msr fpsr, x16
+    ldr x16, [sp, #176]
+    msr fpcr, x16
+    mov x16, #272
+    mov x17, #273
+    bl _dm_gate
+{gpr_stores}
+    ldr x16, [sp, #192]
+{qstores}
+    mrs x9, nzcv
+    ldr x16, [sp, #200]
+    str x9, [x16]
+    mrs x9, fpsr
+    str x9, [x16, #8]
+    mrs x9, fpcr
+    str x9, [x16, #16]
+    ldr x16, [sp, #208]
+{gpr_copies}
+    ldp d8, d9, [sp, #96]
+    ldp d10, d11, [sp, #112]
+    ldp d12, d13, [sp, #128]
