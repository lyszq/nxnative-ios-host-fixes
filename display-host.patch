+    expect(g_nsbw_w == SBW_WN && !g_sbw_over, "wide interval table accepts its full capacity");
+    sbw_note(0x600000000ull + (uint64_t)SBW_WN * step, wide, SBW_GPU);
+    expect(g_sbw_over, "more than 64 distinct wide intervals uses the global fallback");
+    gw_commit(90);
