+
+def run() -> subprocess.CompletedProcess[str]:
+    with tempfile.TemporaryDirectory(prefix="nvn-sbw-native-") as td:
+        temp_root = Path(td)
+        source = _production_source()
+        # These are pure bookkeeping functions. sbw_len remains Objective-C but
+        # is separately checked to call the extracted, tested sbw_bound_len.
+        for text in (
+            "sbw_note(u->addr, sbw_len(u->size, mb, mo), SBW_GPU)",
+            "sbw_note(addr, sbw_len(0, mb, mo), SBW_GPU)",
+            "return sbw_bound_len(0, len, mo);",
+            "sbw_forward_wide(fence, done);",
+        ):
+            if text not in source:
+                raise RuntimeError(f"production integration is missing: {text}")
+
+        c_path = temp_root / "nvn_sbw_fixture.c"
+        binary = temp_root / ("nvn_sbw_fixture.exe" if os.name == "nt" else "nvn_sbw_fixture")
+        c_path.write_text(_fixture(source), encoding="utf-8", newline="\n")
+        command = _compiler() + [
+            "-std=c11",
+            "-O2",
+            "-Wno-unused-function",
+            str(c_path),
+            "-o",
+            str(binary),
+        ]
+        compiled = subprocess.run(command, capture_output=True, text=True, encoding="utf-8")
+        if compiled.returncode:
+            return compiled
+        return subprocess.run([str(binary)], capture_output=True, text=True, encoding="utf-8")
+
+
+def main() -> int:
+    try:
+        result = run()
+    except Exception as exc:  # print a concise diagnostic for CI and direct use
+        print(f"SBW_NATIVE setup failed: {exc}", file=sys.stderr)
+        return 2
+    if result.stdout:
+        print(result.stdout, end="")
+    if result.stderr:
+        print(result.stderr, end="", file=sys.stderr)
+    return result.returncode
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
