+
+#define DM_ODYSSEY_MAIN_BUILD "b424be150a8e7d78701cbe7a439d9ebf"
+#define DM_ODYSSEY_DEFAULT_RESOLUTION "1080p"
+#define DM_ODYSSEY_PROFILE_HEADER "#odyssey-display-v1"
