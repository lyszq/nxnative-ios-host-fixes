--- a/dm/host/hle_svc.c
+++ b/dm/host/hle_svc.c
@@ -1,6 +1,7 @@
 // Horizon kernel system calls (triggered by the SDK runtime once the SDK is loaded). Only what the P1 boot chain needs is implemented: memory layout + heap + query + debug output + timing.
 // Register convention: inputs w1.. / outputs w0=Result, x1=value (GetInfo / SetHeapSize), consistent with the public Horizon ABI.
 #include "dm.h"
+#include "dm_odyssey_display.h"
 #include <sys/mman.h>
 #include <errno.h>
 #include <unistd.h>
@@ -24,7 +25,13 @@ static uint64_t env_u64(const char *k, uint64_t dflt) {
     const char *v = getenv(k);
     return v && *v ? strtoull(v, NULL, 0) : dflt;
 }
-static uint64_t app_pool(void) { if (!g_app_pool) g_app_pool = env_u64("DM_APP_POOL", DM_GAME_APP_POOL); return g_app_pool; }
+static uint64_t app_pool(void) {
+    if (!g_app_pool) g_app_pool = env_u64("DM_APP_POOL", DM_GAME_APP_POOL); // cache the profile base before launcher policy is published
+    uint64_t total;
+    if (!dm_odyssey_display_pool_total(g_app_pool, dm_odyssey_display_pool_extra(), &total))
+        die("application pool plus accepted Odyssey render-target increment overflows");
+    return total;
+}
 static uint64_t mem_used(void) { if (!g_mem_used) g_mem_used = env_u64("DM_MEM_USED", DM_GAME_MEM_USED); return g_mem_used; }
 // The NPDM's system resource size: the shell is compiled from the placeholder profile, and a build that declares one
