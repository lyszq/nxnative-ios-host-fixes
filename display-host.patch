diff --git a/dm/host/hle_odyssey_display.c b/dm/host/hle_odyssey_display.c
new file mode 100644
index 0000000..b4e0e85
--- /dev/null
+++ b/dm/host/hle_odyssey_display.c
@@ -0,0 +1,466 @@
+#include "dm.h"
+#include "front.h"
+#include "dm_obs_frame.h"
+#include "dm_odyssey_display.h"
+#include "dm_vertical_fov.h"
+
+#include <CommonCrypto/CommonDigest.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <math.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdatomic.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define DM_ODYSSEY_MAIN_BUILD "b424be150a8e7d78701cbe7a439d9ebf"
+#define DM_ODYSSEY_PROFILE_HEADER "#odyssey-display-v1"
+#define DM_ODYSSEY_MANIFEST_MAX 8192u
+#define DM_ODYSSEY_ASSET_MAX 65536u
+#define DM_ROMFS_OVERLAY_MAX 4095u
+#define DM_ODYSSEY_MIB (1024u * 1024u)
+#define DM_ODYSSEY_BASE_RT_POOL_MIB 100u
+#define DM_ODYSSEY_BASE_GLOBAL_HEAP UINT32_C(0xc3000000)
+
+typedef struct {
+    dm_odyssey_display_config config;
+    int active;
+} odyssey_display_state;
+
+static odyssey_display_state g_display;
+// Width and height publish together, so native iPad's slightly non-4:3 panel
+// ratio is visible consistently to the front end and the projection hook.
+static _Atomic uint64_t g_published_viewport = UINT64_C(1600) | (UINT64_C(900) << 32);
+// The app-pool SVC can be queried from host threads that run before/after the
+// display initializer; publish only the accepted scalar increment atomically.
+static _Atomic uint64_t g_published_pool_extra;
+
+float dm_odyssey_display_aspect(void) {
+    const uint64_t packed = atomic_load_explicit(&g_published_viewport, memory_order_acquire);
+    const uint32_t width = (uint32_t)packed;
+    const uint32_t height = (uint32_t)(packed >> 32);
+    return width && height ? (float)width / (float)height : 16.0f / 9.0f;
+}
+
+uint64_t dm_odyssey_display_pool_extra(void) {
+    return atomic_load_explicit(&g_published_pool_extra, memory_order_acquire);
+}
+
+static int fail(char *error, size_t error_size, const char *format, ...) {
+    if (error && error_size) {
+        va_list ap;
+        va_start(ap, format);
+        vsnprintf(error, error_size, format, ap);
+        va_end(ap);
+    }
+    return 0;
+}
+
+static int open_regular(const char *path, size_t max_size, struct stat *st,
+                        char *error, size_t error_size) {
+    int flags = O_RDONLY;
+#ifdef O_CLOEXEC
+    flags |= O_CLOEXEC;
+#endif
+#ifdef O_NOFOLLOW
+    flags |= O_NOFOLLOW;
+#endif
+    int fd = open(path, flags);
+    if (fd < 0) {
+        fail(error, error_size, "cannot open selected display file (errno %d)", errno);
+        return -1;
+    }
+    if (fstat(fd, st) || !S_ISREG(st->st_mode) || st->st_size < 0 ||
+        (uint64_t)st->st_size > max_size) {
+        close(fd);
+        fail(error, error_size, "display file is not a bounded regular file");
+        return -1;
+    }
+    return fd;
+}
+
+static int read_exact(int fd, uint8_t *out, size_t size) {
+    size_t used = 0;
+    while (used < size) {
+        ssize_t n = read(fd, out + used, size - used);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return 0;
+        used += (size_t)n;
+    }
+    return 1;
+}
+
+static int parse_decimal(const char *text, uint32_t *value) {
+    if (!text || !*text || !value) return 0;
+    uint32_t n = 0;
+    for (const unsigned char *p = (const unsigned char *)text; *p; p++) {
+        if (*p < '0' || *p > '9') return 0;
+        uint32_t digit = *p - '0';
+        if (n > (UINT32_MAX - digit) / 10u) return 0;
+        n = n * 10u + digit;
+    }
+    *value = n;
+    return 1;
+}
+
+static int parse_sha256(const char *text) {
+    if (!text || strlen(text) != CC_SHA256_DIGEST_LENGTH * 2u) return 0;
+    for (const unsigned char *p = (const unsigned char *)text; *p; p++)
+        if (!((*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f'))) return 0;
+    return 1;
+}
+
+static int hash_asset(const char *path, uint32_t expected_bytes,
+                      const char *expected_sha, char *error, size_t error_size) {
+    struct stat st;
+    int fd = open_regular(path, DM_ODYSSEY_ASSET_MAX, &st, error, error_size);
+    if (fd < 0) return 0;
+    if ((uint64_t)st.st_size != expected_bytes || expected_bytes == 0) {
+        close(fd);
+        return fail(error, error_size, "selected display asset length does not match profiles.tsv");
+    }
+
+    uint8_t bytes[DM_ODYSSEY_ASSET_MAX];
+    if (!read_exact(fd, bytes, expected_bytes)) {
+        close(fd);
+        return fail(error, error_size, "cannot read the complete selected display asset");
+    }
+    close(fd);
+
+    uint8_t digest[CC_SHA256_DIGEST_LENGTH];
+    if (!CC_SHA256(bytes, (CC_LONG)expected_bytes, digest))
+        return fail(error, error_size, "CommonCrypto could not hash the selected display asset");
+    char actual[CC_SHA256_DIGEST_LENGTH * 2u + 1u];
+    static const char hex[] = "0123456789abcdef";
+    for (size_t i = 0; i < sizeof digest; i++) {
+        actual[i * 2] = hex[digest[i] >> 4];
+        actual[i * 2 + 1] = hex[digest[i] & 15];
+    }
+    actual[sizeof actual - 1] = 0;
+    if (strcmp(actual, expected_sha))
+        return fail(error, error_size, "selected display asset SHA-256 does not match profiles.tsv");
+    return 1;
+}
+
+static int split_row(char *line, char *field[6]) {
+    char *cursor = line;
+    for (unsigned i = 0; i < 5; i++) {
+        field[i] = cursor;
+        char *tab = strchr(cursor, '\t');
+        if (!tab) return 0;
+        *tab = 0;
+        cursor = tab + 1;
+    }
+    field[5] = cursor;
+    return strchr(cursor, '\t') == NULL && *field[0] && *field[1] && *field[2] &&
+           *field[3] && *field[4] && *field[5];
+}
+
+static int aspect_index(dm_odyssey_aspect aspect) {
+    return aspect == DM_ODYSSEY_ASPECT_16X9 ? 0 : 1;
+}
+
+static int validate_manifest(const char *root,
+                             const dm_odyssey_display_config *config,
+                             char *selected_sha, size_t selected_sha_size,
+                             uint32_t *selected_bytes,
+                             char *error, size_t error_size) {
+    char manifest_path[PATH_MAX];
+    int n = snprintf(manifest_path, sizeof manifest_path, "%s/profiles.tsv", root);
+    if (n < 0 || (size_t)n >= sizeof manifest_path)
+        return fail(error, error_size, "display profiles.tsv path is too long");
+
+    struct stat st;
+    int fd = open_regular(manifest_path, DM_ODYSSEY_MANIFEST_MAX, &st, error, error_size);
+    if (fd < 0) return 0;
+    if (st.st_size == 0) {
+        close(fd);
+        return fail(error, error_size, "display profiles.tsv is empty");
+    }
+    size_t file_size = (size_t)st.st_size;
+    char data[DM_ODYSSEY_MANIFEST_MAX + 1];
+    if (!read_exact(fd, (uint8_t *)data, file_size)) {
+        close(fd);
+        return fail(error, error_size, "cannot read complete display profiles.tsv");
+    }
+    close(fd);
+    data[file_size] = 0;
+
+    char *line = data;
+    char *end = memchr(line, '\n', file_size);
+    if (!end) return fail(error, error_size, "display profiles.tsv has no row header");
+    *end = 0;
+    if (end > line && end[-1] == '\r') end[-1] = 0;
+    if (strcmp(line, DM_ODYSSEY_PROFILE_HEADER))
+        return fail(error, error_size, "display profiles.tsv header is invalid");
+
+    int seen[DM_ODYSSEY_PRESET_COUNT][2] = {{0}};
+    char selected_expected_sha[CC_SHA256_DIGEST_LENGTH * 2u + 1u] = {0};
+    uint32_t selected_expected_bytes = 0;
+    unsigned rows = 0;
+    line = end + 1;
+    while (line < data + file_size) {
+        end = memchr(line, '\n', (size_t)(data + file_size - line));
+        char *line_end = end ? end : data + file_size;
+        if (line_end > line && line_end[-1] == '\r') line_end[-1] = 0;
+        if (line_end == line) return fail(error, error_size, "display profiles.tsv contains an empty row");
+        if (rows >= DM_ODYSSEY_PRESET_COUNT * 2u)
+            return fail(error, error_size, "display profiles.tsv has extra rows");
+        if (end) *end = 0;
+
+        char *fields[6];
+        if (!split_row(line, fields)) return fail(error, error_size, "display profiles.tsv row must have six tab-separated fields");
+
+        dm_odyssey_preset preset = DM_ODYSSEY_PRESET_COUNT;
+        for (int i = 0; i < DM_ODYSSEY_PRESET_COUNT; i++)
+            if (!strcmp(fields[0], dm_odyssey_display_preset_name((dm_odyssey_preset)i))) preset = (dm_odyssey_preset)i;
+        dm_odyssey_aspect aspect;
+        if (preset == DM_ODYSSEY_PRESET_COUNT)
+            return fail(error, error_size, "display profiles.tsv has an unknown preset or aspect");
+        if (!strcmp(fields[1], "16x9")) aspect = DM_ODYSSEY_ASPECT_16X9;
+        else if (!strcmp(fields[1], "4x3")) aspect = DM_ODYSSEY_ASPECT_4X3;
+        else return fail(error, error_size, "display profiles.tsv has an unknown preset or aspect");
+
+        const int ai = aspect_index(aspect);
+        if (seen[preset][ai]++) return fail(error, error_size, "display profiles.tsv duplicates a preset/aspect row");
+        uint32_t width = 0, height = 0, bytes = 0;
+        dm_odyssey_display_config expected;
+        if (!dm_odyssey_display_policy_parse(fields[0], ai ? "1" : "0", &expected) ||
+            !parse_decimal(fields[2], &width) || !parse_decimal(fields[3], &height) ||
+            !parse_decimal(fields[5], &bytes) || !parse_sha256(fields[4]) ||
+            width > 2732 || height > 2048 || width != expected.width || height != expected.height ||
+            bytes == 0 || bytes > DM_ODYSSEY_ASSET_MAX)
+            return fail(error, error_size, "display profiles.tsv row dimensions, hash, or byte count are invalid");
+
+        if (preset == config->preset && aspect == config->aspect) {
+            memcpy(selected_expected_sha, fields[4], sizeof selected_expected_sha);
+            selected_expected_bytes = bytes;
+        }
+        rows++;
+        line = end ? end + 1 : data + file_size;
+    }
+
+    if (rows != DM_ODYSSEY_PRESET_COUNT * 2u)
+        return fail(error, error_size, "display profiles.tsv must contain exactly twelve rows");
+    for (unsigned p = 0; p < DM_ODYSSEY_PRESET_COUNT; p++)
+        for (unsigned a = 0; a < 2; a++)
+            if (seen[p][a] != 1) return fail(error, error_size, "display profiles.tsv is missing a preset/aspect row");
+    if (!selected_expected_bytes || !selected_expected_sha[0] || selected_sha_size < sizeof selected_expected_sha)
+        return fail(error, error_size, "selected display profile row is missing or invalid");
+    memcpy(selected_sha, selected_expected_sha, sizeof selected_expected_sha);
+    *selected_bytes = selected_expected_bytes;
+    return 1;
+}
+
+int dm_odyssey_display_validate_asset(const char *root,
+                                      const dm_odyssey_display_config *config,
+                                      char *overlay_root, size_t overlay_root_size,
+                                      char *error, size_t error_size) {
+    if (error && error_size) error[0] = 0;
+    if (!root || !*root || !config || !config->active || !overlay_root || !overlay_root_size)
+        return fail(error, error_size, "display profile request is incomplete");
+    if (!dm_odyssey_display_preset_name(config->preset) ||
+        !dm_odyssey_display_aspect_name(config->aspect))
+        return fail(error, error_size, "display profile enums are invalid");
+    if (strchr(root, ':'))
+        return fail(error, error_size, "display asset root cannot contain ':' because overlay roots use it as a separator");
+
+    char expected_sha[CC_SHA256_DIGEST_LENGTH * 2u + 1u];
+    uint32_t expected_bytes = 0;
+    if (!validate_manifest(root, config, expected_sha, sizeof expected_sha,
+                           &expected_bytes, error, error_size)) return 0;
+
+    const char *aspect = dm_odyssey_display_aspect_name(config->aspect);
+    const char *preset = dm_odyssey_display_preset_name(config->preset);
+    char profile_root[PATH_MAX], asset_path[PATH_MAX];
+    int n = snprintf(profile_root, sizeof profile_root, "%s/%s/%s", root, aspect, preset);
+    if (n < 0 || (size_t)n >= sizeof profile_root)
+        return fail(error, error_size, "selected display overlay path is too long");
+    n = snprintf(asset_path, sizeof asset_path,
+                 "%s/SystemData/ProjectGraphicsQuality.szs", profile_root);
+    if (n < 0 || (size_t)n >= sizeof asset_path)
+        return fail(error, error_size, "selected display asset path is too long");
+    if (!hash_asset(asset_path, expected_bytes, expected_sha, error, error_size)) return 0;
+    if ((size_t)snprintf(overlay_root, overlay_root_size, "%s", profile_root) >= overlay_root_size)
+        return fail(error, error_size, "selected display overlay root output is too small");
+    return 1;
+}
+
+static int set_overlay_root(const char *selected, char *error, size_t error_size) {
+    const char *existing = getenv("DM_ROMFS_OVERLAY");
+    size_t selected_len = strlen(selected), existing_len = existing ? strlen(existing) : 0;
+    size_t need = selected_len + (existing_len ? 1u + existing_len : 0u);
+    if (need > DM_ROMFS_OVERLAY_MAX)
+        return fail(error, error_size, "combined ROMFS overlay roots exceed the host limit");
+    char combined[DM_ROMFS_OVERLAY_MAX + 1];
+    memcpy(combined, selected, selected_len);
+    size_t used = selected_len;
+    if (existing_len) {
+        combined[used++] = ':';
+        memcpy(combined + used, existing, existing_len);
+        used += existing_len;
+    }
+    combined[used] = 0;
+    if (setenv("DM_ROMFS_OVERLAY", combined, 1))
+        return fail(error, error_size, "cannot install selected ROMFS overlay (errno %d)", errno);
+    return 1;
+}
+
+static void projection_adjust(uint64_t *regs, int param) {
+    (void)param;
+    if (!g_display.active) return;
+
+    float fovy = 0.0f, source_aspect = 0.0f;
+    if (!dm_obs_frame_read_s(regs, DM_OBS_FRAME_BYTES, 2, &fovy) ||
+        !dm_obs_frame_read_s(regs, DM_OBS_FRAME_BYTES, 3, &source_aspect)) return;
+    const float target_aspect = dm_odyssey_display_aspect();
+    float transformed_fovy = fovy;
+    if (dm_vertical_fov_extend_16_9_to_aspect(
+            fovy, source_aspect, target_aspect, &transformed_fovy) != DM_VERTICAL_FOV_TRANSFORMED) return;
+    if (!dm_obs_frame_write_s(regs, DM_OBS_FRAME_BYTES, 2, transformed_fovy)) return;
+    (void)dm_obs_frame_write_s(regs, DM_OBS_FRAME_BYTES, 3, target_aspect);
+}
+
+static void packed_size_adjust(uint64_t *regs, int param) {
+    (void)param;
+    if (!g_display.active || regs[9] != (UINT64_C(1600) | (UINT64_C(900) << 32))) return;
+    regs[9] = (uint64_t)g_display.config.width | ((uint64_t)g_display.config.height << 32);
+}
+
+static void canvas_size_adjust(uint64_t *regs, int param) {
+    (void)param;
+    if (!g_display.active || regs[4] != 1600 || regs[5] != 900) return;
+    regs[4] = g_display.config.width;
+    regs[5] = g_display.config.height;
+}
+
+static void crop_size_adjust(uint64_t *regs, int param) {
+    (void)param;
+    if (!g_display.active || regs[3] != 1600 || regs[4] != 900) return;
+    regs[3] = g_display.config.width;
+    regs[4] = g_display.config.height;
+}
+
+static void rt_heap_adjust(uint64_t *regs, int param) {
+    (void)param;
+    if (!g_display.active || !g_display.config.rt_heap_mib) return;
+    regs[0] = (uint32_t)(g_display.config.rt_heap_mib * DM_ODYSSEY_MIB);
+}
+
+static void rt_pool_adjust(uint64_t *regs, int param) {
+    (void)param;
+    if (!g_display.active || !g_display.config.rt_pool_mib) return;
+    regs[8] = (uint32_t)(g_display.config.rt_pool_mib * DM_ODYSSEY_MIB);
+}
+
+// launcher-highres CUTs the original MOVZ at this site to NOP. Install this
+// callback before any policy early return so the guest always receives either
+// the exact original pool value or the fully validated high-resolution value.
+static void global_heap_adjust(uint64_t *regs, int param) {
+    (void)param;
+    regs[0] = DM_ODYSSEY_BASE_GLOBAL_HEAP + (uint32_t)dm_odyssey_display_pool_extra();
+}
+
+static int native_panel_supported(void) {
+    const char *value = getenv("DM_ODYSSEY_NATIVE_PANEL");
+    return value && !strcmp(value, "1");
+}
+
+static int viewport_aspect_changed(uint32_t width, uint32_t height) {
+    const float aspect = (float)width / (float)height;
+    return fabsf(aspect - 16.0f / 9.0f) > 0.0001f;
+}
+
+void dm_odyssey_display_init(void) {
+    const int exact_build = !strcmp(dm_main_build(), DM_ODYSSEY_MAIN_BUILD);
+    const int have_rt_heap_gate = gate_obs_present(OBS_ODYSSEY_RT_HEAP);
+    const int have_rt_pool_gate = gate_obs_present(OBS_ODYSSEY_RT_POOL);
+    const int have_global_heap_gate = gate_obs_present(OBS_ODYSSEY_GLOBAL_HEAP);
+    const int any_highres_gate = have_rt_heap_gate || have_rt_pool_gate || have_global_heap_gate;
+    const int complete_highres_gates = have_rt_heap_gate && have_rt_pool_gate && have_global_heap_gate;
+
+    // The high profile replaces the global heap-size MOVZ with a NOP. Fail
+    // closed for stale/partial gate sets and attach its restore callback first.
+    if (any_highres_gate) {
+        if (!exact_build) die("Odyssey high-resolution memory gate belongs to main %s, found %s",
+                              DM_ODYSSEY_MAIN_BUILD, dm_main_build());
+        if (!complete_highres_gates)
+            die("Odyssey high-resolution memory profile has an incomplete RT/global heap gate pair");
+        gate_obs_set(OBS_ODYSSEY_GLOBAL_HEAP, global_heap_adjust);
+    }
+
+    dm_odyssey_display_config config;
+    if (!dm_odyssey_display_policy_parse(getenv("DM_ODYSSEY_RESOLUTION"),
+                                         getenv("DM_ODYSSEY_4_3"), &config)) {
+        LOG("[RED] Odyssey display choice is invalid; keeping stock resolution and aspect");
+        return;
+    }
+    if (!config.active) return;
+
+    const int opmode = dm_opmode();
+    if (opmode == 0) {
+        LOG("Odyssey display choices ignored in handheld mode (DM_OPMODE=0); using the stock picture and resolution");
+        return;
+    }
+    if (opmode != 1) {
+        LOG("[RED] Odyssey display choices require docked mode (DM_OPMODE=1); mode %d keeps stock", opmode);
+        return;
+    }
+
+    if (!exact_build) {
+        LOG("[RED] Odyssey display choice is unavailable for this main build; keeping stock");
+        return;
+    }
+    if (config.highres && !complete_highres_gates) {
+        LOG("[RED] Odyssey high-resolution choice requires the complete launcher-highres memory profile; keeping stock");
+        return;
+    }
+    if (config.native_panel && !native_panel_supported()) {
+        LOG("[RED] Odyssey native resolution requires a 2732x2048 iPad panel; keeping stock");
+        return;
+    }
+    if (!gate_obs_present(OBS_ODYSSEY_PROJECTION) ||
+        !gate_obs_present(OBS_ODYSSEY_PACKED_SIZE) ||
+        !gate_obs_present(OBS_ODYSSEY_CANVAS_SIZE) ||
+        !gate_obs_present(OBS_ODYSSEY_CROP_SIZE)) {
+        LOG("[RED] Odyssey display choice is missing one or more paired main gates; keeping stock");
+        return;
+    }
+
+    char selected_root[PATH_MAX], error[256];
+    if (!dm_odyssey_display_validate_asset(getenv("DM_ODYSSEY_DISPLAY_ROOT"), &config,
+                                           selected_root, sizeof selected_root,
+                                           error, sizeof error)) {
+        LOG("[RED] Odyssey display choice is unavailable: %s; keeping stock", error);
+        return;
+    }
+    if (!set_overlay_root(selected_root, error, sizeof error)) {
+        LOG("[RED] Odyssey display choice is unavailable: %s; keeping stock", error);
+        return;
+    }
+
+    g_display.config = config;
+    g_display.active = 1;
+    atomic_store_explicit(&g_published_viewport,
+                          (uint64_t)config.width | ((uint64_t)config.height << 32),
+                          memory_order_release);
+    atomic_store_explicit(&g_published_pool_extra,
+                          (uint64_t)config.app_pool_extra_mib * DM_ODYSSEY_MIB,
+                          memory_order_release);
+    gate_obs_set(OBS_ODYSSEY_PROJECTION, projection_adjust);
+    gate_obs_set(OBS_ODYSSEY_PACKED_SIZE, packed_size_adjust);
+    gate_obs_set(OBS_ODYSSEY_CANVAS_SIZE, canvas_size_adjust);
+    gate_obs_set(OBS_ODYSSEY_CROP_SIZE, crop_size_adjust);
+    if (complete_highres_gates) {
+        gate_obs_set(OBS_ODYSSEY_RT_HEAP, rt_heap_adjust);
+        gate_obs_set(OBS_ODYSSEY_RT_POOL, rt_pool_adjust);
+    }
+    if (viewport_aspect_changed(config.width, config.height)) front_display_aspect_changed();
+    LOG("Odyssey display enabled: %s %s, %ux%u; selected overlay SHA-256 verified; vertical FOV changes only for finite 16:9 projections",
+        dm_odyssey_display_preset_name(config.preset),
+        dm_odyssey_display_aspect_name(config.aspect), config.width, config.height);
+}
diff --git a/dm/host/hle_svc.c b/dm/host/hle_svc.c
