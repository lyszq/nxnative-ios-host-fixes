diff --git a/dm/host/dm_obs_frame.h b/dm/host/dm_obs_frame.h
new file mode 100644
index 0000000..2db96c8
--- /dev/null
+++ b/dm/host/dm_obs_frame.h
@@ -0,0 +1,71 @@
+#ifndef DM_OBS_FRAME_H
+#define DM_OBS_FRAME_H
+
+// Typed view of the 800-byte register frame used by dm/host/entry.S::_dm_gate.
+// S-lane helpers operate on exactly four bytes at the start of Qn; they do not
+// touch the rest of that vector, any other vector, GPRs, or saved status.
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+enum {
+    DM_OBS_FRAME_X_COUNT = 31,
+    DM_OBS_FRAME_Q_COUNT = 32,
+    DM_OBS_FRAME_Q_OFFSET = 256,
+    DM_OBS_FRAME_Q_STRIDE = 16,
+    DM_OBS_FRAME_NZCV_OFFSET = 768,
+    DM_OBS_FRAME_FPSR_OFFSET = 776,
+    DM_OBS_FRAME_FPCR_OFFSET = 784,
+    DM_OBS_FRAME_BYTES = 800,
+};
+
+typedef struct {
+    uint64_t x[DM_OBS_FRAME_X_COUNT];
+    uint64_t reserved_after_x;
+    uint8_t q[DM_OBS_FRAME_Q_COUNT][DM_OBS_FRAME_Q_STRIDE];
+    uint64_t nzcv;
+    uint64_t fpsr;
+    uint64_t fpcr;
+    uint64_t reserved_tail;
+} dm_obs_frame;
+
+_Static_assert(sizeof(float) == 4, "saved S lanes are 32-bit floats");
+_Static_assert(offsetof(dm_obs_frame, x) == 0, "saved GPR frame offset changed");
+_Static_assert(offsetof(dm_obs_frame, reserved_after_x) == 248, "saved frame padding after GPRs changed");
+_Static_assert(offsetof(dm_obs_frame, q) == DM_OBS_FRAME_Q_OFFSET, "saved Q frame offset changed");
+_Static_assert(offsetof(dm_obs_frame, nzcv) == DM_OBS_FRAME_NZCV_OFFSET, "saved NZCV offset changed");
+_Static_assert(offsetof(dm_obs_frame, fpsr) == DM_OBS_FRAME_FPSR_OFFSET, "saved FPSR offset changed");
+_Static_assert(offsetof(dm_obs_frame, fpcr) == DM_OBS_FRAME_FPCR_OFFSET, "saved FPCR offset changed");
+_Static_assert(offsetof(dm_obs_frame, reserved_tail) == 792, "saved frame tail changed");
+_Static_assert(sizeof(dm_obs_frame) == DM_OBS_FRAME_BYTES, "saved gate-frame size changed");
+
+// frame_bytes must describe the accessible buffer; this API can validate the
+// supplied length and S-register index, but C cannot discover allocation size.
+// The low 32 bits of Qn contain Sn on the supported little-endian Apple ARM64
+// host. memcpy avoids alignment and strict-aliasing assumptions.
+static inline bool dm_obs_frame_read_s(const void *frame, size_t frame_bytes,
+                                       unsigned sreg, float *value) {
+    if (!frame || !value || sreg >= DM_OBS_FRAME_Q_COUNT ||
+        frame_bytes < DM_OBS_FRAME_BYTES) return false;
+
+    float lane;
+    const uint8_t *bytes = (const uint8_t *)frame;
+    const size_t offset = DM_OBS_FRAME_Q_OFFSET + (size_t)sreg * DM_OBS_FRAME_Q_STRIDE;
+    memcpy(&lane, bytes + offset, sizeof lane);
+    *value = lane;
+    return true;
+}
+
+static inline bool dm_obs_frame_write_s(void *frame, size_t frame_bytes,
+                                        unsigned sreg, float value) {
+    if (!frame || sreg >= DM_OBS_FRAME_Q_COUNT ||
+        frame_bytes < DM_OBS_FRAME_BYTES) return false;
+
+    uint8_t *bytes = (uint8_t *)frame;
+    const size_t offset = DM_OBS_FRAME_Q_OFFSET + (size_t)sreg * DM_OBS_FRAME_Q_STRIDE;
+    memcpy(bytes + offset, &value, sizeof value);
+    return true;
+}
+
+#endif
