+        subprocess.run([xcrun, "clang", *target_flags, "-c", str(asm_path), "-o", str(assembler)], check=True)
+        subprocess.run([xcrun, "clang", *target_flags, "-std=c11", "-O1", "-UNDEBUG", "-Wall", "-Wextra", "-Werror",
+                        "-I", str(ROOT / "dm/host"), "-c", str(c_path), "-o", str(c_object)], check=True)
+        subprocess.run([xcrun, "clang", *target_flags, str(assembler), str(c_object), "-o", str(executable)], check=True)
+        subprocess.run([str(executable)], check=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
