diff --git a/dm/host/tests/t_obs_frame.c b/dm/host/tests/t_obs_frame.c
new file mode 100644
index 0000000..c40e232
--- /dev/null
+++ b/dm/host/tests/t_obs_frame.c
@@ -0,0 +1,52 @@
+#include "dm_obs_frame.h"
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+static void fill(uint8_t *bytes, size_t size) {
+    for (size_t i = 0; i < size; i++) bytes[i] = (uint8_t)(i * 37u + 11u);
+}
+
+int main(void) {
+    uint8_t frame[DM_OBS_FRAME_BYTES];
+    uint8_t original[DM_OBS_FRAME_BYTES];
+    uint8_t expected_lane[sizeof(float)];
+    float got = -7.0f;
+
+    assert(sizeof(dm_obs_frame) == DM_OBS_FRAME_BYTES);
+    fill(original, sizeof original);
+    for (unsigned reg = 0; reg < DM_OBS_FRAME_Q_COUNT; reg++) {
+        memcpy(frame, original, sizeof frame);
+        const float value = (float)reg + 0.25f;
+        memcpy(expected_lane, &value, sizeof value);
+        const size_t lane_offset = DM_OBS_FRAME_Q_OFFSET +
+                                   (size_t)reg * DM_OBS_FRAME_Q_STRIDE;
+
+        assert(dm_obs_frame_write_s(frame, sizeof frame, reg, value));
+        assert(dm_obs_frame_read_s(frame, sizeof frame, reg, &got));
+        assert(got == value);
+        for (size_t i = 0; i < sizeof frame; i++) {
+            const uint8_t expected = (i >= lane_offset && i < lane_offset + sizeof value)
+                ? expected_lane[i - lane_offset]
+                : original[i];
+            assert(frame[i] == expected);
+        }
+    }
+
+    memcpy(frame, original, sizeof frame);
+    got = 123.5f;
+    assert(!dm_obs_frame_read_s(NULL, sizeof frame, 2, &got));
+    assert(got == 123.5f);
+    assert(!dm_obs_frame_read_s(frame, sizeof frame, 2, NULL));
+    assert(!dm_obs_frame_read_s(frame, sizeof frame - 1, 2, &got));
+    assert(!dm_obs_frame_read_s(frame, sizeof frame, DM_OBS_FRAME_Q_COUNT, &got));
+    assert(!dm_obs_frame_write_s(NULL, sizeof frame, 2, 1.0f));
+    assert(!dm_obs_frame_write_s(frame, sizeof frame - 1, 2, 1.0f));
+    assert(!dm_obs_frame_write_s(frame, sizeof frame, DM_OBS_FRAME_Q_COUNT, 1.0f));
+    assert(memcmp(frame, original, sizeof frame) == 0);
+
+    puts("PASS: S-lane access validates null/length/index and changes only the selected low 32 bits");
+    return 0;
+}
diff --git a/dm/host/tests/t_odyssey_display_asset.c b/dm/host/tests/t_odyssey_display_asset.c
