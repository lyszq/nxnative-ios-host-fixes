+#define DM_ODYSSEY_BASE_RT_POOL_MIB 100u
+#define DM_ODYSSEY_BASE_GLOBAL_HEAP UINT32_C(0xc3000000)
+#define DM_ODYSSEY_PROJECTION_TRACE_OBJECT_CAP 32u
+#define DM_ODYSSEY_PROJECTION_TRACE_PERIOD UINT64_C(4096)
+#define DM_ODYSSEY_PROJECTION_TRACE_MAX_LOGS 8u
