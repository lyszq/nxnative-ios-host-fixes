+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define TEST_BUILD_ID "b424be150a8e7d78701cbe7a439d9ebf"
+
+static module_t fake_main;
+module_t *g_mod = &fake_main;
+int g_nmod = 1;
+
+static const char *g_case;
+static int g_missing_gate;
+static int g_no_display_gates;
+static int g_opmode = 1;
+static int g_highres_profile;
+static const char *g_selected_aspect = "4x3";
+static const char *g_selected_preset = "720p";
+static int g_gate_set_count;
+static int g_aspect_notifications;
+static void (*g_callbacks[OBS_MAX])(uint64_t *, int);
+
+int dm_opmode(void) { return g_opmode; }
+int gate_obs_present(int id) {
+    if (id <= 0 || id >= OBS_MAX) return 0;
+    if (g_no_display_gates && id >= OBS_ODYSSEY_PROJECTION && id <= OBS_ODYSSEY_CROP_SIZE) return 0;
+    if (id == g_missing_gate) return 0;
+    return id < OBS_ODYSSEY_RT_HEAP || g_highres_profile;
+}
+void gate_obs_set(int id, void (*fn)(uint64_t *, int)) {
+    assert(id > 0 && id < OBS_MAX && fn);
+    g_callbacks[id] = fn;
+    g_gate_set_count++;
+}
+void front_display_aspect_changed(void) { g_aspect_notifications++; }
+
+static void write_all(int fd, const void *data, size_t size) {
+    const char *p = data;
+    while (size) {
+        ssize_t n = write(fd, p, size);
+        assert(n > 0);
+        p += n;
+        size -= (size_t)n;
+    }
+}
+
+static void make_dir(const char *path) {
+    assert(mkdir(path, 0700) == 0 || errno == EEXIST);
+}
+
+static void sha256_hex(const char *data, size_t size, char out[65]) {
+    uint8_t digest[CC_SHA256_DIGEST_LENGTH];
+    assert(CC_SHA256(data, (CC_LONG)size, digest));
+    static const char hex[] = "0123456789abcdef";
+    for (size_t i = 0; i < sizeof digest; i++) {
+        out[i * 2] = hex[digest[i] >> 4];
+        out[i * 2 + 1] = hex[digest[i] & 15];
+    }
+    out[64] = 0;
+}
+
+static void write_manifest(const char *root) {
+    char path[PATH_MAX], digest[65];
+    assert(snprintf(path, sizeof path, "%s/profiles.tsv", root) < (int)sizeof path);
+    sha256_hex("abc", 3, digest);
+    FILE *f = fopen(path, "w");
+    assert(f);
+    fputs("#odyssey-display-v1\n", f);
+    static const struct { const char *preset, *aspect; unsigned width, height; } rows[] = {
+        {"stock", "16x9", 1600, 900}, {"stock", "4x3", 1200, 900},
+        {"720p", "16x9", 1280, 720}, {"720p", "4x3", 960, 720},
+        {"900p", "16x9", 1600, 900}, {"900p", "4x3", 1200, 900},
+        {"1080p", "16x9", 1920, 1080}, {"1080p", "4x3", 1440, 1080},
+        {"1440p", "16x9", 2560, 1440}, {"1440p", "4x3", 1920, 1440},
+        {"native", "16x9", 2732, 1536}, {"native", "4x3", 2732, 2048},
+    };
+    for (size_t i = 0; i < sizeof rows / sizeof rows[0]; i++)
+        fprintf(f, "%s\t%s\t%u\t%u\t%s\t3\n",
+                rows[i].preset, rows[i].aspect, rows[i].width, rows[i].height, digest);
+    assert(fclose(f) == 0);
+}
+
+static void write_selected_asset(const char *root, const char *aspect, const char *preset,
+                                 const char *bytes) {
+    char aspect_path[PATH_MAX], preset_path[PATH_MAX], system_path[PATH_MAX], file_path[PATH_MAX];
+    assert(snprintf(aspect_path, sizeof aspect_path, "%s/%s", root, aspect) < (int)sizeof aspect_path);
+    assert(snprintf(preset_path, sizeof preset_path, "%s/%s", aspect_path, preset) < (int)sizeof preset_path);
+    assert(snprintf(system_path, sizeof system_path, "%s/SystemData", preset_path) < (int)sizeof system_path);
+    assert(snprintf(file_path, sizeof file_path, "%s/ProjectGraphicsQuality.szs", system_path) < (int)sizeof file_path);
+    make_dir(aspect_path); make_dir(preset_path); make_dir(system_path);
+    int fd = open(file_path, O_CREAT | O_TRUNC | O_WRONLY, 0600);
+    assert(fd >= 0);
+    write_all(fd, bytes, 3);
+    assert(close(fd) == 0);
+}
+
+static int frame_equal_except(const uint8_t *before, const uint8_t *after,
+                              size_t bytes, size_t offset_a, size_t length_a,
+                              size_t offset_b, size_t length_b) {
+    for (size_t i = 0; i < bytes; i++) {
+        int changed = (i >= offset_a && i < offset_a + length_a) ||
+                     (i >= offset_b && i < offset_b + length_b);
+        if (!changed && before[i] != after[i]) return 0;
+    }
+    return 1;
+}
+
+static void test_dimension_callback(int id, unsigned reg_a, uint64_t value_a,
+                                    unsigned reg_b, uint64_t value_b,
+                                    uint32_t target_width, uint32_t target_height) {
+    _Alignas(16) uint64_t frame[DM_OBS_FRAME_BYTES / sizeof(uint64_t)];
+    uint8_t before[DM_OBS_FRAME_BYTES];
+    memset(frame, 0xa5, sizeof frame);
+    frame[reg_a] = value_a;
+    if (reg_b != UINT32_MAX) frame[reg_b] = value_b;
+    memcpy(before, frame, sizeof before);
+    assert(g_callbacks[id]);
+    g_callbacks[id](frame, 0);
+    assert(frame[reg_a] == (id == OBS_ODYSSEY_PACKED_SIZE
+                           ? ((uint64_t)target_width | ((uint64_t)target_height << 32)) : target_width));
+    if (reg_b != UINT32_MAX) assert(frame[reg_b] == target_height);
+    size_t first = reg_a * sizeof(uint64_t);
+    size_t second = reg_b == UINT32_MAX ? 0 : reg_b * sizeof(uint64_t);
+    size_t len_a = sizeof(uint64_t), len_b = reg_b == UINT32_MAX ? 0 : sizeof(uint64_t);
+    assert(frame_equal_except(before, (const uint8_t *)frame, sizeof before,
+                              first, len_a, second, len_b));
+
+    // A site whose original inputs differ from the pinned pair is a no-op.
+    frame[reg_a] = 123;
+    if (reg_b != UINT32_MAX) frame[reg_b] = 456;
+    memcpy(before, frame, sizeof before);
+    g_callbacks[id](frame, 0);
+    assert(memcmp(before, frame, sizeof before) == 0);
+}
+
+static void test_projection_callback(void) {
+    _Alignas(16) uint64_t frame[DM_OBS_FRAME_BYTES / sizeof(uint64_t)];
+    uint8_t before[DM_OBS_FRAME_BYTES];
+    memset(frame, 0x6b, sizeof frame);
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 0, 0.1f));
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 1, 1000.0f));
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 2, 1.125f));
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 3, 16.0f / 9.0f));
+    memcpy(before, frame, sizeof before);
+    g_callbacks[OBS_ODYSSEY_PROJECTION](frame, 0);
+    float fovy = 0, aspect = 0, expected_fovy = 0;
+    assert(dm_obs_frame_read_s(frame, sizeof frame, 2, &fovy));
+    assert(dm_obs_frame_read_s(frame, sizeof frame, 3, &aspect));
+    const float target_aspect = dm_odyssey_display_aspect();
+    assert(dm_vertical_fov_extend_16_9_to_aspect(1.125f, 16.0f / 9.0f,
+                                                  target_aspect, &expected_fovy) == DM_VERTICAL_FOV_TRANSFORMED);
+    assert(fabsf(fovy - expected_fovy) < 1e-6f);
+    assert(fabsf(aspect - target_aspect) < 1e-6f);
+    assert(frame_equal_except(before, (const uint8_t *)frame, sizeof before,
+                              DM_OBS_FRAME_Q_OFFSET + 2 * DM_OBS_FRAME_Q_STRIDE, sizeof(float),
+                              DM_OBS_FRAME_Q_OFFSET + 3 * DM_OBS_FRAME_Q_STRIDE, sizeof(float)));
+
+    // An already-target projection is outside this callback's 16:9 source contract.
+    memset(frame, 0x37, sizeof frame);
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 0, 0.1f));
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 1, 1000.0f));
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 2, 0.75f));
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 3, target_aspect));
+    memcpy(before, frame, sizeof before);
+    g_callbacks[OBS_ODYSSEY_PROJECTION](frame, 0);
+    assert(memcmp(before, frame, sizeof before) == 0);
+
+    // Other valid source aspects, such as a square offscreen projection, are
+    // also left alone by the 16:9-only transform.
+    memset(frame, 0x4c, sizeof frame);
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 0, 0.1f));
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 1, 1000.0f));
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 2, 0.75f));
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 3, 1.0f));
+    memcpy(before, frame, sizeof before);
+    g_callbacks[OBS_ODYSSEY_PROJECTION](frame, 0);
+    assert(memcmp(before, frame, sizeof before) == 0);
+}
+
+static void projection_trace_sample(uint64_t receiver) {
+    _Alignas(16) uint64_t frame[DM_OBS_FRAME_BYTES / sizeof(uint64_t)];
+    uint8_t before[DM_OBS_FRAME_BYTES];
+    memset(frame, 0xa5, sizeof frame);
+    frame[0] = receiver;
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 0, 0.1f));
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 1, 1000.0f));
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 2, 1.125f));
+    assert(dm_obs_frame_write_s(frame, sizeof frame, 3, 16.0f / 9.0f));
+    memcpy(before, frame, sizeof before);
+    g_callbacks[OBS_ODYSSEY_PROJECTION](frame, 0);
+    assert(frame_equal_except(before, (const uint8_t *)frame, sizeof before,
+                              DM_OBS_FRAME_Q_OFFSET + 2 * DM_OBS_FRAME_Q_STRIDE, sizeof(float),
+                              DM_OBS_FRAME_Q_OFFSET + 3 * DM_OBS_FRAME_Q_STRIDE, sizeof(float)));
+}
+
+static void test_projection_trace_bounds(void) {
+    // Invalid receiver is counted but does not consume one of the receiver slots.
+    projection_trace_sample(0);
+    // The callback's three existing samples occupy slots 1..3. Fill the table
+    // with 29 more receivers, then exercise a repeated receiver and one overflow.
+    for (uint64_t i = 0; i < 29; i++) projection_trace_sample(UINT64_C(0x1000) + i);
+    for (unsigned i = 0; i < 128; i++) projection_trace_sample(UINT64_C(0x1000));
+    projection_trace_sample(UINT64_C(0x2000));
+
+    // Cross nine periodic boundaries: only the configured first eight may log.
+    for (unsigned i = 0; i < 9u * 4096u; i++)
+        projection_trace_sample(UINT64_C(0x1000));
+}
+
+static void test_memory_callback(int id, unsigned reg, uint32_t expected) {
+    _Alignas(16) uint64_t frame[DM_OBS_FRAME_BYTES / sizeof(uint64_t)];
+    uint64_t before[DM_OBS_FRAME_BYTES / sizeof(uint64_t)];
+    for (size_t i = 0; i < sizeof frame / sizeof frame[0]; i++) frame[i] = UINT64_C(0xa5a5000000000000) + i;
+    assert(g_callbacks[id]);
+    g_callbacks[id](frame, 0);
+    assert(frame[reg] == expected);
+    for (size_t i = 0; i < sizeof frame / sizeof frame[0]; i++)
+        if (i != reg) assert(frame[i] == UINT64_C(0xa5a5000000000000) + i);
+    memcpy(before, frame, sizeof before);
+    g_callbacks[id](frame, 0);
+    assert(memcmp(before, frame, sizeof before) == 0);
+}
+
+static void test_pool_extra(uint32_t expected_extra_mib) {
+    const uint64_t base = UINT64_C(3120) * 1024 * 1024;
+    uint64_t total = 0;
+    const uint64_t extra = dm_odyssey_display_pool_extra();
+    assert(extra == (uint64_t)expected_extra_mib * 1024 * 1024);
+    assert(dm_odyssey_display_pool_total(base, extra, &total));
+    assert(total == base + extra);
+    assert(!dm_odyssey_display_pool_total(UINT64_MAX - 4, 5, &total));
+}
+
+static void assert_inactive(void) {
+    for (int i = 0; i < OBS_MAX; i++)
+        if (i != OBS_ODYSSEY_GLOBAL_HEAP) assert(!g_callbacks[i]);
+    assert(strcmp(getenv("DM_ROMFS_OVERLAY"), "/before/overlay") == 0);
+    assert(fabsf(dm_odyssey_display_aspect() - 16.0f / 9.0f) < 1e-6f);
+    assert(g_aspect_notifications == 0);
+    test_pool_extra(0);
+}
+
+int main(int argc, char **argv) {
+    assert(argc == 2);
+    g_case = argv[1];
+    strcpy(fake_main.name, "main");
+    strcpy(fake_main.build_id, TEST_BUILD_ID);
+
+    const int fatal_wrong_build = !strcmp(g_case, "high-wrong-build");
+    const int fatal_partial = !strcmp(g_case, "high-missing-gate");
+    if (fatal_wrong_build || fatal_partial) {
+        g_highres_profile = 1;
+        if (fatal_wrong_build) strcpy(fake_main.build_id, "ffffffffffffffffffffffffffffffff");
+        if (fatal_partial) g_missing_gate = OBS_ODYSSEY_RT_POOL;
+        // These invariants must be checked before parsing any setting or touching assets.
+        dm_odyssey_display_init();
+        return 3;
+    }
+
+    char root[] = "/tmp/odyssey-display-asset-XXXXXX";
+    assert(mkdtemp(root));
+    const char *resolution = "720p", *four_three = "1";
+    if (!strcmp(g_case, "stock") || !strcmp(g_case, "stock-high")) {
+        g_highres_profile = !strcmp(g_case, "stock-high");
+        resolution = "stock"; four_three = "0";
+    } else if (!strcmp(g_case, "default-1080p")) {
+        resolution = NULL; four_three = "0";
+        g_selected_aspect = "16x9"; g_selected_preset = "1080p";
+    } else if (!strcmp(g_case, "default-1080p-4x3")) {
+        resolution = NULL; four_three = "1";
+        g_selected_aspect = "4x3"; g_selected_preset = "1080p";
+    } else if (!strcmp(g_case, "default-missing-gates")) {
+        resolution = NULL; four_three = "0";
+        g_missing_gate = OBS_ODYSSEY_CROP_SIZE;
+    } else if (!strcmp(g_case, "default-wrong-build")) {
+        resolution = NULL; four_three = "0";
+        strcpy(fake_main.build_id, "ffffffffffffffffffffffffffffffff");
+    } else if (!strcmp(g_case, "default-no-gates")) {
+        resolution = NULL; four_three = "0";
+        g_no_display_gates = 1;
+        g_selected_aspect = "16x9"; g_selected_preset = "1080p";
+    } else if (!strcmp(g_case, "projection-trace")) {
+        resolution = "1080p"; four_three = "1";
+        g_selected_aspect = "4x3"; g_selected_preset = "1080p";
+    } else if (!strcmp(g_case, "invalid") || !strcmp(g_case, "invalid-high")) {
+        g_highres_profile = !strcmp(g_case, "invalid-high");
+        resolution = "2160p";
+    } else if (!strcmp(g_case, "bad-aspect")) {
+        four_three = "2";
+    } else if (!strcmp(g_case, "wrong-build")) {
+        strcpy(fake_main.build_id, "ffffffffffffffffffffffffffffffff");
+    } else if (!strcmp(g_case, "missing-gates")) {
+        g_missing_gate = OBS_ODYSSEY_CROP_SIZE;
+    } else if (!strcmp(g_case, "handheld")) {
+        g_opmode = 0;
+    } else if (!strcmp(g_case, "wide-active")) {
+        four_three = "0";
+        g_selected_aspect = "16x9";
+    } else if (!strcmp(g_case, "1440-wide")) {
+        g_highres_profile = 1; resolution = "1440p"; four_three = "0";
+        g_selected_aspect = "16x9"; g_selected_preset = "1440p";
+    } else if (!strcmp(g_case, "1440-4x3")) {
+        g_highres_profile = 1; resolution = "1440p";
+        g_selected_aspect = "4x3"; g_selected_preset = "1440p";
+    } else if (!strcmp(g_case, "native-wide")) {
+        g_highres_profile = 1; resolution = "native"; four_three = "0";
+        g_selected_aspect = "16x9"; g_selected_preset = "native";
+    } else if (!strcmp(g_case, "native-4x3")) {
+        g_highres_profile = 1; resolution = "native";
+        g_selected_aspect = "4x3"; g_selected_preset = "native";
+    } else if (!strcmp(g_case, "native-unsupported")) {
+        g_highres_profile = 1; resolution = "native";
+        g_selected_aspect = "4x3"; g_selected_preset = "native";
+    } else if (!strcmp(g_case, "high-missing-pair")) {
+        resolution = "1440p"; four_three = "0"; g_selected_aspect = "16x9"; g_selected_preset = "1440p";
+    } else if (!strcmp(g_case, "high-bad-hash") || !strcmp(g_case, "high-missing-asset")) {
+        g_highres_profile = 1; resolution = "native";
+        g_selected_aspect = "4x3"; g_selected_preset = "native";
+    } else if (!strcmp(g_case, "fd0-manifest") || !strcmp(g_case, "fd0-asset")) {
+        // Keep the 720p / 4:3 setting and deliberately omit one selected file.
+    } else if (!strcmp(g_case, "active") || !strcmp(g_case, "bad-hash")) {
+        // 720p / 4:3 default case.
+    } else {
+        fprintf(stderr, "unknown fixture scenario: %s\n", g_case);
+        return 2;
+    }
+
+    const int native_supported = strcmp(g_case, "native-unsupported") != 0;
+    assert(setenv("DM_ODYSSEY_NATIVE_PANEL", native_supported ? "1" : "0", 1) == 0);
+    assert(setenv("DM_ODYSSEY_DISPLAY_ROOT", root, 1) == 0);
+    assert(setenv("DM_ROMFS_OVERLAY", "/before/overlay", 1) == 0);
+    if (!strcmp(g_case, "projection-trace"))
+        assert(setenv("DM_ODYSSEY_PROJECTION_TRACE", "1", 1) == 0);
+    else
+        assert(unsetenv("DM_ODYSSEY_PROJECTION_TRACE") == 0);
+    if (resolution) assert(setenv("DM_ODYSSEY_RESOLUTION", resolution, 1) == 0);
+    else assert(unsetenv("DM_ODYSSEY_RESOLUTION") == 0);
+    assert(setenv("DM_ODYSSEY_4_3", four_three, 1) == 0);
+
+    const int has_invalid_config = !strcmp(g_case, "invalid") || !strcmp(g_case, "invalid-high") ||
+                                   !strcmp(g_case, "bad-aspect") || !strcmp(g_case, "wrong-build") ||
+                                   !strcmp(g_case, "missing-gates") || !strcmp(g_case, "handheld") ||
+                                   !strcmp(g_case, "default-missing-gates") ||
+                                   !strcmp(g_case, "default-wrong-build") ||
+                                   !strcmp(g_case, "stock") || !strcmp(g_case, "stock-high") ||
+                                   !strcmp(g_case, "native-unsupported") || !strcmp(g_case, "high-missing-pair");
+    const int fd0_case = !strcmp(g_case, "fd0-manifest") || !strcmp(g_case, "fd0-asset");
+    const int has_manifest = !has_invalid_config && !(!strcmp(g_case, "fd0-manifest"));
+    const int has_asset = !has_invalid_config && !(!strcmp(g_case, "fd0-manifest")) && !(!strcmp(g_case, "fd0-asset")) &&
+                          !(!strcmp(g_case, "high-missing-asset"));
+    if (has_manifest) write_manifest(root);
+    const int bad_hash = !strcmp(g_case, "bad-hash") || !strcmp(g_case, "high-bad-hash");
+    if (has_asset) write_selected_asset(root, g_selected_aspect, g_selected_preset, bad_hash ? "abd" : "abc");
+
+    char guard_path[PATH_MAX];
+    int original_stdin = -1;
+    if (fd0_case) {
+        assert(snprintf(guard_path, sizeof guard_path, "%s/guard", root) < (int)sizeof guard_path);
+        int guard = open(guard_path, O_CREAT | O_TRUNC | O_RDWR, 0600);
+        assert(guard >= 0);
+        char guard_data[1024]; memset(guard_data, 'x', sizeof guard_data);
+        write_all(guard, guard_data, sizeof guard_data);
+        assert(lseek(guard, 0, SEEK_SET) == 0);
+        original_stdin = dup(STDIN_FILENO);
+        assert(dup2(guard, STDIN_FILENO) == STDIN_FILENO);
+        close(guard);
+    }
+
+    dm_odyssey_display_init();
+
+    const int expected_active = !has_invalid_config && !g_no_display_gates && !fd0_case && !bad_hash &&
+                                strcmp(g_case, "high-missing-asset") != 0;
+    if (expected_active) {
+        const int high = g_highres_profile;
+        assert(g_gate_set_count == (high ? 7 : 4));
+        assert(g_callbacks[OBS_ODYSSEY_PROJECTION]);
+        assert(g_callbacks[OBS_ODYSSEY_PACKED_SIZE]);
+        assert(g_callbacks[OBS_ODYSSEY_CANVAS_SIZE]);
+        assert(g_callbacks[OBS_ODYSSEY_CROP_SIZE]);
+        if (high) {
+            assert(g_callbacks[OBS_ODYSSEY_RT_HEAP]);
+            assert(g_callbacks[OBS_ODYSSEY_RT_POOL]);
+            assert(g_callbacks[OBS_ODYSSEY_GLOBAL_HEAP]);
+        }
+        char expected_overlay[PATH_MAX * 2];
+        assert(snprintf(expected_overlay, sizeof expected_overlay, "%s/%s/%s:/before/overlay",
+                        root, g_selected_aspect, g_selected_preset) < (int)sizeof expected_overlay);
+        assert(strcmp(getenv("DM_ROMFS_OVERLAY"), expected_overlay) == 0);
+
+        dm_odyssey_display_config config;
+        assert(dm_odyssey_display_policy_parse(resolution ? resolution : "1080p",
+                                                four_three, &config));
+        const float expected_aspect = (float)config.width / (float)config.height;
+        assert(fabsf(dm_odyssey_display_aspect() - expected_aspect) < 1e-6f);
+        assert(g_aspect_notifications == (fabsf(expected_aspect - 16.0f / 9.0f) > 0.0001f));
+        test_dimension_callback(OBS_ODYSSEY_PACKED_SIZE, 9,
+                                (uint64_t)1600 | ((uint64_t)900 << 32), UINT32_MAX, 0,
+                                config.width, config.height);
+        test_dimension_callback(OBS_ODYSSEY_CANVAS_SIZE, 4, 1600, 5, 900,
+                                config.width, config.height);
+        test_dimension_callback(OBS_ODYSSEY_CROP_SIZE, 3, 1600, 4, 900,
+                                config.width, config.height);
+        if (fabsf(expected_aspect - 16.0f / 9.0f) > 0.0001f) test_projection_callback();
+        else {
+            _Alignas(16) uint64_t frame[DM_OBS_FRAME_BYTES / sizeof(uint64_t)];
+            uint8_t before[DM_OBS_FRAME_BYTES];
+            memset(frame, 0x5d, sizeof frame);
+            assert(dm_obs_frame_write_s(frame, sizeof frame, 2, 1.0f));
+            assert(dm_obs_frame_write_s(frame, sizeof frame, 3, 16.0f / 9.0f));
+            memcpy(before, frame, sizeof before);
+            g_callbacks[OBS_ODYSSEY_PROJECTION](frame, 0);
+            assert(memcmp(before, frame, sizeof before) == 0);
+        }
+        if (!strcmp(g_case, "projection-trace")) test_projection_trace_bounds();
+        test_pool_extra(config.app_pool_extra_mib);
+        if (high) {
+            test_memory_callback(OBS_ODYSSEY_RT_HEAP, 0,
+                                 config.rt_heap_mib * 1024u * 1024u);
+            test_memory_callback(OBS_ODYSSEY_RT_POOL, 8,
+                                 config.rt_pool_mib * 1024u * 1024u);
+            test_memory_callback(OBS_ODYSSEY_GLOBAL_HEAP, 0,
+                                 UINT32_C(0xc3000000) + config.app_pool_extra_mib * 1024u * 1024u);
+        }
+    } else {
+        assert_inactive();
+        if (g_highres_profile) {
+            assert(g_gate_set_count == 1);
+            assert(g_callbacks[OBS_ODYSSEY_GLOBAL_HEAP]);
+            test_memory_callback(OBS_ODYSSEY_GLOBAL_HEAP, 0, UINT32_C(0xc3000000));
+        } else {
+            assert(g_gate_set_count == 0);
+        }
+    }
+
+    if (fd0_case) {
+        assert(fcntl(STDIN_FILENO, F_GETFD) >= 0);
+        if (original_stdin >= 0) {
+            assert(dup2(original_stdin, STDIN_FILENO) == STDIN_FILENO);
+            close(original_stdin);
+        } else close(STDIN_FILENO);
+    }
+
+    char asset_path[PATH_MAX], system_path[PATH_MAX], preset_path[PATH_MAX], aspect_path[PATH_MAX];
+    assert(snprintf(aspect_path, sizeof aspect_path, "%s/%s", root, g_selected_aspect) < (int)sizeof aspect_path);
+    assert(snprintf(preset_path, sizeof preset_path, "%s/%s", aspect_path, g_selected_preset) < (int)sizeof preset_path);
+    assert(snprintf(system_path, sizeof system_path, "%s/SystemData", preset_path) < (int)sizeof system_path);
+    assert(snprintf(asset_path, sizeof asset_path, "%s/ProjectGraphicsQuality.szs", system_path) < (int)sizeof asset_path);
+    if (has_asset) { unlink(asset_path); rmdir(system_path); rmdir(preset_path); rmdir(aspect_path); }
+    if (has_manifest) { char path[PATH_MAX]; snprintf(path, sizeof path, "%s/profiles.tsv", root); unlink(path); }
+    if (fd0_case) unlink(guard_path);
+    assert(rmdir(root) == 0);
+    printf("PASS: Odyssey display fixture scenario %s\n", g_case);
+    return 0;
+}
diff --git a/dm/host/tests/t_odyssey_display_policy.c b/dm/host/tests/t_odyssey_display_policy.c
new file mode 100644
index 0000000..9c6f8ef
--- /dev/null
+++ b/dm/host/tests/t_odyssey_display_policy.c
@@ -0,0 +1,70 @@
+#include "dm_odyssey_display.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef struct {
+    const char *preset;
+    const char *four_three;
+    uint32_t width;
+    uint32_t height;
+    int active;
+} policy_case;
+
+int main(void) {
+    static const policy_case cases[] = {
+        {NULL, NULL, 1600, 900, 0},
+        {"stock", "0", 1600, 900, 0},
+        {"stock", "1", 1200, 900, 1},
+        {"720p", "0", 1280, 720, 1},
+        {"720p", "1", 960, 720, 1},
+        {"900p", "0", 1600, 900, 1},
+        {"900p", "1", 1200, 900, 1},
+        {"1080p", "0", 1920, 1080, 1},
+        {"1080p", "1", 1440, 1080, 1},
+        {"1440p", "0", 2560, 1440, 1},
+        {"1440p", "1", 1920, 1440, 1},
+        {"native", "0", 2732, 1536, 1},
+        {"native", "1", 2732, 2048, 1},
+    };
+    for (size_t i = 0; i < sizeof cases / sizeof cases[0]; i++) {
+        dm_odyssey_display_config config;
+        assert(dm_odyssey_display_policy_parse(cases[i].preset, cases[i].four_three, &config));
+        assert(config.width == cases[i].width && config.height == cases[i].height);
+        assert(config.active == cases[i].active);
+        assert(dm_odyssey_display_preset_name(config.preset));
+        assert(dm_odyssey_display_aspect_name(config.aspect));
+        if (config.highres) {
+            static const uint32_t pool[4] = {160, 128, 192, 256};
+            static const uint32_t extra[4] = {60, 28, 92, 156};
+            static const uint32_t heap[4] = {230, 198, 262, 326};
+            size_t slot = (config.preset == DM_ODYSSEY_PRESET_NATIVE ? 2 : 0) +
+                          (config.aspect == DM_ODYSSEY_ASPECT_4X3 ? 1 : 0);
+            assert(config.rt_pool_mib == pool[slot]);
+            assert(config.rt_heap_mib == heap[slot]);
+            assert(config.app_pool_extra_mib == extra[slot]);
+            assert(config.native_panel == (config.preset == DM_ODYSSEY_PRESET_NATIVE));
+        } else {
+            assert(config.rt_pool_mib == 0 && config.rt_heap_mib == 0 &&
+                   config.app_pool_extra_mib == 0 && !config.highres && !config.native_panel);
+        }
+    }
+
+    dm_odyssey_display_config rejected;
+    assert(!dm_odyssey_display_policy_parse("2160p", "0", &rejected));
+    assert(!dm_odyssey_display_policy_parse("720p", "true", &rejected));
+    assert(!dm_odyssey_display_policy_parse("stock", "", &rejected));
+    assert(!dm_odyssey_display_policy_parse("stock", "0", NULL));
+    uint64_t total = 0;
+    const uint64_t base = UINT64_C(3120) * 1024 * 1024;
+    assert(dm_odyssey_display_pool_total(base, UINT64_C(156) * 1024 * 1024, &total));
+    assert(total == UINT64_C(3276) * 1024 * 1024);
+    assert(dm_odyssey_display_pool_total(base, 0, &total) && total == base);
+    assert(!dm_odyssey_display_pool_total(UINT64_MAX - 3, 4, &total));
+    uint32_t mib = 0;
+    assert(dm_odyssey_display_add_mib(3120, 156, &mib) && mib == 3276);
+    assert(!dm_odyssey_display_add_mib(UINT32_MAX - 3, 4, &mib));
+    puts("PASS: Odyssey display policy maps only the twelve reviewed targets and checked pool increments");
+    return 0;
+}
diff --git a/dm/host/tests/t_vertical_fov.c b/dm/host/tests/t_vertical_fov.c
new file mode 100644
index 0000000..7b20304
--- /dev/null
+++ b/dm/host/tests/t_vertical_fov.c
@@ -0,0 +1,143 @@
+#include "dm_vertical_fov.h"
+
+#include <assert.h>
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define PI 3.14159265358979323846264338327950288
+
+static float rad(float degrees) { return (float)((double)degrees * PI / 180.0); }
+
+static void assert_horizontal_tangent(float fovy_in, float aspect_in,
+                                      float fovy_out, float aspect_out) {
+    const double before = (double)aspect_in * tan((double)fovy_in * 0.5);
+    const double after = (double)aspect_out * tan((double)fovy_out * 0.5);
+    assert(fabs(before - after) < 0.000001);
+}
+
+static void assert_invalid_preserves_output(float fovy, float source, float target) {
+    const uint32_t sentinel_bits = 0x3f123456u;
+    float out;
+    memcpy(&out, &sentinel_bits, sizeof out);
+    assert(dm_vertical_fov_preserve_horizontal(fovy, source, target, &out) ==
+           DM_VERTICAL_FOV_INVALID);
+    uint32_t after_bits;
+    memcpy(&after_bits, &out, sizeof after_bits);
+    assert(after_bits == sentinel_bits);
+}
+
+int main(void) {
+    const float wide = 16.0f / 9.0f;
+    const float classic = 4.0f / 3.0f;
+    const float sixty_degrees = rad(60.0f);
+    float out = -1.0f;
+
+    assert(dm_vertical_fov_preserve_horizontal(sixty_degrees, wide, classic, &out) ==
+           DM_VERTICAL_FOV_TRANSFORMED);
+    assert(fabs((double)out - 1.3121067481206792) < 0.000001);
+    assert_horizontal_tangent(sixty_degrees, wide, out, classic);
+
+    // Reverse aspect change shrinks vertical FOV but preserves horizontal extent.
+    float narrower = -1.0f;
+    assert(dm_vertical_fov_preserve_horizontal(out, classic, wide, &narrower) ==
+           DM_VERTICAL_FOV_TRANSFORMED);
+    assert(narrower < out);
+    assert_horizontal_tangent(out, classic, narrower, wide);
+
+    // Exact equal-aspect path is bit-identical and bypasses all math.
+    const float special = 0.73123455f;
+    uint32_t special_bits, out_bits;
+    memcpy(&special_bits, &special, sizeof special_bits);
+    out = -1.0f;
+    assert(dm_vertical_fov_preserve_horizontal(special, classic, classic, &out) ==
+           DM_VERTICAL_FOV_UNCHANGED);
+    memcpy(&out_bits, &out, sizeof out_bits);
+    assert(out_bits == special_bits);
+
+    // The 16:9->4:3 policy applies only to valid, matching aspects.
+    out = -1.0f;
+    assert(dm_vertical_fov_extend_16_9_to_4_3(sixty_degrees, wide, classic, &out) ==
+           DM_VERTICAL_FOV_TRANSFORMED);
+    assert_horizontal_tangent(sixty_degrees, wide, out, classic);
+    float repeated = -1.0f;
+    uint32_t repeated_bits;
+    assert(dm_vertical_fov_extend_16_9_to_4_3(sixty_degrees, wide, classic, &repeated) ==
+           DM_VERTICAL_FOV_TRANSFORMED);
+    memcpy(&out_bits, &out, sizeof out_bits);
+    memcpy(&repeated_bits, &repeated, sizeof repeated_bits);
+    assert(out_bits == repeated_bits);  // Same fresh input has no cached/recursive state.
+    out = -1.0f;
+    assert(dm_vertical_fov_extend_16_9_to_4_3(sixty_degrees, 1.0f, classic, &out) ==
+           DM_VERTICAL_FOV_SKIPPED);
+    assert(out == sixty_degrees);  // Known square-aspect caller stays unchanged.
+    out = -1.0f;
+    assert(dm_vertical_fov_extend_16_9_to_4_3(special, classic, classic, &out) ==
+           DM_VERTICAL_FOV_UNCHANGED);
+    memcpy(&out_bits, &out, sizeof out_bits);
+    assert(out_bits == special_bits);
+    out = -1.0f;
+    assert(dm_vertical_fov_extend_16_9_to_4_3(sixty_degrees, wide, 2.0f, &out) ==
+           DM_VERTICAL_FOV_SKIPPED);
+    assert(out == sixty_degrees);
+    out = -1.0f;
+    assert(dm_vertical_fov_extend_16_9_to_4_3(sixty_degrees, wide + 0.00005f,
+                                               classic - 0.00005f, &out) ==
+           DM_VERTICAL_FOV_TRANSFORMED);
+
+    // The runtime's generic policy accepts the two reviewed native ratios,
+    // while still filtering to incoming 16:9 projections.
+    const float native_4x3 = 2732.0f / 2048.0f;
+    const float native_16x9 = 2732.0f / 1536.0f;
+    out = -1.0f;
+    assert(dm_vertical_fov_extend_16_9_to_aspect(sixty_degrees, wide, native_4x3, &out) ==
+           DM_VERTICAL_FOV_TRANSFORMED);
+    assert_horizontal_tangent(sixty_degrees, wide, out, native_4x3);
+    out = -1.0f;
+    assert(dm_vertical_fov_extend_16_9_to_aspect(sixty_degrees, wide, native_16x9, &out) ==
+           DM_VERTICAL_FOV_TRANSFORMED);
+    assert_horizontal_tangent(sixty_degrees, wide, out, native_16x9);
+    out = -1.0f;
+    assert(dm_vertical_fov_extend_16_9_to_aspect(sixty_degrees, 1.0f, native_4x3, &out) ==
+           DM_VERTICAL_FOV_SKIPPED && out == sixty_degrees);
+    out = -1.0f;
+    assert(dm_vertical_fov_extend_16_9_to_aspect(special, native_4x3, native_4x3, &out) ==
+           DM_VERTICAL_FOV_UNCHANGED);
+    memcpy(&out_bits, &out, sizeof out_bits);
+    assert(out_bits == special_bits);
+
+    assert_invalid_preserves_output(0.0f, wide, classic);
+    assert_invalid_preserves_output(-0.1f, wide, classic);
+    assert_invalid_preserves_output((float)PI, wide, classic);
+    assert_invalid_preserves_output(NAN, wide, classic);
+    assert_invalid_preserves_output(INFINITY, wide, classic);
+    assert_invalid_preserves_output(sixty_degrees, 0.0f, classic);
+    assert_invalid_preserves_output(sixty_degrees, wide, -1.0f);
+    assert_invalid_preserves_output(sixty_degrees, NAN, classic);
+    assert_invalid_preserves_output(sixty_degrees, wide, INFINITY);
+    const float smallest_positive = nextafterf(0.0f, 1.0f);
+    assert_invalid_preserves_output(smallest_positive, wide, classic);
+    const float small_representable_fovy = 0.0001f;
+    out = -1.0f;
+    assert(dm_vertical_fov_preserve_horizontal(small_representable_fovy, wide, classic, &out) ==
+           DM_VERTICAL_FOV_TRANSFORMED);
+    assert(out > 0.0f && isfinite(out));
+    const float closest_float_below_pi = nextafterf((float)PI, 0.0f);
+    assert_invalid_preserves_output(closest_float_below_pi, wide, classic);
+    // Still accept a large FOV when the transformed float preserves geometry.
+    const float large_fovy = rad(170.0f);
+    out = -1.0f;
+    assert(dm_vertical_fov_preserve_horizontal(large_fovy, wide, classic, &out) ==
+           DM_VERTICAL_FOV_TRANSFORMED);
+    const double large_before = (double)wide * tan((double)large_fovy * 0.5);
+    const double large_after = (double)classic * tan((double)out * 0.5);
+    assert(fabs(large_before - large_after) / large_before < 0.00001);
+    out = 12.0f;
+    assert(dm_vertical_fov_preserve_horizontal(sixty_degrees, wide, classic, NULL) ==
+           DM_VERTICAL_FOV_INVALID);
+    assert(out == 12.0f);
+
+    puts("PASS: horizontal-FOV geometry, 16:9-to-4:3 eligibility, exact identity, and invalid edges");
+    return 0;
+}
