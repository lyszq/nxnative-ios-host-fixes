+    configured = os.environ.get("CC")
+    if configured:
+        return shlex.split(configured)
+    for name in ("clang", "gcc", "cc"):
+        found = shutil.which(name)
+        if found:
+            return [found]
+    zig = shutil.which("zig")
+    if zig:
+        return [zig, "cc"]
