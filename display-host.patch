+    memcpy(q_input + 3 * 16, &input_aspect, sizeof input_aspect);
+    memset(q_output, 0, sizeof q_output);
+    dm_test_invoke_gate(q_input, q_output, initial_nzcv, initial_fpsr, initial_fpcr, status_after, gpr_after);
+    assert(callback_count == 1);
+
+    uint8_t expected_q[sizeof q_input];
+    memcpy(expected_q, q_input, sizeof expected_q);
+    memcpy(expected_q + 2 * 16, &changed_fovy, sizeof changed_fovy);
+    memcpy(expected_q + 3 * 16, &changed_aspect, sizeof changed_aspect);
+    assert(memcmp(q_output, expected_q, sizeof expected_q) == 0);
+    assert(status_after[0] == initial_nzcv);
+    assert(status_after[1] == initial_fpsr);
+    assert(status_after[2] == initial_fpcr);
+    for (unsigned i = 0; i < 18; i++)
+        assert(gpr_after[i] == (i == 9 ? changed_x9 : UINT64_C(0x100) + i));
+    for (unsigned i = 19; i < 30; i++) assert(gpr_after[i] == UINT64_C(0x100) + i);
+    assert(gpr_after[30] == expected_x30);
+
+    const uint64_t entry_pair[2] = {0x1122334455667788u, 0x99aabbccddeeff00u};
+    uint64_t entry_saved[3] = {0, 0, 0};
+    assert(dm_test_replay_projection_entry(entry_pair, entry_saved) == 1);
+    assert(entry_saved[0] == entry_pair[1]);  // STP d11,d10 stores d11 first.
+    assert(entry_saved[1] == entry_pair[0]);
+    assert(entry_saved[2] == 64);             // Exact instruction's pre-index stack delta.
