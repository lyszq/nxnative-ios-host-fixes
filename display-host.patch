+#ifndef DM_ODYSSEY_DISPLAY_H
+#define DM_ODYSSEY_DISPLAY_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+// Shell packaging requires display-aware high-gate restoration from ABI 2.
+#define DM_ODYSSEY_DISPLAY_ABI 2
+
+typedef enum {
+    DM_ODYSSEY_PRESET_STOCK = 0,
+    DM_ODYSSEY_PRESET_720P,
+    DM_ODYSSEY_PRESET_900P,
+    DM_ODYSSEY_PRESET_1080P,
+    DM_ODYSSEY_PRESET_1440P,
+    DM_ODYSSEY_PRESET_NATIVE,
+    DM_ODYSSEY_PRESET_COUNT,
+} dm_odyssey_preset;
+
+typedef enum {
+    DM_ODYSSEY_ASPECT_16X9 = 0,
+    DM_ODYSSEY_ASPECT_4X3,
+} dm_odyssey_aspect;
+
+typedef struct {
+    dm_odyssey_preset preset;
+    dm_odyssey_aspect aspect;
+    uint32_t width;
+    uint32_t height;
+    uint32_t rt_pool_mib;       // nonzero only above the shipped 1080p pool threshold
+    uint32_t rt_heap_mib;       // pool plus the game's fixed 70 MiB allocator overhead
+    uint32_t app_pool_extra_mib; // render-target pool increase above the shipped 100 MiB
+    int active;
+    int highres;
+    int native_panel;
+} dm_odyssey_display_config;
+
+// Parse only the launcher's finite option set. NULL means the tested defaults:
+// stock resolution and 16:9. Returns 1 on a valid configuration, 0 otherwise.
+int dm_odyssey_display_policy_parse(const char *resolution,
+                                    const char *four_three,
+                                    dm_odyssey_display_config *out);
+
+const char *dm_odyssey_display_preset_name(dm_odyssey_preset preset);
+const char *dm_odyssey_display_aspect_name(dm_odyssey_aspect aspect);
+
+// Reads the exact twelve-row profiles.tsv format and verifies the selected
+// regular asset's declared length and SHA-256. The returned overlay root is
+// made only from the validated aspect/preset enums, never from manifest text.
+int dm_odyssey_display_validate_asset(const char *root,
+                                      const dm_odyssey_display_config *config,
+                                      char *overlay_root, size_t overlay_root_size,
+                                      char *error, size_t error_size);
+
+void dm_odyssey_display_init(void);  // after launcher and the early preloader join, before guest constructors
+uint64_t dm_odyssey_display_pool_extra(void);  // accepted high-resolution increment, otherwise zero
+int dm_odyssey_display_pool_total(uint64_t cached_base, uint64_t extra, uint64_t *total);
+int dm_odyssey_display_add_mib(uint32_t base_mib, uint32_t extra_mib, uint32_t *total_mib);
+
+#endif
