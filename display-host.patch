+
+typedef nvn_lookahead_totals nvn_lookahead_frame;
+
+// Preserve unknown values when a cumulative counter is invalid or reset.
+static inline int nvn_timing_lookahead_frame_delta(const nvn_lookahead_totals *previous,
+                                                    const nvn_lookahead_totals *current,
+                                                    nvn_lookahead_frame *out) {
+    if (!out) return 0;
+    *out = (nvn_lookahead_frame){0};
+    if (!previous || !current ||
+        current->predict_calls < previous->predict_calls ||
+        current->predict_ns < previous->predict_ns ||
+        current->prefetch_batches < previous->prefetch_batches ||
+        current->prefetch_keys < previous->prefetch_keys ||
+        current->prefetch_libs < previous->prefetch_libs ||
+        current->prefetch_wall_ns < previous->prefetch_wall_ns ||
+        current->prefetch_item_ns < previous->prefetch_item_ns) return 0;
+
+    out->predict_calls = current->predict_calls - previous->predict_calls;
+    out->predict_ns = current->predict_ns - previous->predict_ns;
+    out->prefetch_batches = current->prefetch_batches - previous->prefetch_batches;
+    out->prefetch_keys = current->prefetch_keys - previous->prefetch_keys;
+    out->prefetch_libs = current->prefetch_libs - previous->prefetch_libs;
+    out->prefetch_wall_ns = current->prefetch_wall_ns - previous->prefetch_wall_ns;
+    out->prefetch_item_ns = current->prefetch_item_ns - previous->prefetch_item_ns;
+    return 1;
