+        r"(?m)^static int g_nsbw, g_sbw_over;[^\n]*$",
+        r"(?m)^static uint64_t g_sbw_wlo\[SBW_WN\], g_sbw_whi\[SBW_WN\]; static int g_nsbw_w;[^\n]*$",
+        r"(?m)^enum \{ SBW_GPU = 1, SBW_REPORT = 2 \};$",
+        r"(?m)^static uint32_t g_sbw_gen;[^\n]*$",
