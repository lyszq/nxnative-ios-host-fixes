+        print("SKIP: native _dm_gate fixture requires Xcode clang")
+        return 77
+
+    entry_path = ROOT / "dm/host/entry.S"
+    entry = entry_path.read_text(encoding="utf-8")
+    try:
+        assembly = build_assembly(entry)
+    except ValueError as exc:
+        raise SystemExit(str(exc)) from exc
+    harness = r'''#include "dm_obs_frame.h"
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+extern void dm_test_invoke_gate(const uint8_t *, uint8_t *, uint64_t, uint64_t,
+                                uint64_t, uint64_t *, uint64_t *);
+extern int dm_test_replay_projection_entry(const uint64_t *, uint64_t *);
+
+static _Alignas(16) uint8_t q_input[32 * 16];
+static _Alignas(16) uint8_t q_output[32 * 16];
+static uint8_t frame_before[DM_OBS_FRAME_BYTES];
+static uint64_t status_after[3];
+static uint64_t gpr_after[31];
+static uint64_t expected_x30;
+static const uint64_t changed_x9 = UINT64_C(0x9abcdef012345678);
+static const uint64_t initial_nzcv = 0xa0000000u;
+static const uint64_t initial_fpsr = 0x00000011u;
+static const uint64_t initial_fpcr = 0x00400000u;
+static int callback_count;
+static const float input_fovy = 1.125f;
+static const float input_aspect = 16.0f / 9.0f;
+static const float changed_fovy = 1.375f;
+static const float changed_aspect = 4.0f / 3.0f;
+
+uint64_t gate_dispatch(uint64_t ret_addr, uint64_t *regs) {
+    assert(ret_addr != 0);
+    expected_x30 = ret_addr;
+    assert(regs != NULL);
+    callback_count++;
+    memcpy(frame_before, regs, sizeof frame_before);
+    assert(memcmp((const uint8_t *)regs + DM_OBS_FRAME_Q_OFFSET,
