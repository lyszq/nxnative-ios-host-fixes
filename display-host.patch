+++ b/dm/host/dm_odyssey_display_policy.c
@@ -0,0 +1,97 @@
+#include "dm_odyssey_display.h"
+
+#include <string.h>
+
+const char *dm_odyssey_display_preset_name(dm_odyssey_preset preset) {
+    static const char *const names[DM_ODYSSEY_PRESET_COUNT] = {
+        "stock", "720p", "900p", "1080p", "1440p", "native",
+    };
+    return preset >= 0 && preset < DM_ODYSSEY_PRESET_COUNT ? names[preset] : NULL;
+}
+
+const char *dm_odyssey_display_aspect_name(dm_odyssey_aspect aspect) {
+    switch (aspect) {
+        case DM_ODYSSEY_ASPECT_16X9: return "16x9";
+        case DM_ODYSSEY_ASPECT_4X3: return "4x3";
+        default: return NULL;
+    }
+}
+
+static int parse_preset(const char *value, dm_odyssey_preset *preset) {
+    if (!value || !strcmp(value, "stock")) *preset = DM_ODYSSEY_PRESET_STOCK;
+    else if (!strcmp(value, "720p")) *preset = DM_ODYSSEY_PRESET_720P;
+    else if (!strcmp(value, "900p")) *preset = DM_ODYSSEY_PRESET_900P;
+    else if (!strcmp(value, "1080p")) *preset = DM_ODYSSEY_PRESET_1080P;
+    else if (!strcmp(value, "1440p")) *preset = DM_ODYSSEY_PRESET_1440P;
+    else if (!strcmp(value, "native")) *preset = DM_ODYSSEY_PRESET_NATIVE;
+    else return 0;
+    return 1;
+}
+
+static int parse_aspect(const char *value, dm_odyssey_aspect *aspect) {
+    if (!value || !strcmp(value, "0")) *aspect = DM_ODYSSEY_ASPECT_16X9;
+    else if (!strcmp(value, "1")) *aspect = DM_ODYSSEY_ASPECT_4X3;
+    else return 0;
+    return 1;
+}
+
+static void dimensions(dm_odyssey_preset preset, dm_odyssey_aspect aspect,
+                      uint32_t *width, uint32_t *height) {
+    static const uint16_t wide[DM_ODYSSEY_PRESET_COUNT][2] = {
+        {1600, 900}, {1280, 720}, {1600, 900}, {1920, 1080},
+        {2560, 1440}, {2732, 1536},
+    };
+    static const uint16_t classic[DM_ODYSSEY_PRESET_COUNT][2] = {
+        {1200, 900}, {960, 720}, {1200, 900}, {1440, 1080},
+        {1920, 1440}, {2732, 2048},
+    };
+    const uint16_t (*selected)[2] = aspect == DM_ODYSSEY_ASPECT_4X3 ? classic : wide;
+    *width = selected[preset][0];
+    *height = selected[preset][1];
+}
+
+int dm_odyssey_display_policy_parse(const char *resolution,
+                                    const char *four_three,
+                                    dm_odyssey_display_config *out) {
+    if (!out) return 0;
+
+    dm_odyssey_display_config config = {0};
+    if (!parse_preset(resolution, &config.preset) ||
+        !parse_aspect(four_three, &config.aspect)) return 0;
+
+    if (config.preset < 0 || config.preset >= DM_ODYSSEY_PRESET_COUNT ||
+        (config.aspect != DM_ODYSSEY_ASPECT_16X9 && config.aspect != DM_ODYSSEY_ASPECT_4X3)) return 0;
+    dimensions(config.preset, config.aspect, &config.width, &config.height);
+    config.active = config.preset != DM_ODYSSEY_PRESET_STOCK ||
+                    config.aspect == DM_ODYSSEY_ASPECT_4X3;
+    config.highres = config.preset == DM_ODYSSEY_PRESET_1440P ||
+                     config.preset == DM_ODYSSEY_PRESET_NATIVE;
+    config.native_panel = config.preset == DM_ODYSSEY_PRESET_NATIVE;
+    if (config.highres) {
+        // Exact profiles from the reviewed pool plan, derived from the pinned
+        // reference sizing rule. This is a sizing contract, not device proof.
+        static const uint16_t pool_mib[2][2] = {
+            {160, 192}, // 1440p / native, 16:9
+            {128, 256}, // 1440p / native, 4:3
+        };
+        const unsigned a = config.aspect == DM_ODYSSEY_ASPECT_4X3;
+        const unsigned p = config.preset == DM_ODYSSEY_PRESET_NATIVE;
+        config.rt_pool_mib = pool_mib[a][p];
+        if (!dm_odyssey_display_add_mib(config.rt_pool_mib, 70u, &config.rt_heap_mib)) return 0;
+        config.app_pool_extra_mib = config.rt_pool_mib - 100u;
+    }
+    *out = config;
+    return 1;
+}
+
+int dm_odyssey_display_pool_total(uint64_t cached_base, uint64_t extra, uint64_t *total) {
+    if (!total || UINT64_MAX - cached_base < extra) return 0;
+    *total = cached_base + extra;
+    return 1;
+}
+
+int dm_odyssey_display_add_mib(uint32_t base_mib, uint32_t extra_mib, uint32_t *total_mib) {
+    if (!total_mib || UINT32_MAX - base_mib < extra_mib) return 0;
+    *total_mib = base_mib + extra_mib;
+    return 1;
+}
diff --git a/dm/host/dm_vertical_fov.c b/dm/host/dm_vertical_fov.c
new file mode 100644
index 0000000..5426c6e
--- /dev/null
+++ b/dm/host/dm_vertical_fov.c
@@ -0,0 +1,93 @@
+#include "dm_vertical_fov.h"
+
+#include <math.h>
+
+#define DM_VERTICAL_FOV_PI 3.14159265358979323846264338327950288
+#define DM_VERTICAL_FOV_ASPECT_TOLERANCE 0.0001
+#define DM_VERTICAL_FOV_RELATIVE_GEOMETRY_TOLERANCE 0.00001
+
+static int valid_fovy(float fovy) {
+    return isfinite((double)fovy) && fovy > 0.0f &&
+           (double)fovy < DM_VERTICAL_FOV_PI;
+}
+
+static int valid_aspect(float aspect) {
+    return isfinite((double)aspect) && aspect > 0.0f;
+}
+
+static int aspect_near(float actual, double expected) {
+    return fabs((double)actual - expected) <= DM_VERTICAL_FOV_ASPECT_TOLERANCE;
+}
+
+dm_vertical_fov_result dm_vertical_fov_preserve_horizontal(
+        float fovy_radians, float source_aspect, float target_aspect,
+        float *out_fovy_radians) {
+    if (!out_fovy_radians || !valid_fovy(fovy_radians) ||
+        !valid_aspect(source_aspect) || !valid_aspect(target_aspect)) {
+        return DM_VERTICAL_FOV_INVALID;
+    }
+
+    if (source_aspect == target_aspect) {
+        *out_fovy_radians = fovy_radians;
+        return DM_VERTICAL_FOV_UNCHANGED;
+    }
+
+    const double half_fovy = (double)fovy_radians * 0.5;
+    const double horizontal_tangent = (double)source_aspect / (double)target_aspect * tan(half_fovy);
+    const double result = 2.0 * atan(horizontal_tangent);
+    const float narrowed = (float)result;
+    if (!isfinite(result) || !isfinite((double)narrowed) || narrowed <= 0.0f ||
+        (double)narrowed >= DM_VERTICAL_FOV_PI) {
+        return DM_VERTICAL_FOV_INVALID;
+    }
+
+    const double before = (double)source_aspect * tan(half_fovy);
+    const double after = (double)target_aspect * tan((double)narrowed * 0.5);
+    if (!isfinite(before) || !isfinite(after) || before <= 0.0 || after <= 0.0 ||
+        fabs(after - before) / before > DM_VERTICAL_FOV_RELATIVE_GEOMETRY_TOLERANCE) {
+        return DM_VERTICAL_FOV_INVALID;
+    }
+
+    *out_fovy_radians = narrowed;
+    return DM_VERTICAL_FOV_TRANSFORMED;
+}
+
+dm_vertical_fov_result dm_vertical_fov_extend_16_9_to_4_3(
+        float fovy_radians, float source_aspect, float target_aspect,
+        float *out_fovy_radians) {
+    if (!out_fovy_radians || !valid_fovy(fovy_radians) ||
+        !valid_aspect(source_aspect) || !valid_aspect(target_aspect))
+        return DM_VERTICAL_FOV_INVALID;
+    if (source_aspect == target_aspect) {
+        *out_fovy_radians = fovy_radians;
+        return DM_VERTICAL_FOV_UNCHANGED;
+    }
+    if (!aspect_near(target_aspect, 4.0 / 3.0)) {
+        *out_fovy_radians = fovy_radians;
+        return DM_VERTICAL_FOV_SKIPPED;
+    }
+    return dm_vertical_fov_extend_16_9_to_aspect(
+        fovy_radians, source_aspect, target_aspect, out_fovy_radians);
+}
+
+dm_vertical_fov_result dm_vertical_fov_extend_16_9_to_aspect(
+        float fovy_radians, float source_aspect, float target_aspect,
+        float *out_fovy_radians) {
+    if (!out_fovy_radians || !valid_fovy(fovy_radians) ||
+        !valid_aspect(source_aspect) || !valid_aspect(target_aspect)) {
+        return DM_VERTICAL_FOV_INVALID;
+    }
+
+    if (source_aspect == target_aspect) {
+        *out_fovy_radians = fovy_radians;
+        return DM_VERTICAL_FOV_UNCHANGED;
+    }
+
+    if (!aspect_near(source_aspect, 16.0 / 9.0)) {
+        *out_fovy_radians = fovy_radians;
+        return DM_VERTICAL_FOV_SKIPPED;
+    }
+
+    return dm_vertical_fov_preserve_horizontal(
+        fovy_radians, source_aspect, target_aspect, out_fovy_radians);
+}
diff --git a/dm/host/dm_vertical_fov.h b/dm/host/dm_vertical_fov.h
new file mode 100644
index 0000000..0eb5362
--- /dev/null
+++ b/dm/host/dm_vertical_fov.h
@@ -0,0 +1,35 @@
+#ifndef DM_VERTICAL_FOV_H
+#define DM_VERTICAL_FOV_H
+
+// Stateless geometry helpers for a vertical-FOV extension. These are not
+// connected to the runtime or enabled by any game profile.
+typedef enum {
+    DM_VERTICAL_FOV_INVALID = 0,
+    DM_VERTICAL_FOV_UNCHANGED,
+    DM_VERTICAL_FOV_TRANSFORMED,
+    DM_VERTICAL_FOV_SKIPPED,
+} dm_vertical_fov_result;
+
+// Keep horizontal half-FOV tangent constant while changing aspect. The output
+// is written only for valid input; equal aspects return the input float exactly.
+// A result that float precision cannot represent within the geometry tolerance
+// is rejected rather than returned with a materially different horizontal view.
+dm_vertical_fov_result dm_vertical_fov_preserve_horizontal(
+    float fovy_radians, float source_aspect, float target_aspect,
+    float *out_fovy_radians);
+
+// Conservative prototype policy: only extend a valid 16:9 input to 4:3.
+// Square, offscreen, and other aspect paths are skipped with the original FOV.
+// The aspect comparison tolerance handles float representation of 16/9 and 4/3.
+dm_vertical_fov_result dm_vertical_fov_extend_16_9_to_4_3(
+    float fovy_radians, float source_aspect, float target_aspect,
+    float *out_fovy_radians);
+
+// Runtime policy used by the display profile: accept only finite 16:9 input,
+// then preserve horizontal coverage at any validated target viewport ratio.
+// Existing target-aspect and non-16:9 projections are returned unchanged.
+dm_vertical_fov_result dm_vertical_fov_extend_16_9_to_aspect(
+    float fovy_radians, float source_aspect, float target_aspect,
+    float *out_fovy_radians);
+
+#endif
