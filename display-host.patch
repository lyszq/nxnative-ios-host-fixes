+    uint64_t separate = base + 0x20000000ull;
+    sbw_note(separate, wide, SBW_GPU);
+    expect(g_nsbw_w == 2, "a non-overlapping pool remains a separate interval");
+    expect(!sbw_hits(b_hi + 1, separate - 1), "unwritten memory between pools is not covered");
