+
+static void clear_forwarded(void) { g_forwarded_n = 0; }
+
+static void test_bound_length(void) {
+    expect(sbw_bound_len(24, 100, 20) == 24, "nonzero binding size is preserved");
+    expect(sbw_bound_len(0, 100, 20) == 80, "size zero is the remaining buffer length");
+    expect(sbw_bound_len(0, 100, 100) == 0, "offset at buffer end has no remaining bytes");
+    expect(sbw_bound_len(0, 100, 101) == 0, "offset beyond buffer end is empty");
