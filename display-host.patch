+    expect(!sbw_hits(base + 0x100, base + 0x110), "counter report is not a current GPU write");
+    gw_commit(41);
+    expect(g_forwarded_n == 1, "report page still forwards to later submissions");
+    expect(g_forwarded_n == 1 && g_forwarded[0].lo == base &&
+           g_forwarded[0].hi == base + 0x1000 && g_forwarded[0].fence == 41,
+           "report page keeps the prior page-granular fence semantics");
+
+    pend_reset();
+    sbw_note(base + 0x100, 16, SBW_GPU);
+    expect(g_sbw_gen == 1, "GPU write advances the shadow generation");
+    expect(sbw_hits(base + 0x800, base + 0x801), "small GPU writes remain page-granular");
+    expect(!sbw_hits(base + 0x1000, base + 0x1001), "a different pool page does not alias");
+}
+
+static void test_known_zero_size_range_and_pool_isolation(void) {
+    pend_reset();
+    uint64_t base = 0x200000000ull;
+    uint64_t len = sbw_bound_len(0, 0x100000, 0x2000);
+    sbw_note(base + 0x2000, len, SBW_GPU);
+    expect(len == 0xfe000, "known buffer offset yields the exact remaining byte count");
+    expect(g_nsbw_w == 1 && !g_sbw_over, "large known remainder is tracked as one interval");
+    expect(sbw_hits(base + 0x2000, base + 0x2001), "the beginning of the known remainder is covered");
+    expect(sbw_hits(base + 0xfffff, base + 0x100000), "the last byte of the known remainder is covered");
+    expect(!sbw_hits(base + 0x1fff, base + 0x2000), "the byte before the remainder is not covered");
+    expect(!sbw_hits(base + 0x100000, base + 0x100001), "the byte after the remainder is not covered");
+    expect(!sbw_hits(0x300000000ull, 0x300000001ull), "a separate pool does not overlap the interval");
+    expect(!g_sbw_over, "known bounded writes avoid the global fallback");
+}
+
+static int range_present(uint64_t lo, uint64_t hi) {
+    for (int i = 0; i < g_forwarded_n; i++)
+        if (g_forwarded[i].lo == lo && g_forwarded[i].hi == hi) return 1;
+    return 0;
+}
+
+static void test_transitive_merge_and_forwarding(void) {
+    pend_reset();
+    clear_forwarded();
+    uint64_t base = 0x400000000ull;
+    uint64_t wide = (uint64_t)SBW_WPAGES * 4096 + 1;
+    uint64_t a_hi = base + wide;
+    uint64_t b_lo = a_hi + 80 * 4096;
+    uint64_t b_hi = b_lo + wide;
+    sbw_note(base, wide, SBW_GPU);
+    sbw_note(b_lo, wide, SBW_GPU);
