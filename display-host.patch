+#!/usr/bin/env python3
+"""Compile the exact NVN storage-write bookkeeping helpers as a small native C fixture.
+
+The fixture reads only the checked-out source and fails if the required production
+helpers are missing. It never patches or edits the checkout.
+"""
+from __future__ import annotations
+
+import os
+import re
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[3]
+SOURCE_REL = Path("dm/gfx/nvn/nvn_mtl.m")
+
+
+def _extract_function(source: str, name: str) -> str:
+    """Return one static C function, balancing braces while skipping comments/strings."""
+    pattern = re.compile(
+        rf"(?m)^static\s+[^;\n]*\b{re.escape(name)}\s*\([^;\n]*\)\s*\{{"
+    )
+    match = pattern.search(source)
+    if not match:
+        raise RuntimeError(f"could not find static function {name} in nvn_mtl.m")
+    start = match.start()
+    pos = source.find("{", match.start(), match.end())
+    depth = 0
+    state = "code"
+    escaped = False
+    while pos < len(source):
+        ch = source[pos]
+        nxt = source[pos + 1] if pos + 1 < len(source) else ""
+        if state == "line-comment":
+            if ch == "\n":
+                state = "code"
+        elif state == "block-comment":
+            if ch == "*" and nxt == "/":
+                state = "code"
+                pos += 1
+        elif state in ("string", "char"):
+            if escaped:
+                escaped = False
+            elif ch == "\\":
+                escaped = True
+            elif (state == "string" and ch == '"') or (state == "char" and ch == "'"):
+                state = "code"
+        elif ch == "/" and nxt == "/":
+            state = "line-comment"
+            pos += 1
+        elif ch == "/" and nxt == "*":
+            state = "block-comment"
+            pos += 1
+        elif ch == '"':
+            state = "string"
+        elif ch == "'":
+            state = "char"
+        elif ch == "{":
+            depth += 1
+        elif ch == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start : pos + 1]
+        pos += 1
+    raise RuntimeError(f"unterminated function {name}")
+
+
+def _production_source() -> str:
+    source = (ROOT / SOURCE_REL).read_text(encoding="utf-8")
+    for marker in ("SBW_WPAGES", "sbw_bound_len", "sbw_forward_wide"):
+        if marker not in source:
+            raise RuntimeError(f"production storage-write helper is missing: {marker}")
+    return source
