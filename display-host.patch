+    gw_commit(77);
+    expect(g_forwarded_n == 2, "gw_commit forwards both stored wide intervals");
+    expect(range_present(base, b_hi), "gw_commit forwards the merged interval bounds");
+    expect(range_present(separate, separate + wide), "gw_commit forwards the isolated pool bounds");
+    expect(g_forwarded[0].fence == 77 && g_forwarded[1].fence == 77,
+           "wide intervals carry the submitting fence");
+}
+
+static void test_unknown_overflow_and_capacity_fallback(void) {
+    pend_reset();
+    g_gw_all = 0;
+    uint32_t gen_before_unknown = g_sbw_gen;
