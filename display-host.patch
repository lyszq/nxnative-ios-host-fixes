+    assert(*(const uint64_t *)((const uint8_t *)regs + DM_OBS_FRAME_NZCV_OFFSET) == initial_nzcv);
+    assert(*(const uint64_t *)((const uint8_t *)regs + DM_OBS_FRAME_FPSR_OFFSET) == initial_fpsr);
+    assert(*(const uint64_t *)((const uint8_t *)regs + DM_OBS_FRAME_FPCR_OFFSET) == initial_fpcr);
+    for (unsigned i = 0; i < 18; i++) assert(regs[i] == 0x100u + i);
+    for (unsigned i = 19; i < 30; i++) assert(regs[i] == 0x100u + i);
+    assert(regs[30] == ret_addr);
+
+    float fovy = 0.0f, aspect = 0.0f;
+    assert(dm_obs_frame_read_s(regs, DM_OBS_FRAME_BYTES, 2, &fovy));
+    assert(dm_obs_frame_read_s(regs, DM_OBS_FRAME_BYTES, 3, &aspect));
+    assert(fovy == input_fovy && aspect == input_aspect);
+    assert(dm_obs_frame_write_s(regs, DM_OBS_FRAME_BYTES, 2, changed_fovy));
+    assert(dm_obs_frame_write_s(regs, DM_OBS_FRAME_BYTES, 3, changed_aspect));
