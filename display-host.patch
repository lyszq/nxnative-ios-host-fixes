+static void gw_put(uint64_t lo, uint64_t hi, uint64_t fence, uint64_t done) {
+    if (g_forwarded_n < (int)(sizeof g_forwarded / sizeof g_forwarded[0]))
+        g_forwarded[g_forwarded_n++] = (forwarded_range){lo, hi, fence, done};
+    else
+        g_failed++;
+}
