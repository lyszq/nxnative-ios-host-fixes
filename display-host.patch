+// Look-ahead timing is cumulative on the submit thread. `prefetch_item_ns` is
+// a sum of per-key elapsed intervals and can exceed `prefetch_wall_ns` because
+// those intervals overlap; it is not a CPU-time counter.
+typedef struct {
+    uint64_t predict_calls;
+    uint64_t predict_ns;
+    uint64_t prefetch_batches;
+    uint64_t prefetch_keys;
+    uint64_t prefetch_libs;
+    uint64_t prefetch_wall_ns;
+    uint64_t prefetch_item_ns;
