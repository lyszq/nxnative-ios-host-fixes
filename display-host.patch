+int main(void) {
+    test_bound_length();
+    test_small_pages_and_report_semantics();
+    test_known_zero_size_range_and_pool_isolation();
+    test_transitive_merge_and_forwarding();
+    test_unknown_overflow_and_capacity_fallback();
+    test_reset_and_generation_wrap();
