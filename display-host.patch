+        const int target_gpr = i >= 9 * sizeof(uint64_t) && i < 10 * sizeof(uint64_t);
+        const int target_lane = (i >= DM_OBS_FRAME_Q_OFFSET + 2 * DM_OBS_FRAME_Q_STRIDE &&
+                                 i < DM_OBS_FRAME_Q_OFFSET + 2 * DM_OBS_FRAME_Q_STRIDE + sizeof(float)) ||
+                                (i >= DM_OBS_FRAME_Q_OFFSET + 3 * DM_OBS_FRAME_Q_STRIDE &&
+                                 i < DM_OBS_FRAME_Q_OFFSET + 3 * DM_OBS_FRAME_Q_STRIDE + sizeof(float));
