diff --git a/dm/gfx/nvn/dm_shell_msl.h b/dm/gfx/nvn/dm_shell_msl.h
new file mode 100644
--- /dev/null
+++ b/dm/gfx/nvn/dm_shell_msl.h
@@ -0,0 +1,17 @@
+// Runtime options for source-form NVN guest shaders in the game-free shell.
+// Keep prep, ordinary loads and learned variants identical for Metal cache reuse.
+#ifndef DM_SHELL_MSL_H
+#define DM_SHELL_MSL_H
+#import <Metal/Metal.h>
+
+// Changing the policy requires a new epoch so old prep markers cannot skip it.
+#define DM_SHELL_NVN_MSL_EPOCH @"nvn-inv1"
+
+static inline MTLCompileOptions *dm_shell_nvn_compile_options(void) {
+    MTLCompileOptions *options = [MTLCompileOptions new];
+    // [[position, invariant]] only guarantees agreement when this is enabled.
+    // Leave math and optimization defaults unchanged in this isolated fix.
+    options.preserveInvariance = YES;
+    return options;
+}
+#endif
diff --git a/dm/tools/tests/test_shell_msl_policy.py b/dm/tools/tests/test_shell_msl_policy.py
new file mode 100644
--- /dev/null
+++ b/dm/tools/tests/test_shell_msl_policy.py
@@ -0,0 +1,62 @@
+"""Guard the shell's prep/runtime cache parity and source-map ownership.
+
+These source integration checks run on Windows; they are not an iOS Metal or
+gameplay test. A macOS shell build and an on-device A/B remain required.
+"""
+from pathlib import Path
+import re
+import unittest
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+class ShellMslPolicyTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.nvn = (ROOT / "dm/gfx/nvn/nvn_mtl.m").read_text(encoding="utf-8")
+        cls.prep = (ROOT / "dm/ios/Sources/dm_shader_prep.m").read_text(encoding="utf-8")
+        cls.policy = (ROOT / "dm/gfx/nvn/dm_shell_msl.h").read_text(encoding="utf-8")
+
+    def test_one_policy_for_base_and_learned_nvn_sources(self):
+        self.assertRegex(self.nvn, r"newLibraryWithSource:src options:dm_shell_nvn_compile_options\(\)")
+        self.assertRegex(self.nvn, r"newLibraryWithSource:t2 options:dm_shell_nvn_compile_options\(\)")
+        self.assertEqual(self.nvn.count("options:dm_shell_nvn_compile_options()"), 2)
+        self.assertIn('#include "dm_shell_msl.h"', self.nvn)
+
+    def test_prep_keeps_gl_vk_at_default_and_reuses_nvn_options(self):
+        self.assertIn('[p.pathExtension isEqual:@"metallib"] ? dm_shell_nvn_compile_options() : nil', self.prep)
+        self.assertIn("newLibraryWithSource:txt options:options", self.prep)
+        self.assertIn("newLibraryWithSource:t2 options:options", self.prep)
+        self.assertNotIn("newLibraryWithSource:txt options:nil", self.prep)
+        for backend in ("gl", "vk"):
+            source = (ROOT / f"dm/gfx/{backend}/hle_{backend}.m").read_text(encoding="utf-8")
+            self.assertIn("newLibraryWithSource:txt options:nil", source)
+
+    def test_only_invariance_changes_and_epoch_invalidates_old_marker(self):
+        self.assertIn("options.preserveInvariance = YES;", self.policy)
+        self.assertNotRegex(self.policy, r"\.(mathMode|fastMathEnabled|optimizationLevel)\s*=")
+        self.assertIn('#define DM_SHELL_NVN_MSL_EPOCH @"nvn-inv1"', self.policy)
+        self.assertIn("if (dir) tag = [tag stringByAppendingFormat:@\"-%@\", DM_SHELL_NVN_MSL_EPOCH]", self.prep)
+        self.assertIn("dm/gfx/nvn/dm_shell_msl.h", (ROOT / ".shell-overlay.txt").read_text(encoding="utf-8"))
+
+    def test_source_load_releases_mapping_before_every_return(self):
+        start = self.nvn.index('if (m != MAP_FAILED && len >= 4 && memcmp(m, "MTLB", 4) != 0)')
+        end = self.nvn.index("#endif", start)
+        branch = self.nvn[start:end]
+        self.assertEqual(branch.count("munmap(m, len);"), 1)
+        self.assertEqual(len(re.findall(r"\breturn\b", branch)), 1)
+        self.assertLess(branch.index("newLibraryWithSource:"), branch.index("munmap(m, len);"))
+        self.assertLess(branch.index("munmap(m, len);"), branch.index("return lib;"))
+        # Binary libraries retain their existing dispatch_data ownership.
+        self.assertRegex(self.nvn[end:end + 700], r"dispatch_data_create.*munmap\(m, len\)")
+
+    def test_windows_stamp_values_trimmed_in_reader_and_prep(self):
+        parse = self.nvn[self.nvn.index("*st_game = nil, *st_inputs = nil"):]
+        parse = parse[:parse.index("if (!st_inputs)")]
+        self.assertIn("stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet", parse)
+        marker = self.prep[self.prep.index("static NSString *marker("):self.prep.index("int dm_shader_prep_begin(")]
+        self.assertIn("stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet", marker)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/dm/tools/tests/run_shell_msl_native.py b/dm/tools/tests/run_shell_msl_native.py
new file mode 100644
--- /dev/null
+++ b/dm/tools/tests/run_shell_msl_native.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""Compile and execute the real source-load branch against a fake Metal device.
+
+Requires macOS/Xcode, but no GPU or game files. Exercises ARC, real mmap/munmap,
+UTF-8 decode failure, and Metal failure. Invariance is checked on every runner;
+math/optimization default parity is checked when those properties are available.
+This does not test GPU image output or real shader compilation.
+"""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def main():
+    if sys.platform != "darwin":
+        print("SKIP: native Foundation/Metal ownership test requires macOS/Xcode")
+        return 77
+    text = (ROOT / "dm/gfx/nvn/nvn_mtl.m").read_text(encoding="utf-8")
+    start = text.index('if (m != MAP_FAILED && len >= 4 && memcmp(m, "MTLB", 4) != 0)')
+    branch = text[start:text.index("#endif", start)]
+    harness = r'''
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include <sys/mman.h>
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "dm_shell_msl.h"
+static int unmaps, compile_calls;
+static BOOL fail_compile;
+@interface FakeDevice : NSObject
+- (id<MTLLibrary>)newLibraryWithSource:(NSString *)src options:(MTLCompileOptions *)options error:(NSError **)error;
+@end
+@implementation FakeDevice
+- (id<MTLLibrary>)newLibraryWithSource:(NSString *)src options:(MTLCompileOptions *)options error:(NSError **)error {
+    assert(src.length > 0);
+    assert(options.preserveInvariance);
+    compile_calls++;
+    if (fail_compile) {
+        if (error) *error = [NSError errorWithDomain:@"test" code:1 userInfo:nil];
+        return nil;
+    }
+    return (id<MTLLibrary>)[NSObject new];
+}
+@end
+static FakeDevice *g_dev;
+static int tracked_unmap(void *p, size_t n) {
+    unmaps++;
+    return munmap(p, n);
+}
+#define munmap tracked_unmap
+static id<MTLLibrary> load_source(void *m, size_t len, NSError **err) {
+    NSString *path = @"synthetic.metallib";
+    /* ACTUAL_SOURCE_BRANCH */
+    return nil;
+}
+#undef munmap
+static void run_case(BOOL invalid_utf8, BOOL compile_failure) {
+    size_t len = 4096;
+    void *m = mmap(NULL, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    assert(m != MAP_FAILED);
+    memset(m, invalid_utf8 ? 0xff : 'a', len);
+    fail_compile = compile_failure;
+    int before = unmaps, compiles_before = compile_calls;
+    NSError *error = nil;
+    id<MTLLibrary> result = load_source(m, len, &error);
+    assert(unmaps == before + 1);
+    assert(compile_calls == compiles_before + (invalid_utf8 ? 0 : 1));
+    assert((result != nil) == (!invalid_utf8 && !compile_failure));
+    if (!result) assert(error != nil);
+}
+int main(void) { @autoreleasepool {
+    MTLCompileOptions *policy = dm_shell_nvn_compile_options();
+    assert(policy.preserveInvariance);
+    if (@available(macOS 26.0, *)) {
+        MTLCompileOptions *baseline = [MTLCompileOptions new];
+        assert(policy.mathMode == baseline.mathMode);
+        assert(policy.optimizationLevel == baseline.optimizationLevel);
+    }
+    g_dev = [FakeDevice new];
+    for (int i = 0; i < 100; i++) { @autoreleasepool {
+        run_case(NO, NO); run_case(NO, YES); run_case(YES, NO);
+    } }
+    assert(unmaps == 300);
+    puts("PASS: actual source branch, 300 mappings released across success/decode/compile failure; invariance verified; math/optimization parity checked when available");
+} return 0; }
+'''.replace("/* ACTUAL_SOURCE_BRANCH */", branch)
+    with tempfile.TemporaryDirectory(prefix="shell-msl-native-") as td:
+        source, executable = Path(td) / "test.m", Path(td) / "test"
+        source.write_text(harness, encoding="utf-8", newline="\n")
+        subprocess.run(["xcrun", "clang", "-fobjc-arc", "-Wall", "-Wextra", "-Werror",
+                        "-mmacosx-version-min=15.0", "-I", str(ROOT / "dm/gfx/nvn"),
+                        "-framework", "Foundation", "-framework", "Metal",
+                        str(source), "-o", str(executable)], check=True)
+        subprocess.run([str(executable)], check=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
